digraph "Food web: Temperate rivers, lakes and wetlands" {
  rankdir=LR; node [shape=box, style="rounded,filled", fontname="sans-serif"];
  n0 [label="Osier", fillcolor="#cfe8c4"];
  n1 [label="White willow", fillcolor="#cfe8c4"];
  n2 [label="Black alder", fillcolor="#cfe8c4"];
  n3 [label="Meadow grasses", fillcolor="#cfe8c4"];
  n4 [label="Brown trout", fillcolor="#f0d0c0", style="rounded,filled,dashed"];
  n5 [label="grubs", fillcolor="#e6dccb"];
  n6 [label="earthworms", fillcolor="#e6dccb"];
  n7 [label="European perch", fillcolor="#f0d0c0", style="rounded,filled,dashed"];
  n8 [label="Brook trout", fillcolor="#f0d0c0", style="rounded,filled,dashed"];
  n9 [label="Yellow perch", fillcolor="#f0d0c0", style="rounded,filled,dashed"];
  n10 [label="Common frog", fillcolor="#f0d0c0", style="rounded,filled,dashed"];
  n11 [label="Wood frog", fillcolor="#f0d0c0", style="rounded,filled,dashed"];
  n5 -> n4;
  n6 -> n4;
  n7 -> n4;
  n5 -> n8;
  n6 -> n8;
  n9 -> n8;
  n5 -> n7;
  n10 -> n7;
  n5 -> n9;
  n11 -> n9;
  n5 -> n10;
  n6 -> n10;
  n5 -> n11;
  n6 -> n11;
}
