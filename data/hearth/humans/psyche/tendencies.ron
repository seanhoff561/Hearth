// Behaviour tendencies (V2.1 §5.1): how personality shows in what people choose. Each is a middle
// (for one of middling personality), a range, and how far it moves per standard deviation of the
// traits it leans on (`hearth:humans/genetics/traits`): value = middle + spread × Σ weight × z,
// within the range. Effects are kept modest — personality tilts choices; the situation, the
// culture and the relationships usually decide them — and the tests find trait–behaviour
// correlations of about 0.1–0.4, as studies of personality and behaviour do.
(
    schema: 1,
    entries: [
        (
            id: "risk_tolerance", name: "Risk tolerance", status: Implemented,
            middle: 0.5, range: (0.1, 0.9), spread: 0.12,
            from: [(of: "emotionality", weight: -0.5), (of: "novelty_seeking", weight: 0.35), (of: "inhibition", weight: -0.3), (of: "impulsivity", weight: 0.2)],
            realism_source: "risk taking against harm avoidance and sensation seeking, r about 0.2-0.4 (Nicholson et al. 2005); review",
            uncertain: true,
        ),
        (
            id: "curiosity", name: "Curiosity", status: Implemented,
            middle: 0.5, range: (0.1, 0.9), spread: 0.12,
            from: [(of: "openness", weight: 0.6), (of: "novelty_seeking", weight: 0.4)],
            realism_source: "openness and exploration; review",
            uncertain: true,
        ),
        (
            id: "patience", name: "Patience", status: Implemented,
            middle: 0.5, range: (0.1, 0.9), spread: 0.1,
            from: [(of: "conscientiousness", weight: 0.4), (of: "impulsivity", weight: -0.5)],
            realism_source: "self-control and delay discounting; review",
            uncertain: true,
        ),
        (
            id: "cooperativeness", name: "Cooperativeness", status: Implemented,
            middle: 0.6, range: (0.2, 0.95), spread: 0.1,
            from: [(of: "honesty_humility", weight: 0.5), (of: "agreeableness", weight: 0.4)],
            realism_source: "HEXACO honesty-humility and agreeableness predict cooperation in economic games (Hilbig et al. 2013)",
            uncertain: true,
        ),
        (
            id: "trust_strangers", name: "Trust in strangers", status: Implemented,
            middle: 0.4, range: (0.05, 0.9), spread: 0.12,
            from: [(of: "agreeableness", weight: 0.3), (of: "extraversion", weight: 0.3), (of: "emotionality", weight: -0.2), (of: "inhibition", weight: -0.3)],
            realism_source: "estimate; review",
            uncertain: true,
        ),
        (
            id: "conformity", name: "Conformity", status: Implemented,
            middle: 0.5, range: (0.1, 0.9), spread: 0.1,
            from: [(of: "openness", weight: -0.3), (of: "agreeableness", weight: 0.2), (of: "conscientiousness", weight: 0.2)],
            realism_source: "conformist transmission varies modestly with personality; review",
            uncertain: true,
        ),
        (
            id: "prestige_bias", name: "Copying the successful", status: Implemented,
            middle: 0.5, range: (0.1, 0.9), spread: 0.1,
            from: [(of: "extraversion", weight: 0.2), (of: "openness", weight: 0.2)],
            realism_source: "estimate; review",
            uncertain: true,
        ),
        (
            id: "reactivity", name: "Emotional reactivity", status: Implemented,
            middle: 0.5, range: (0.1, 0.9), spread: 0.12,
            from: [(of: "emotionality", weight: 0.4), (of: "stress_reactivity", weight: 0.5)],
            realism_source: "neuroticism and emotional reactivity; review",
            uncertain: true,
        ),
        (
            id: "aggression_threshold", name: "Threshold for aggression", status: Implemented,
            middle: 0.6, range: (0.15, 0.95), spread: 0.12,
            from: [(of: "aggression_threshold", weight: 0.6), (of: "agreeableness", weight: 0.3), (of: "honesty_humility", weight: 0.2)],
            realism_source: "HEXACO agreeableness and anger; physical aggression heritability (Burt 2009)",
            uncertain: true,
        ),
        (
            id: "forgiveness", name: "Forgiveness", status: Implemented,
            middle: 0.5, range: (0.1, 0.9), spread: 0.1,
            from: [(of: "agreeableness", weight: 0.6)],
            realism_source: "HEXACO agreeableness as forgiveness and patience (Lee and Ashton)",
            uncertain: true,
        ),
        (
            id: "diligence", name: "Diligence at work", status: Implemented,
            middle: 0.5, range: (0.1, 0.9), spread: 0.12,
            from: [(of: "conscientiousness", weight: 0.7)],
            realism_source: "conscientiousness and persistence at tasks",
            uncertain: true,
        ),
        (
            id: "sociability", name: "Sociability", status: Implemented,
            middle: 0.5, range: (0.1, 0.9), spread: 0.12,
            from: [(of: "extraversion", weight: 0.5), (of: "sociability", weight: 0.4)],
            realism_source: "extraversion and time spent with others, r about 0.2-0.4 (Mehl et al. 2006)",
            uncertain: true,
        ),
        (
            id: "dominance", name: "Dominance seeking", status: Implemented,
            middle: 0.4, range: (0.05, 0.9), spread: 0.1,
            from: [(of: "extraversion", weight: 0.3), (of: "honesty_humility", weight: -0.4), (of: "agreeableness", weight: -0.2)],
            realism_source: "estimate; review",
            uncertain: true,
        ),
    ],
)
