// Deep time (V2.1 §15.1; H8, D191–D194): how the history grid is laid over the planet, how the
// climate swings with the ice ages, what each biome gives foragers, what the cold and the sea ask
// of a people, and how its gene pools, knowledge and lineages change. The ice ages are stylised:
// cycles of 41,000 years before about 900,000 years ago and of 100,000 years after (Lisiecki and
// Raymo 2005's LR04 stack in outline), and for the last glacial cycle the sea-level record itself
// smoothed (Spratt and Lisiecki 2016; the Last Glacial Maximum 26–19 thousand years ago at about
// −125 m, Clark et al. 2009).
(
    schema: 1,
    entries: [
        (
            id: "deep_time", name: "Deep time", status: Implemented,
            // Cells of about 8 km, never fewer than 32 nor more than 128 along the circumference
            // (a Standard planet's cells are 2 km, an Earth-sized one's 300 km).
            cell_km: 8.0, cells: (32, 128),
            // Two and a half centuries a step in the far past, one from two hundred thousand
            // years ago, a generation over the last sixty thousand years.
            steps: [(2.5e6, 250.0), (200000.0, 100.0), (60000.0, 25.0)],
            cycles: [
                (from_ya: 3.0e6, period_years: 41000.0, low_m: -60.0),
                (from_ya: 900000.0, period_years: 100000.0, low_m: -120.0),
            ],
            curve: [
                (150000.0, -105.0), (140000.0, -120.0), (135000.0, -90.0), (129000.0, -10.0),
                (125000.0, 5.0), (118000.0, -15.0), (110000.0, -45.0), (104000.0, -35.0),
                (95000.0, -50.0), (85000.0, -25.0), (75000.0, -60.0), (66000.0, -85.0),
                (58000.0, -75.0), (48000.0, -70.0), (38000.0, -80.0), (30000.0, -90.0),
                (26000.0, -120.0), (21000.0, -125.0), (18000.0, -115.0), (15000.0, -100.0),
                (12500.0, -65.0), (10000.0, -45.0), (8000.0, -15.0), (6000.0, -3.0), (0.0, 0.0),
            ],
            // About 6 °C colder at the glacials' depth (Annan and Hargreaves 2013 put the LGM's
            // global cooling near 4 °C, more on land and at high latitudes), and drier.
            degrees_per_metre: 0.05,
            rain_per_degree: 0.04,
            // Foragers' densities by biome against open savanna–woodland's: richest where game,
            // plants and water meet (savanna, Mediterranean scrub, wetlands, oases), poorer in
            // closed rainforest and the boreal forest, poorest in deserts, on the tundra and high
            // up, nothing on ice (Binford 2001's hunter-gatherer densities by environment; Kelly
            // 2013, ch. 7).
            biomes: [
                ("savanna", 1.0), ("mediterranean_scrub", 1.0), ("steppe", 0.7), ("temperate_plains", 0.8),
                ("broadleaf_forest", 0.7), ("mixed_forest", 0.6), ("birch_forest", 0.5), ("temperate_rainforest", 0.6),
                ("tropical_rainforest", 0.35), ("montane_forest", 0.45), ("boreal_forest", 0.3), ("snowy_taiga", 0.2),
                ("tundra", 0.25), ("alpine_meadow", 0.2), ("krummholz", 0.1), ("alpine_rock", 0.02),
                ("hot_desert", 0.08), ("dune_sea", 0.01), ("mesa", 0.1), ("oasis", 1.2), ("salt_flat", 0.0),
                ("cold_desert", 0.1), ("volcanic", 0.2), ("wetland", 1.1), ("salt_marsh", 0.9), ("mangrove", 0.6),
                ("beach", 0.8), ("stony_shore", 0.6), ("river", 1.0), ("lake", 0.8), ("ice_sheet", 0.0), ("glacier", 0.0),
            ],
            // Shellfish, stranded fish and birds' eggs on any shore; fishing gear makes water far
            // richer (the densest foragers lived by fish; Binford 2001).
            coast: 0.4,
            river: 0.3,
            fishing: [
                (knowledge: "harpoon", gives: 1.4), (knowledge: "fishhook", gives: 1.5),
                (knowledge: "netting", gives: 1.5), (knowledge: "fish_weir", gives: 1.5),
            ],
            // Each technique that wins more food raises a people's density: digging sticks for
            // tubers, cooking (Wrangham 2009), butchery and marrow, spears, then the Upper
            // Paleolithic's snares, nets, bows, grinding stones, drying and storing. A Middle
            // Paleolithic people lives at about 0.06 a km² of open country, an Upper Paleolithic
            // one at about 0.12 (Binford 2001's warm-climate hunter-gatherers; Bocquet-Appel et
            // al. 2005 for the Upper Paleolithic of Europe).
            food: [
                (knowledge: "digging_stick", gives: 1.15), (knowledge: "carrying_bundle", gives: 1.05),
                (knowledge: "nut_cracking", gives: 1.05), (knowledge: "butchery", gives: 1.1),
                (knowledge: "marrow_extraction", gives: 1.05), (knowledge: "hand_axe", gives: 1.05),
                (knowledge: "cooking_roasting", gives: 1.15), (knowledge: "wooden_spear", gives: 1.1),
                (knowledge: "tracking", gives: 1.05), (knowledge: "stone_tipped_spear", gives: 1.1),
                (knowledge: "stone_boiling", gives: 1.05), (knowledge: "snares_and_traps", gives: 1.1),
                (knowledge: "bow_and_arrow", gives: 1.15), (knowledge: "atlatl", gives: 1.1),
                (knowledge: "netting", gives: 1.1), (knowledge: "grinding_seeds", gives: 1.1),
                (knowledge: "leaching_bitter_foods", gives: 1.05), (knowledge: "drying_and_smoking", gives: 1.1),
                (knowledge: "pemmican", gives: 1.05), (knowledge: "basketry", gives: 1.05),
            ],
            // A people's bands find their partners among a few hundred — Wobst 1974's least
            // mating network, 175 to 475 — spread at the densities above over some twenty-five
            // thousand square kilometres (Birdsell's dialect tribes of 500–1,500 span five to
            // twenty thousand); on a smaller planet the peoples live denser by as much, at most
            // thirty times, so that a Standard world holds such a network of each of its era's
            // peoples and a band is not left alone to die out — a liberty, as Wild Earth's
            // families are (D196, D198).
            people_km2: 25000.0,
            most_denser: 30.0,
            // Without fire or clothes a people winters where the coldest month is mild; fire kept
            // takes it to frost, hide wraps besides to a hard winter, sewn clothing to the steppes
            // of the far north (the Upper Paleolithic's Siberia).
            bare_coldest_c: 8.0,
            cold: [
                (needs: ["fire_keeping"], coldest_c: 0.0),
                (needs: ["fire_keeping", "hide_wrap_clothing"], coldest_c: -12.0),
                (needs: ["fire_keeping", "sewn_clothing"], coldest_c: -38.0),
            ],
            // Drifting on logs reaches a near island now and then (Flores, perhaps); rafts take a
            // people across the straits to Sahul, about 90 km at the glacial low stands.
            drift_reach_km: 12.0,
            craft: [(knowledge: "raft", gives: 120.0)],
            crossing_share: 0.05,
            // Skin lightening took tens of thousands of years where people met weak sun (Jablonski
            // and Chaplin 2010): most of the way in ten thousand. Drift is strong among a few
            // founders and undone over a hundred thousand years.
            selection_years: 10000.0,
            drift: 1.0,
            drift_return_years: 100000.0,
            // A percent or two of Neanderthal ancestry in Eurasians from tens of thousands of
            // years beside them (Green et al. 2010).
            archaic_mixing: 0.0004,
            // Knowledge (Henrich 2004; Powell, Shennan and Thomas 2009): big connected peoples
            // invent and keep, the few and the cut off lose the deep techniques first.
            invent: 0.01,
            invent_people: 1000.0,
            // Techniques travel between neighbouring peoples about half a kilometre a year (the
            // Upper Paleolithic's spread across Europe in some five thousand years).
            diffuse: 0.6,
            across_lineages: 0.3,
            keep_people: 150.0,
            keep_depth: 0.55,
            lose: 0.2,
            lineage_years: 500.0,
            branch_years_max: 20000.0,
            apart_people: 25.0,
            realism_source: "LR04 and Spratt and Lisiecki 2016 (sea level); Binford 2001, Kelly 2013 (forager densities); Henrich 2004, Powell et al. 2009 (demography and cumulative culture); Jablonski and Chaplin 2010 (pigmentation); review",
            uncertain: true,
        ),
    ],
)
