// What a culture is drawn from (V2.1 §9.1): each trait's options with how often the world's
// peoples of a way of life have them, and how fast cultures change. Our kind's foragers, and the
// archaic peoples of the Paleolithic eras (H8) — for whom nothing is known of residence, descent or
// greeting but what apes and the bones suggest, so their spans are wide and marked for review.
// Farmers and herders with H11.
(
    schema: 1,
    entries: [
        (
            id: "foragers", name: "A forager culture", status: Implemented, species: "homo_sapiens",
            // Most foragers live with either spouse's people as suits them; of the rest, more
            // with the husband's (Marlowe 2004; Alvarez 2004 on the old "patrilocal band").
            residence: [(Multilocal, 0.55), (Patrilocal, 0.3), (Matrilocal, 0.12), (Neolocal, 0.03)],
            // Mostly bilateral; unilineal descent rarer among mobile foragers (Ember and Ember).
            descent: [(Bilateral, 0.7), (Patrilineal, 0.2), (Matrilineal, 0.1)],
            // Polygyny allowed in most forager societies, practised by few men (Marlowe 2005).
            polygyny: (0.0, 0.15),
            // Foragers' egalitarian ethos, the would-be dominant checked (Boehm 1999); kin first
            // but sharing widely; quarrels mostly eased; norms neither loose nor tight.
            values: (
                hierarchy: (0.05, 0.4),
                wide: (0.3, 0.8),
                honour: (0.1, 0.6),
                tight: (0.2, 0.7),
            ),
            // The share of each work its women do: Murdock and Provost's (1973) cross-cultural
            // ratings about each, a culture drawn anywhere within its span.
            labour: [
                ("hunting", (0.0, 0.2)),
                ("butchery", (0.0, 0.25)),
                ("throwing", (0.0, 0.2)),
                ("knapping", (0.0, 0.3)),
                ("boneworking", (0.0, 0.3)),
                ("woodworking", (0.0, 0.3)),
                ("firemaking", (0.2, 0.6)),
                ("hideworking", (0.4, 0.9)),
                ("fibrework", (0.5, 0.95)),
                ("sewing", (0.6, 0.95)),
                ("cooking", (0.7, 0.98)),
                ("gathering", (0.6, 0.95)),
                ("childcare", (0.75, 0.95)),
            ],
            // Foragers mostly bury their dead, some with what they carried; some lay them out
            // away from camp; burning is rare.
            burial: [(Buried, 0.45), (BuriedWithGoods, 0.25), (LaidOut, 0.25), (Burned, 0.05)],
            greeting: [(Embrace, 0.3), (Hands, 0.3), (Call, 0.25), (Gift, 0.15)],
            // A few foragers forbid fish (the Tasmanians scaled fish, Jones 1978; the Hadza,
            // Woodburn 1968).
            taboos: (0, 1),
            taboo_foods: ["raw_fish", "shellfish"],
            ways_spread: 0.3,
            drift: (value_step: 0.01, custom: 0.004, motif: 0.02, contact: 0.05, borrow: 0.05),
        ),
        (
            id: "erectus_bands", name: "A band of Homo erectus", status: Implemented, species: "homo_erectus",
            // Females leaving their birth group as among chimpanzees and, it seems, early hominins
            // (Copeland et al. 2011); bonds and kin reckoned no further than those known.
            residence: [(Patrilocal, 0.6), (Multilocal, 0.4)],
            descent: [(Bilateral, 1.0)],
            polygyny: (0.0, 0.2),
            values: (
                hierarchy: (0.1, 0.5),
                wide: (0.1, 0.5),
                honour: (0.1, 0.6),
                tight: (0.2, 0.6),
            ),
            // Whatever the sexes did, the bones tell little: every work shared within wide spans.
            labour: [
                ("hunting", (0.0, 0.4)),
                ("butchery", (0.1, 0.5)),
                ("throwing", (0.0, 0.4)),
                ("knapping", (0.1, 0.6)),
                ("woodworking", (0.1, 0.6)),
                ("firemaking", (0.2, 0.7)),
                ("cooking", (0.4, 0.9)),
                ("gathering", (0.5, 0.9)),
                ("childcare", (0.7, 0.95)),
            ],
            // No burials before the Middle Paleolithic: the dead are left where they lie.
            burial: [(LaidOut, 1.0)],
            greeting: [(Call, 0.6), (Embrace, 0.4)],
            taboos: (0, 0),
            taboo_foods: [],
            ways_spread: 0.3,
            drift: (value_step: 0.01, custom: 0.002, motif: 0.005, contact: 0.05, borrow: 0.03),
            realism_source: "inferred from apes and the archaeological record (no burials, no ornament); review",
            uncertain: true,
        ),
        (
            id: "neanderthal_bands", name: "A Neanderthal band", status: Implemented, species: "homo_neanderthalensis",
            // The men of El Sidrón kin, the women not: brides came from elsewhere (Lalueza-Fox et
            // al. 2011).
            residence: [(Patrilocal, 0.7), (Multilocal, 0.3)],
            descent: [(Bilateral, 0.8), (Patrilineal, 0.2)],
            polygyny: (0.0, 0.15),
            values: (
                hierarchy: (0.05, 0.4),
                wide: (0.1, 0.5),
                honour: (0.1, 0.6),
                tight: (0.2, 0.7),
            ),
            labour: [
                ("hunting", (0.0, 0.4)),
                ("butchery", (0.1, 0.5)),
                ("throwing", (0.0, 0.3)),
                ("knapping", (0.1, 0.5)),
                ("woodworking", (0.1, 0.5)),
                ("firemaking", (0.2, 0.7)),
                ("hideworking", (0.4, 0.9)),
                ("fibrework", (0.4, 0.9)),
                ("cooking", (0.5, 0.95)),
                ("gathering", (0.5, 0.9)),
                ("childcare", (0.7, 0.95)),
            ],
            // Burials at La Chapelle-aux-Saints, Shanidar and La Ferrassie, a few with something
            // laid by them; most dead left as they lay.
            burial: [(LaidOut, 0.6), (Buried, 0.35), (BuriedWithGoods, 0.05)],
            greeting: [(Call, 0.4), (Embrace, 0.4), (Hands, 0.2)],
            taboos: (0, 0),
            taboo_foods: [],
            ways_spread: 0.3,
            drift: (value_step: 0.01, custom: 0.003, motif: 0.01, contact: 0.05, borrow: 0.04),
            realism_source: "Lalueza-Fox et al. 2011 (patrilocality); Rendu et al. 2014 and Pomeroy et al. 2020 (burials); review",
            uncertain: true,
        ),
    ],
)
