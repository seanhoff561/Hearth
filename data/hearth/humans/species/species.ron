// Species of person (V2.1 §2): the ranges every person's components take. *Australopithecus* runs
// now (H0); *Homo erectus*, Neanderthals and *Homo sapiens* are data until their eras (H3's
// families, H8). Ages are years; sizes are grown adults'. Values are central estimates from the
// fossil and comparative record, many disputed: each is marked for review.
(
    schema: 1,
    entries: [
        (
            id: "australopithecus", name: "Australopithecus", scientific: "Australopithecus sp.",
            status: Implemented,
            // Lucy's kind (A. afarensis): small, strongly dimorphic, long-armed, still a climber.
            body: (
                height_m: (female: (1.0, 1.15), male: (1.3, 1.5)),
                mass_kg: (female: (27, 31), male: (40, 46)),
                plan: Australopith, coat: Hair, climbs: true,
            ),
            // No language, shallow plans, little active teaching (as chimpanzees), no fire; the
            // stone tools of the earliest knapping at most.
            cognition: (
                language: Calls, planning_depth: 1, symbolic: false, teaching: Minimal,
                fire: None, era_ceiling: 0,
            ),
            // Gestation between a chimpanzee's and ours; weaned at about four; grown and a mother
            // at eleven or twelve; few lived past fifty.
            life: (
                gestation_days: 240, weaning_years: 4.0, maturity_years: 11.5,
                adult_death_years: (35, 50), birth_interval_years: 4.5,
                // On its mother to four, then ranging with the others; growing to full size from
                // nine (a chimpanzee's stages, as Lucy's kind's teeth suggest).
                stages: [(Infant, 0.0), (Juvenile, 4.0), (Adolescent, 9.0), (Adult, 11.5), (Elder, 30.0)],
                // A chimpanzee's growth: a newborn a third of grown height, a twentieth of its mass.
                growth: [(0.0, 0.35, 0.06), (1.0, 0.48, 0.14), (2.0, 0.56, 0.2), (4.0, 0.67, 0.32), (6.0, 0.77, 0.45), (8.0, 0.87, 0.62), (10.0, 0.95, 0.84), (11.5, 1.0, 1.0)],
            ),
            social: (group_size: (5, 25), disperses: Females),
            habitat: ["savanna_woodland", "tropical_freshwater"],
            population: "australopithecus",
            knowledge: ["stone_as_hammer", "anvil_use", "nut_cracking", "sharp_flake", "flake_cutting", "digging_stick", "termite_probe", "throwing_stones"],
            behaviors: [Forage, DigTubers, CrackNuts, FishTermites, Scavenge, KnapFlakes, TreeNest, AlarmCall, MobThreat, FleeToTrees, Habituate],
            first_appearance_ya: 4200000, extinction_ya: 2000000,
            realism_source: "McHenry 1992 (body mass); Lucy and the Dikika child; chimpanzee life history for what bones do not tell (Lomekwi 3, Oldowan); strontium isotopes for female dispersal (Copeland et al. 2011); review",
            uncertain: true,
        ),
        (
            id: "homo_erectus", name: "Homo erectus", scientific: "Homo erectus", status: Planned,
            // Tall and long-legged, a walker and runner of open country; bare-skinned (inferred).
            body: (
                height_m: (female: (1.45, 1.6), male: (1.6, 1.8)),
                mass_kg: (female: (42, 55), male: (55, 68)),
                plan: Erectus, coat: Bare, climbs: false,
            ),
            // A simple, gesture-rich proto-language; the hand axe's making taught; fire kept and
            // carried; Lower Paleolithic knowledge.
            cognition: (
                language: ProtoLanguage, planning_depth: 3, symbolic: false, teaching: Real,
                fire: Keeping, era_ceiling: 0,
            ),
            life: (
                gestation_days: 255, weaning_years: 3.0, maturity_years: 15,
                adult_death_years: (35, 55), birth_interval_years: 3.5,
            ),
            social: (group_size: (15, 40), disperses: Females),
            habitat: ["savanna_woodland", "tropical_freshwater", "tropical_rainforest", "temperate_grassland", "temperate_broadleaf_forest", "coast"],
            knowledge: ["stone_as_hammer", "anvil_use", "sharp_flake", "flake_cutting", "chopper", "hand_axe", "digging_stick", "throwing_stones", "carrying_bundle", "tracking", "butchery", "marrow_extraction", "fire_keeping", "cooking_roasting"],
            behaviors: [Forage, DigTubers, Scavenge, KnapFlakes, AlarmCall, MobThreat, Habituate],
            first_appearance_ya: 1900000, extinction_ya: 110000,
            realism_source: "Ruff et al. (body size); the Nariokotome boy's development; Acheulean teaching (Morgan et al. 2015); fire at Wonderwerk Cave; review",
            uncertain: true,
        ),
        (
            id: "homo_neanderthalensis", name: "Neanderthal", scientific: "Homo neanderthalensis",
            status: Planned,
            // Short, broad and heavy: a cold climate's body.
            body: (
                height_m: (female: (1.48, 1.6), male: (1.6, 1.72)),
                mass_kg: (female: (55, 72), male: (65, 85)),
                plan: Neanderthal, coat: Bare, climbs: false,
            ),
            // Speech (the hyoid, the ear), fire made at will, hafting with birch tar, care for the
            // injured, burials, pigments and ornaments in a few places.
            cognition: (
                language: Full, planning_depth: 4, symbolic: true, teaching: Real,
                fire: Making, era_ceiling: 1,
            ),
            life: (
                gestation_days: 270, weaning_years: 2.5, maturity_years: 15,
                adult_death_years: (35, 55), birth_interval_years: 3.0,
            ),
            social: (group_size: (10, 30), disperses: Females),
            habitat: ["temperate_broadleaf_forest", "temperate_grassland", "mediterranean_scrub", "boreal_forest_ecosystem", "montane_forest_ecosystem", "temperate_freshwater", "coast"],
            knowledge: ["stone_as_hammer", "anvil_use", "sharp_flake", "flake_cutting", "chopper", "hand_axe", "digging_stick", "throwing_stones", "carrying_bundle", "tracking", "butchery", "marrow_extraction", "fire_keeping", "cooking_roasting", "wooden_spear", "fire_hardening", "windbreak_shelter", "prepared_core", "scraper", "hide_scraping", "hide_wrap_clothing", "birch_tar", "hafting_binding", "stone_tipped_spear", "fire_by_friction_hand_drill", "cordage_basic", "ochre_pigment"],
            behaviors: [Forage, DigTubers, Scavenge, KnapFlakes, AlarmCall, MobThreat, Habituate],
            first_appearance_ya: 400000, extinction_ya: 40000,
            realism_source: "body size and proportions (Ruff, Trinkaus); weaning at about 2.5 years from barium in teeth (Smith et al. 2018); fire-making wear on bifaces (Sorensen et al. 2018); patrilocality at El Sidrón; review",
            uncertain: true,
        ),
        (
            id: "homo_sapiens", name: "Human", scientific: "Homo sapiens", status: Implemented,
            // Foragers' sizes; the species' range is wide and set by nutrition as much as genes.
            body: (
                height_m: (female: (1.5, 1.68), male: (1.6, 1.8)),
                mass_kg: (female: (45, 65), male: (55, 75)),
                plan: Modern, coat: Bare, climbs: false,
            ),
            cognition: (
                language: Full, planning_depth: 6, symbolic: true, teaching: Real,
                fire: Making, era_ceiling: 8,
            ),
            // Foragers: weaned at two to three, a first birth near twenty, births three to four
            // years apart; those who live through childhood mostly die in their late sixties and
            // seventies.
            life: (
                gestation_days: 268, weaning_years: 2.5, maturity_years: 18,
                adult_death_years: (60, 80), birth_interval_years: 3.25,
                stages: [(Infant, 0.0), (Child, 2.5), (Juvenile, 7.0), (Adolescent, 12.0), (Adult, 18.0), (Elder, 55.0)],
                // Height and mass for age as shares of grown (foragers' growth: quick in infancy,
                // slow through childhood, a spurt in adolescence, grown at eighteen).
                growth: [(0.0, 0.29, 0.055), (0.5, 0.39, 0.12), (1.0, 0.44, 0.15), (2.0, 0.51, 0.2), (3.0, 0.56, 0.23), (5.0, 0.64, 0.3), (7.0, 0.7, 0.36), (10.0, 0.79, 0.47), (12.0, 0.85, 0.58), (14.0, 0.92, 0.74), (16.0, 0.97, 0.9), (18.0, 1.0, 1.0)],
            ),
            social: (group_size: (25, 50), disperses: Both),
            habitat: ["savanna_woodland", "tropical_freshwater", "tropical_rainforest", "temperate_grassland", "temperate_broadleaf_forest", "mediterranean_scrub", "boreal_forest_ecosystem", "tundra_ecosystem", "montane_forest_ecosystem", "alpine_ecosystem", "temperate_freshwater", "hot_desert", "cold_desert", "mangrove_forest", "coast"],
            // Wild Earth's families know what living in their country takes and no more (D164):
            // where it is warm the stone hammer, sharp flakes and cutting with them, the digging
            // stick, throwing stones, carrying bundles and tracking; where it is cold besides,
            // keeping and making fire, hide wraps (and the scraping and butchery they rest on)
            // and a windbreak. The eras' peoples know their eras' (H8).
            knowledge: ["stone_as_hammer", "sharp_flake", "flake_cutting", "digging_stick", "throwing_stones", "carrying_bundle", "tracking"],
            cold_knowledge: ["fire_keeping", "fire_by_friction_hand_drill", "windbreak_shelter", "butchery", "hand_axe", "prepared_core", "scraper", "hide_scraping", "hide_wrap_clothing"],
            population: "homo_sapiens",
            worldwide: true,
            behaviors: [Forage, DigTubers, CrackNuts, Scavenge, KnapFlakes, Habituate],
            first_appearance_ya: 300000,
            realism_source: "forager life history (Gurven and Kaplan 2007; Marlowe 2004 on bilocal residence); review",
            uncertain: true,
        ),
    ],
)
