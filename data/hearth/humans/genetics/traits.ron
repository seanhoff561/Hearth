// Heritable traits and their architectures (V2.1 §4.3). A trait takes `polygenic` loci of small
// effect, laid out on the chromosomes under the settings' seed (one architecture for every world),
// and any named loci of larger effect (`loci.ron`) by weight. `heritability` is the share of its
// variation genes account for in the species pool (narrow sense); the environmental spread is set
// at load to hit it. `shows` is how its value is read: a z-score, a factor about 1 (`Factor`), or the
// species profile's stature. Physical traits may shift with a place's sunlight (`sunlight`: the
// raising alleles' frequency where it is weakest and strongest) where selection explains it;
// behavioural traits may not (ground rule 1; the lint fails any that tries).
(
    schema: 1,
    entries: [
        // ---- Pigmentation ----
        (
            id: "skin_pigment", name: "Skin pigmentation", status: Implemented, group: Pigmentation, polygenic: 30,
            heritability: 0.8, shows: Z, sunlight: (0.2, 0.85),
            major: [(locus: "skin_a", weight: 1.0), (locus: "skin_b", weight: 0.8), (locus: "skin_c", weight: 0.6)],
            realism_source: "twin studies of skin reflectance; SLC24A5-, SLC45A2- and OCA2-like loci of larger effect; review",
            uncertain: true,
        ),
        (
            id: "hair_darkness", name: "Hair darkness (eumelanin)", status: Implemented, group: Pigmentation, polygenic: 20,
            heritability: 0.85, shows: Z, sunlight: (0.35, 0.9),
            major: [(locus: "skin_b", weight: 0.6), (locus: "skin_c", weight: 0.8)],
            realism_source: "hair colour heritability about 0.9 in twin studies; shared pigmentation loci",
            uncertain: true,
        ),
        (
            // The modifiers only: the major locus and the green one are read from the genotype
            // (`looks.rs`): blue eyes in a homozygote, green or hazel in a carrier of the modifier.
            id: "eye_lightness", name: "Eye lightness (modifiers)", status: Implemented, group: Pigmentation, polygenic: 6,
            heritability: 0.9, shows: Z, sunlight: (0.6, 0.2),
            realism_source: "eye colour heritability about 0.98, most of it a HERC2/OCA2-like major locus",
        ),
        // ---- Hair form and the face ----
        (
            // Tightly curled hair shades the scalp from the sun (Lasisi et al. 2023): until the
            // peoples of deep time (H8) carry their own pools, curl follows sunlight.
            id: "hair_curl", name: "Hair curl", status: Implemented, group: HairForm, polygenic: 15,
            heritability: 0.85, shows: Z, sunlight: (0.3, 0.8),
            realism_source: "hair curliness heritability 0.85–0.95 (Medland et al. 2009); TCHH-like loci; curl and solar heat (Lasisi et al. 2023)",
            uncertain: true,
        ),
        (
            id: "beard_density", name: "Facial hair density", status: Implemented, group: HairForm, polygenic: 10,
            heritability: 0.6, shows: Z,
            realism_source: "estimate; facial hair density is strongly familial; review",
            uncertain: true,
        ),
        // ---- Body ----
        (
            id: "stature", name: "Stature", status: Implemented, group: Body, polygenic: 60,
            heritability: 0.8, shows: Stature,
            realism_source: "adult height heritability about 0.8 in well-fed populations (Silventoinen et al. 2003); childhood nutrition and illness lower it (H3)",
        ),
        (
            id: "build", name: "Build", status: Implemented, group: Body, polygenic: 25,
            heritability: 0.6, shows: Z,
            realism_source: "body mass index heritability 0.5–0.8 (Elks et al. 2012)",
            uncertain: true,
        ),
        // ---- Health ----
        (
            id: "infection_resistance", name: "Resistance to infection", status: Implemented, group: Health, polygenic: 15,
            heritability: 0.3, shows: Factor(0.15),
            realism_source: "estimate: general resistance is modestly heritable beside the immune region's diversity (`settings.ron`); review",
            uncertain: true,
        ),
        (
            id: "longevity", name: "Longevity", status: Implemented, group: Health, polygenic: 10,
            heritability: 0.12, shows: Factor(0.08),
            realism_source: "lifespan heritability well under 0.1–0.2 once assortative mating is allowed for (Ruby et al. 2018)",
            uncertain: true,
        ),
        (
            id: "fertility", name: "Fertility", status: Implemented, group: Health, polygenic: 10,
            heritability: 0.2, shows: Factor(0.12),
            realism_source: "heritability of fertility about 0.2 in pre-modern populations (Pettay et al. 2005)",
            uncertain: true,
        ),
        // ---- Temperament: the HEXACO factors (D172) ----
        (id: "honesty_humility", name: "Honesty–humility", status: Implemented, group: Temperament, polygenic: 15, heritability: 0.4, shows: Z,
         realism_source: "HEXACO twin studies, heritabilities about 0.4 (Lee and Ashton)", uncertain: true),
        (id: "emotionality", name: "Emotionality", status: Implemented, group: Temperament, polygenic: 15, heritability: 0.4, shows: Z,
         realism_source: "HEXACO twin studies", uncertain: true),
        (id: "extraversion", name: "Extraversion", status: Implemented, group: Temperament, polygenic: 15, heritability: 0.4, shows: Z,
         realism_source: "HEXACO and Big Five twin studies, about 0.4–0.5", uncertain: true),
        (id: "agreeableness", name: "Agreeableness", status: Implemented, group: Temperament, polygenic: 15, heritability: 0.4, shows: Z,
         realism_source: "HEXACO twin studies", uncertain: true),
        (id: "conscientiousness", name: "Conscientiousness", status: Implemented, group: Temperament, polygenic: 15, heritability: 0.4, shows: Z,
         realism_source: "HEXACO and Big Five twin studies", uncertain: true),
        (id: "openness", name: "Openness to experience", status: Implemented, group: Temperament, polygenic: 15, heritability: 0.45, shows: Z,
         realism_source: "HEXACO and Big Five twin studies, about 0.4–0.6", uncertain: true),
        // ---- Temperament: narrower dimensions the mind uses ----
        (id: "inhibition", name: "Behavioural inhibition", status: Implemented, group: Temperament, polygenic: 10, heritability: 0.45, shows: Z,
         realism_source: "shyness in childhood, heritability 0.4–0.6 (Kagan; twin studies)", uncertain: true),
        (id: "stress_reactivity", name: "Stress reactivity", status: Implemented, group: Temperament, polygenic: 10, heritability: 0.4, shows: Z,
         realism_source: "neuroticism-like reactivity, about 0.4", uncertain: true),
        (id: "impulsivity", name: "Impulsivity", status: Implemented, group: Temperament, polygenic: 10, heritability: 0.45, shows: Z,
         realism_source: "impulsivity heritability about 0.5 (Bezdjian et al. 2011)", uncertain: true),
        (id: "novelty_seeking", name: "Novelty seeking", status: Implemented, group: Temperament, polygenic: 10, heritability: 0.4, shows: Z,
         realism_source: "about 0.4", uncertain: true),
        (id: "sociability", name: "Sociability", status: Implemented, group: Temperament, polygenic: 10, heritability: 0.4, shows: Z,
         realism_source: "about 0.4", uncertain: true),
        (id: "aggression_threshold", name: "Threshold for aggression", status: Implemented, group: Temperament, polygenic: 10, heritability: 0.45, shows: Z,
         realism_source: "physical aggression about 0.5 (Burt 2009)", uncertain: true),
        (id: "empathy", name: "Empathy", status: Implemented, group: Temperament, polygenic: 10, heritability: 0.3, shows: Z,
         realism_source: "empathy about 0.3 (Knafo et al. 2008)", uncertain: true),
        // ---- Aptitudes: small differences in how fast one learns (practice and teaching dominate) ----
        (id: "motor_aptitude", name: "Motor learning", status: Implemented, group: Aptitude, polygenic: 10, heritability: 0.5, shows: Factor(0.1),
         realism_source: "estimate; review", uncertain: true),
        (id: "spatial_aptitude", name: "Spatial learning", status: Implemented, group: Aptitude, polygenic: 10, heritability: 0.5, shows: Factor(0.1),
         realism_source: "cognitive abilities' heritability about 0.5 in adults (Plomin and Deary 2015)", uncertain: true),
        (id: "social_aptitude", name: "Social learning", status: Implemented, group: Aptitude, polygenic: 10, heritability: 0.4, shows: Factor(0.1),
         realism_source: "estimate; review", uncertain: true),
        (id: "verbal_aptitude", name: "Verbal learning", status: Implemented, group: Aptitude, polygenic: 10, heritability: 0.5, shows: Factor(0.1),
         realism_source: "cognitive abilities' heritability about 0.5 in adults", uncertain: true),
        (id: "memory_aptitude", name: "Memory", status: Implemented, group: Aptitude, polygenic: 10, heritability: 0.4, shows: Factor(0.1),
         realism_source: "estimate; review", uncertain: true),
        (id: "stamina", name: "Stamina", status: Implemented, group: Aptitude, polygenic: 10, heritability: 0.5, shows: Factor(0.1),
         realism_source: "heritability of endurance and its trainability about 0.5 (Bouchard et al.)", uncertain: true),
    ],
)
