// Named loci of larger effect (V2.1 §4.1), each at a place on a chromosome. Alleles have an
// effect in the units of the polygenic loci (whose effects are about 1 each) and a frequency in the
// species pool; `sunlight` gives an allele's frequency where the sun is weakest and strongest, for
// physical loci only (pools differ in physical traits where selection explains it, never in
// behavioural ones: ground rule 1). `dominance` names the allele whose effect shows only in a
// homozygote (`Recessive`) or in any carrier (`Dominant`); otherwise effects add.
(
    schema: 1,
    entries: [
        // ---- Skin: three loci of large effect (SLC24A5-, SLC45A2- and OCA2-like) ----
        (
            id: "skin_a", name: "Skin locus A", status: Implemented, chromosome: "chr15", position_cm: 46, group: Pigmentation,
            alleles: [(name: "dark", effect: 0.0, frequency: 0.6), (name: "light", effect: -3.0, frequency: 0.4)],
            sunlight: Some((allele: "light", weak: 0.98, strong: 0.02)),
            realism_source: "after SLC24A5: the light allele nearly fixed where the sun is weak, nearly absent where it is strong",
            uncertain: true,
        ),
        (
            id: "skin_b", name: "Skin locus B", status: Implemented, chromosome: "chr5", position_cm: 41, group: Pigmentation,
            alleles: [(name: "dark", effect: 0.0, frequency: 0.7), (name: "light", effect: -2.4, frequency: 0.3)],
            sunlight: Some((allele: "light", weak: 0.95, strong: 0.03)),
            realism_source: "after SLC45A2",
            uncertain: true,
        ),
        (
            id: "skin_c", name: "Skin locus C", status: Implemented, chromosome: "chr15", position_cm: 30, group: Pigmentation,
            alleles: [(name: "dark", effect: 0.0, frequency: 0.8), (name: "light", effect: -1.6, frequency: 0.2)],
            sunlight: Some((allele: "light", weak: 0.6, strong: 0.05)),
            realism_source: "after OCA2's skin and hair effects",
            uncertain: true,
        ),
        // ---- Eyes ----
        (
            id: "eye_major", name: "Eye colour locus", status: Implemented, chromosome: "chr15", position_cm: 31, group: Pigmentation,
            alleles: [(name: "brown", effect: 0.0, frequency: 0.9), (name: "blue", effect: 4.0, frequency: 0.1)],
            dominance: Recessive("blue"),
            sunlight: Some((allele: "blue", weak: 0.85, strong: 0.0)),
            realism_source: "after HERC2/OCA2: blue eyes nearly recessive, the allele common only where the sun is weak; two brown-eyed carriers have a blue-eyed child one time in four",
        ),
        (
            id: "eye_green", name: "Eye colour modifier", status: Implemented, chromosome: "chr19", position_cm: 60, group: Pigmentation,
            alleles: [(name: "plain", effect: 0.0, frequency: 0.95), (name: "green", effect: 1.5, frequency: 0.05)],
            sunlight: Some((allele: "green", weak: 0.3, strong: 0.01)),
            realism_source: "estimate: modifiers giving green and hazel eyes; review",
            uncertain: true,
        ),
        // ---- Hair: red ----
        (
            id: "red_hair", name: "Red hair locus", status: Implemented, chromosome: "chr16", position_cm: 128, group: Pigmentation,
            alleles: [(name: "plain", effect: 0.0, frequency: 0.99), (name: "red", effect: 1.0, frequency: 0.01)],
            dominance: Recessive("red"),
            sunlight: Some((allele: "red", weak: 0.15, strong: 0.0)),
            realism_source: "after MC1R: red hair in homozygotes, the variants commonest under weak, cloudy skies",
            uncertain: true,
        ),
        // ---- Metabolism (the pools change them as their peoples live: H8, H11) ----
        (
            id: "lactase", name: "Lactase persistence", status: Implemented, chromosome: "chr2", position_cm: 141, group: Metabolism,
            alleles: [(name: "weaning", effect: 0.0, frequency: 0.99), (name: "persistent", effect: 1.0, frequency: 0.01)],
            dominance: Dominant("persistent"),
            realism_source: "after LCT: digesting milk in adulthood spread with dairying in the last ten thousand years",
        ),
        (
            id: "altitude", name: "High-altitude adaptation", status: Implemented, chromosome: "chr2", position_cm: 71, group: Metabolism,
            alleles: [(name: "lowland", effect: 0.0, frequency: 0.98), (name: "highland", effect: 1.0, frequency: 0.02)],
            realism_source: "after EPAS1: common only in long-settled highlands",
            uncertain: true,
        ),
        (
            id: "cold", name: "Cold adaptation", status: Implemented, chromosome: "chr11", position_cm: 70, group: Metabolism,
            alleles: [(name: "temperate", effect: 0.0, frequency: 0.9), (name: "arctic", effect: 1.0, frequency: 0.1)],
            realism_source: "after CPT1A's arctic variant and the cold-climate fat metabolism variants: common in the far north",
            uncertain: true,
        ),
        (
            id: "starch", name: "Salivary amylase copies", status: Implemented, chromosome: "chr1", position_cm: 112, group: Metabolism,
            alleles: [(name: "few", effect: 0.0, frequency: 0.6), (name: "many", effect: 1.0, frequency: 0.4)],
            realism_source: "after AMY1 copy number: more copies where diets are rich in starch (Perry et al. 2007)",
            uncertain: true,
        ),
    ],
)
