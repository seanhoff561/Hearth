// Gene pools (V2.1 §4.5): a species' frequencies for its physical loci, where they differ from the
// loci's own. Behavioural loci (temperament, aptitude) have one set of frequencies in every pool:
// a pool cannot name them (ground rule 1; the lint fails any that tries). Until H8's deep time
// makes populations, a place's pool is its species' with the pigmentation set by the place's
// sunlight where `sunlight` is on.
(
    schema: 1,
    entries: [
        (
            id: "homo_sapiens", name: "Human", status: Implemented, species: "homo_sapiens", sunlight: true,
            realism_source: "pigmentation by sunlight (Jablonski and Chaplin 2000); review",
            uncertain: true,
        ),
        (
            id: "australopithecus", name: "Australopithecus", status: Implemented, species: "australopithecus", sunlight: false,
            // Dark skin under dark hair, dark eyes: the tropics' apes'.
            loci: [
                (locus: "skin_a", frequencies: [1.0, 0.0]),
                (locus: "skin_b", frequencies: [1.0, 0.0]),
                (locus: "skin_c", frequencies: [1.0, 0.0]),
                (locus: "eye_major", frequencies: [1.0, 0.0]),
                (locus: "eye_green", frequencies: [1.0, 0.0]),
                (locus: "red_hair", frequencies: [1.0, 0.0]),
            ],
            traits: [(of: "skin_pigment", raising: 0.6), (of: "hair_darkness", raising: 0.65)],
            realism_source: "inferred from living African apes; review",
            uncertain: true,
        ),
        (
            id: "homo_erectus", name: "Homo erectus", status: Implemented, species: "homo_erectus", sunlight: true,
            // Bare-skinned in the tropics' sun, dark there (Jablonski 2004 on the loss of body hair
            // and the dark skin it called for); in deep time each people's pool comes toward its
            // own sunlight as ours do (H8).
            realism_source: "Jablonski 2004; review",
            uncertain: true,
        ),
        (
            id: "homo_neanderthalensis", name: "Neanderthal", status: Implemented, species: "homo_neanderthalensis", sunlight: true,
            // A people of the weak northern sun, some of them pale and red-haired by an MC1R
            // variant of their own (Lalueza-Fox et al. 2007).
            loci: [(locus: "red_hair", frequencies: [0.93, 0.07])],
            realism_source: "Lalueza-Fox et al. 2007 (MC1R); review",
            uncertain: true,
        ),
    ],
)
