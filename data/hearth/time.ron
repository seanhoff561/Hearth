// Calendar defaults and the constants behind the two time scales (v2 §4). The conversion code
// is `hearth_content::time`: day-scale durations compress by day_length / 24 h, year-scale
// durations by game year / real year.
(
    schema: 1,
    // Real minutes per game day.
    day_length_min: (default: 48, min: 20, max: 120),
    // Four seasons per year; 91 gives a real-length year.
    days_per_season: (default: 8, min: 3, max: 91),
    axial_tilt_deg: (default: 23.44, min: 0.0, max: 45.0),
    starting_season: Spring,
    real_day_s: 86400.0,
    // Tropical year.
    real_year_days: 365.2422,
    synodic_month_days: 29.530589,
    // Sleeping speeds time up smoothly instead of skipping the night (v2 §9.5).
    sleep: (max_factor: 100.0, ramp_s: 3.0),
)
