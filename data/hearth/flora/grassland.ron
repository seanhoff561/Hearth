// The grasslands' own (V2-10 (b)): the feather-grass steppes of the Old World and the prairies
// of the New — bunch grasses short and tall, sages and wormwoods, the flowers of the open
// plains — rounded from general grassland ecology and botany references. Climates are the
// species' ranges in the semi-arid and continental grasslands (Köppen BSk, Dfa, Dfb).
(
    schema: 1,
    entries: [
        (
            id: "feather_grass", name: "Feather grass", scientific: "Stipa pennata", form: Grass, status: Implemented,
            climate: (temp_c: (-2, 14), precip_mm: (200, 650), koppen: ["BSk", "Dfa", "Dfb", "BWk"]),
            shade_tolerance: 0.05, phenology: (leaf_out: 0.05, flowering: (0.2, 0.3), fruiting: (0.3, 0.4)),
            dispersal: Wind, max_height_m: 0.8, lifespan_years: 15,
            parts: [
                (part: Leaf, material: "dry_grass", seasons: [Summer, Autumn, Winter], edibility: Inedible, uses: ["bedding", "tinder", "thatch"]),
            ],
            understory: (block: "feather_grass", abundance: 0.85, light: (0.6, 1.0), ground: [Lime], patch_m: 40),
            flammability: 0.8, appearance: (foliage: "#9aa65a", flower: "#e8e4d4", autumn: "#cdbd8a", sprite: Tuft),
            realms: ["Palearctic"],
            notes: "The steppe's silver: in early summer its long feathered awns stream in the wind like waves.",
        ),
        (
            id: "steppe_fescue", name: "Steppe fescue", scientific: "Festuca valesiaca", form: Grass, status: Implemented,
            climate: (temp_c: (-4, 14), precip_mm: (180, 600), koppen: ["BSk", "Dfa", "Dfb", "BWk"]),
            shade_tolerance: 0.05, phenology: (leaf_out: 0.04, flowering: (0.22, 0.3), fruiting: (0.3, 0.4)),
            dispersal: Wind, max_height_m: 0.4, lifespan_years: 10,
            parts: [
                (part: Leaf, material: "dry_grass", seasons: [Summer, Autumn, Winter], edibility: Inedible, uses: ["bedding", "tinder"]),
                (part: Seed, material: "grass_seed", seasons: [Summer], edibility: AfterProcess("grind_seeds"), yield_kg: (0.001, 0.005)),
            ],
            understory: (block: "steppe_fescue", abundance: 0.9, light: (0.6, 1.0), patch_m: 30),
            flammability: 0.7, appearance: (foliage: "#7a8a5a", flower: "#b8a878", autumn: "#bfae80", sprite: Tuft),
            realms: ["Palearctic"],
            notes: "Fine grey-green tussocks a span high: the short grass of the dry steppe, the saiga's and the horse's pasture.",
        ),
        (
            id: "big_bluestem", name: "Big bluestem", scientific: "Andropogon gerardii", form: Grass, status: Implemented,
            climate: (temp_c: (2, 20), precip_mm: (500, 1200), koppen: ["Dfa", "Dfb", "Cfa", "BSk"]),
            shade_tolerance: 0.1, phenology: (leaf_out: 0.12, flowering: (0.4, 0.5), fruiting: (0.5, 0.6)),
            dispersal: Wind, max_height_m: 2.0, lifespan_years: 20,
            parts: [
                (part: Leaf, material: "dry_grass", seasons: [Autumn, Winter], edibility: Inedible, uses: ["bedding", "thatch", "tinder"]),
                (part: Seed, material: "grass_seed", seasons: [Autumn], edibility: AfterProcess("grind_seeds"), yield_kg: (0.002, 0.01)),
