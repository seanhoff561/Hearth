            understory: (block: "big_bluestem", abundance: 0.85, light: (0.6, 1.0), ground: [Rich], patch_m: 40),
            flammability: 0.9, appearance: (foliage: "#5a7a6a", flower: "#7a4a5a", autumn: "#a0522d", sprite: Tuft),
            realms: ["Nearctic"],
            notes: "The tallgrass prairie's grass, higher than a rider's head by autumn, when it turns the colour of copper; its roots run as deep.",
        ),
        (
            id: "blue_grama", name: "Blue grama", scientific: "Bouteloua gracilis", form: Grass, status: Implemented,
