// The coasts' plants (V2-10 (f)): the sea's weeds and grasses (drawn by the generator's kelp,
// wrack and seagrass of the shelves and the shallows), the mangroves standing on their stilt
// roots in the tidal mud of the tropics, the coconut palm of the tropical shore, and the salt
// marsh's, the dunes' and the sea cliffs' own (`ground: [Salt]`: on the coast and nowhere else).
(
    schema: 1,
    entries: [
        // ---- The sea's ----
        (
            id: "giant_kelp", name: "Giant kelp", scientific: "Macrocystis pyrifera", form: Alga, status: Implemented,
            climate: (temp_c: (4, 20), precip_mm: (0, 4000)),
            shade_tolerance: 0.3, phenology: (fruiting: (0.0, 1.0)),
            dispersal: Water, max_height_m: 45, lifespan_years: 7,
            parts: [
                (part: Leaf, material: "kelp", seasons: [Spring, Summer, Autumn, Winter], edibility: Edible, yield_kg: (1, 10), uses: ["food", "fertiliser", "soda"]),
            ],
            flammability: 0.0, appearance: (foliage: "#6a5a1a"),
            realms: ["Nearctic", "Neotropical", "Australasian", "Afrotropical"],
            notes: "The forests of the cool Pacific and the southern seas: stipes up from a holdfast on the rock, held up by gas bladders at each blade, growing half a metre a day to lie along the surface; the sea otter's and the urchin's world. The generator's kelp of the rocky shelves.",
        ),
        (
            id: "oarweed", name: "Oarweed", scientific: "Laminaria digitata", form: Alga, status: Implemented,
            climate: (temp_c: (-2, 18), precip_mm: (0, 4000)),
            shade_tolerance: 0.4, phenology: (fruiting: (0.7, 1.0)),
            dispersal: Water, max_height_m: 3, lifespan_years: 6,
            parts: [
                (part: Leaf, material: "kelp", seasons: [Spring, Summer, Autumn, Winter], edibility: Edible, yield_kg: (0.5, 3), uses: ["food", "fertiliser", "soda"]),
            ],
            flammability: 0.0, appearance: (foliage: "#5a4a1a"),
            realms: ["Palearctic", "Nearctic"],
            notes: "The North Atlantic's kelp, a leathery hand of fronds on a stiff stalk below the low-tide line; cast up by the winter storms, it is gathered to dung the fields and burned for its soda and iodine. The generator's kelp of the rocky shelves.",
        ),
        (
            id: "bladder_wrack", name: "Bladder wrack", scientific: "Fucus vesiculosus", form: Alga, status: Implemented,
            climate: (temp_c: (-2, 20), precip_mm: (0, 4000)),
            shade_tolerance: 0.2, phenology: (fruiting: (0.2, 0.6)),
            dispersal: Water, max_height_m: 0.9, lifespan_years: 4,
            parts: [
                (part: Whole, material: "kelp", seasons: [Spring, Summer, Autumn, Winter], edibility: Edible, yield_kg: (0.1, 0.5), uses: ["fertiliser", "medicine"]),
            ],
            flammability: 0.0, appearance: (foliage: "#6a5a2a"),
            realms: ["Palearctic", "Nearctic"],
            notes: "The olive weed of the rocks between the tides, buoyed by paired air bladders; the shore's wrack in the generator.",
        ),
        (
            id: "eelgrass", name: "Eelgrass", scientific: "Zostera marina", form: Aquatic, status: Implemented,
            climate: (temp_c: (-2, 22), precip_mm: (0, 4000)),
            shade_tolerance: 0.2, phenology: (flowering: (0.4, 0.6), fruiting: (0.55, 0.75)),
            dispersal: Water, max_height_m: 1.2, lifespan_years: 10,
            flammability: 0.0, appearance: (foliage: "#3a6a2a"),
            realms: ["Palearctic", "Nearctic"],
            notes: "A true grass of the sea, flowering under water: meadows of ribbon leaves on the sandy bottoms of the cool shallows, the nursery of the cod and the herring and the food of the brent geese. The generator's seagrass of the cool shelves.",
        ),
        (
            id: "turtle_grass", name: "Turtle grass", scientific: "Thalassia testudinum", form: Aquatic, status: Implemented,
            climate: (temp_c: (20, 30), precip_mm: (0, 4000)),
            shade_tolerance: 0.2, phenology: (flowering: (0.3, 0.5)),
            dispersal: Water, max_height_m: 0.35, lifespan_years: 20,
            flammability: 0.0, appearance: (foliage: "#4a7a3a"),
            realms: ["Neotropical", "Nearctic", "Indomalayan", "Australasian", "Afrotropical", "Oceanian"],
            notes: "The broad-bladed seagrass of the warm shallows behind the reefs, grazed by green turtles, manatees and dugongs. The generator's seagrass of the warm shallows (the Indo-Pacific's are its kin).",
        ),
        (
            id: "sargassum", name: "Sargassum", scientific: "Sargassum natans", form: Alga, status: Planned,
            climate: (temp_c: (18, 28), precip_mm: (0, 4000)),
            shade_tolerance: 0.1,
            dispersal: Water, max_height_m: 0.5, lifespan_years: 2,
            flammability: 0.0, appearance: (foliage: "#a8781a"),
            realms: ["Neotropical", "Nearctic", "Palearctic", "Afrotropical"],
            notes: "Golden weed that floats its whole life on the warm Atlantic, in mats the size of fields: the drifting home of young turtles and flying fish, and the open ocean's only plant a sailor sees.",
        ),
        // ---- The mangroves ----
        (
            id: "red_mangrove", name: "Red mangrove", scientific: "Rhizophora mangle", form: Tree, status: Implemented,
            climate: (temp_c: (20, 30), min_coldest_month_c: 15, precip_mm: (500, 4500), koppen: ["Af", "Am", "Aw", "BSh", "BWh", "Cfa"]),
            soil: (drainage: (0.0, 0.3)),
            shade_tolerance: 0.2, phenology: (flowering: (0.2, 0.6), fruiting: (0.5, 0.9)),
            dispersal: Water, growth_m_per_year: 0.4, max_height_m: 15, max_trunk_diameter_m: 0.5, lifespan_years: 100,
            wood: "mangrove_wood",
            tree: (crown: Rounded, crown_ratio: 0.6, crown_width: 0.8, apical_dominance: 0.3, branch_angle_deg: 55, droop: 0.2, stems: 1, root_flare: 0.0, prop_roots: 0.18, leaf: Broad, foliage_density: 0.85, bark: Smooth, log: "red_mangrove_log", branch: "red_mangrove_branch", leaves: "red_mangrove_leaves"),
            parts: [
                (part: Bark, material: "mangrove_bark", seasons: [Spring, Summer, Autumn, Winter], edibility: Inedible, yield_kg: (2, 15), uses: ["tannin", "dye"]),
            ],
            flammability: 0.1, appearance: (foliage: "#3a6a2a", bark: "#7a5a4a", crown: "rounded"),
            realms: ["Neotropical", "Nearctic", "Afrotropical"],
            notes: "The mangrove of the Atlantic's tropical coasts, standing in the tide on a cage of arching stilt roots; its seeds sprout on the tree into long green spears that drop into the mud or float off for a year. Its bark tans leather red.",
        ),
        (
            id: "loop_root_mangrove", name: "Loop-root mangrove", scientific: "Rhizophora mucronata", form: Tree, status: Implemented,
            climate: (temp_c: (20, 30), min_coldest_month_c: 15, precip_mm: (500, 4500), koppen: ["Af", "Am", "Aw", "BSh", "BWh"]),
            soil: (drainage: (0.0, 0.3)),
            shade_tolerance: 0.2, phenology: (flowering: (0.0, 1.0), fruiting: (0.0, 1.0)),
            dispersal: Water, growth_m_per_year: 0.4, max_height_m: 25, max_trunk_diameter_m: 0.7, lifespan_years: 100,
            wood: "mangrove_wood",
            tree: (crown: Rounded, crown_ratio: 0.55, crown_width: 0.7, apical_dominance: 0.35, branch_angle_deg: 55, droop: 0.2, stems: 1, root_flare: 0.0, prop_roots: 0.15, leaf: Broad, foliage_density: 0.85, bark: Fissured, log: "loop_root_mangrove_log", branch: "loop_root_mangrove_branch", leaves: "loop_root_mangrove_leaves"),
            parts: [
                (part: Bark, material: "mangrove_bark", seasons: [Spring, Summer, Autumn, Winter], edibility: Inedible, yield_kg: (2, 20), uses: ["tannin", "dye"]),
            ],
            flammability: 0.1, appearance: (foliage: "#3a6a2a", bark: "#5a4a3a", crown: "rounded"),
            realms: ["Indomalayan", "Australasian", "Afrotropical", "Oceanian"],
            notes: "The stilt-rooted mangrove of the Indian Ocean and the western Pacific, taller than the Atlantic's; its straight, rot-proof poles roof the houses of the Swahili coast and its wood makes the best charcoal of the tropics.",
        ),
        (
            id: "grey_mangrove", name: "Grey mangrove", scientific: "Avicennia marina", form: Tree, status: Implemented,
            climate: (temp_c: (16, 30), min_coldest_month_c: 8, precip_mm: (50, 4000), koppen: ["Af", "Am", "Aw", "BSh", "BWh", "Cfa", "Cfb"]),
            soil: (drainage: (0.0, 0.3)),
            shade_tolerance: 0.1, phenology: (flowering: (0.3, 0.6), fruiting: (0.5, 0.8)),
            dispersal: Water, growth_m_per_year: 0.4, max_height_m: 10, max_trunk_diameter_m: 0.4, lifespan_years: 80,
            wood: "mangrove_wood",
            tree: (crown: Spreading, crown_ratio: 0.65, crown_width: 1.0, apical_dominance: 0.2, branch_angle_deg: 60, droop: 0.15, stems: 1, root_flare: 0.6, leaf: Broad, foliage_density: 0.75, bark: Smooth, log: "grey_mangrove_log", branch: "grey_mangrove_branch", leaves: "grey_mangrove_leaves"),
            parts: [
                (part: Leaf, material: "mangrove_leaves", seasons: [Spring, Summer, Autumn, Winter], edibility: Inedible, yield_kg: (1, 10), uses: ["fodder"]),
            ],
            flammability: 0.1, appearance: (foliage: "#5a7a5a", bark: "#a8a090", crown: "spreading"),
            realms: ["Indomalayan", "Australasian", "Afrotropical", "Palearctic", "Oceanian"],
            notes: "The hardiest mangrove, from the Red Sea's deserts to New Zealand: a pale-barked spreading tree of the seaward fringe that breathes through a bed of pencil roots standing up out of the mud, its grey-green leaves sweating salt; camels and goats browse it.",
        ),
        // ---- The tropical shore ----
        (
            id: "coconut_palm", name: "Coconut palm", scientific: "Cocos nucifera", form: Tree, status: Implemented,
            climate: (temp_c: (21, 30), min_coldest_month_c: 17, precip_mm: (700, 4500), koppen: ["Af", "Am", "Aw", "BSh"]),
            soil: (drainage: (0.4, 1.0)),
            shade_tolerance: 0.1, phenology: (flowering: (0.0, 1.0), fruiting: (0.0, 1.0)),
            dispersal: Water, growth_m_per_year: 0.6, max_height_m: 25, max_trunk_diameter_m: 0.5, lifespan_years: 80,
            wood: "palm_wood",
            tree: (crown: Palm, crown_ratio: 0.2, crown_width: 0.45, apical_dominance: 1.0, branch_angle_deg: 55, droop: 0.15, root_flare: 0.3, foliage_density: 0.75, bark: Banded, log: "coconut_palm_log", branch: "coconut_palm_branch", leaves: "coconut_palm_leaves"),
            parts: [
                (part: Nut, material: "coconut", seasons: [Spring, Summer, Autumn, Winter], edibility: Edible, yield_kg: (30, 75), uses: ["food", "drink", "oil"]),
                (part: Fibre, material: "coir", seasons: [Spring, Summer, Autumn, Winter], edibility: Inedible, yield_kg: (5, 15), uses: ["cordage", "matting"]),
                (part: Leaf, material: "palm_frond", seasons: [Spring, Summer, Autumn, Winter], edibility: Inedible, yield_kg: (5, 15), uses: ["thatch", "weaving"]),
                (part: Sap, material: "palm_sap", seasons: [Spring, Summer, Autumn, Winter], edibility: Edible, yield_kg: (1, 4), uses: ["drink", "sugar"]),
            ],
            flammability: 0.3, appearance: (foliage: "#4a7a2a", bark: "#8a7a6a", crown: "palm"),
            realms: ["Indomalayan", "Australasian", "Oceanian", "Afrotropical", "Neotropical"],
            notes: "The leaning palm of every tropical shore, its nuts floating across oceans to take root where the waves leave them: water, food, oil, rope, thatch, mats and toddy from one tree, the Pacific islanders' tree of life.",
        ),
        // ---- The salt marsh ----
        (
            id: "smooth_cordgrass", name: "Smooth cordgrass", scientific: "Spartina alterniflora", form: Grass, status: Implemented,
            climate: (temp_c: (2, 27), precip_mm: (300, 2500)),
            shade_tolerance: 0.05, phenology: (flowering: (0.55, 0.75), fruiting: (0.65, 0.85)),
            dispersal: Water, max_height_m: 2, lifespan_years: 20,
            understory: (block: "cordgrass", abundance: 0.9, light: (0.6, 1.0), ground: [Salt, Wet], patch_m: 40),
            flammability: 0.5, appearance: (foliage: "#8a9a5a", autumn: "#b0a070", sprite: Tuft),
            realms: ["Nearctic", "Neotropical", "Palearctic"],
            notes: "The tall grass of the tidal marshes, flooded twice a day and building the marsh by catching the mud the tide brings; its kin hold the salt marshes of Europe.",
        ),
        (
            id: "glasswort", name: "Glasswort", scientific: "Salicornia europaea", form: Succulent, status: Implemented,
            climate: (temp_c: (-2, 28), precip_mm: (50, 2500)),
            shade_tolerance: 0.05, phenology: (flowering: (0.55, 0.7), fruiting: (0.65, 0.85)),
            dispersal: Water, max_height_m: 0.3, lifespan_years: 1,
            parts: [
                (part: Shoot, material: "samphire", seasons: [Summer], edibility: Edible, yield_kg: (0.02, 0.1), uses: ["food", "soda"]),
            ],
            understory: (block: "glasswort", abundance: 0.6, light: (0.7, 1.0), ground: [Salt], patch_m: 15),
            flammability: 0.1, appearance: (foliage: "#6a8a3a", autumn: "#a03a3a", sprite: Spike),
            realms: ["Palearctic", "Nearctic", "Afrotropical", "Australasian", "Neotropical", "Indomalayan"],
            notes: "Jointed, leafless green stems on the open mud the tide covers, red in autumn: samphire, eaten crisp, and burned for the soda ash the first glass was made with.",
        ),
        (
            id: "sea_lavender", name: "Sea lavender", scientific: "Limonium vulgare", form: Herb, status: Implemented,
            climate: (temp_c: (2, 20), precip_mm: (300, 1500)),
            shade_tolerance: 0.1, phenology: (flowering: (0.5, 0.7)),
            dispersal: Wind, max_height_m: 0.4, lifespan_years: 15,
            understory: (block: "sea_lavender", abundance: 0.4, light: (0.7, 1.0), ground: [Salt], patch_m: 20),
            flammability: 0.2, appearance: (foliage: "#4a6a4a", flower: "#9a7ac8", sprite: Umbel),
            realms: ["Palearctic"],
            notes: "Sprays of papery lilac flowers over the upper salt marsh in late summer, colouring it purple.",
        ),
        // ---- The dunes ----
        (
            id: "marram_grass", name: "Marram grass", scientific: "Ammophila arenaria", form: Grass, status: Implemented,
            climate: (temp_c: (2, 20), precip_mm: (300, 1800)),
            shade_tolerance: 0.05, phenology: (flowering: (0.45, 0.6)),
            dispersal: Wind, max_height_m: 1.0, lifespan_years: 30,
            understory: (block: "marram_grass", abundance: 0.8, light: (0.7, 1.0), ground: [Salt], patch_m: 25),
            flammability: 0.6, appearance: (foliage: "#9aa070", autumn: "#b8b090", sprite: Tuft),
            realms: ["Palearctic", "Nearctic"],
            notes: "The grey-green grass of the sand dunes, growing up through the sand that buries it and binding the dunes with its roots; woven into mats and baskets on the coasts of Scotland.",
        ),
        (
            id: "sea_rocket", name: "Sea rocket", scientific: "Cakile maritima", form: Herb, status: Implemented,
            climate: (temp_c: (2, 24), precip_mm: (100, 1800)),
            shade_tolerance: 0.05, phenology: (flowering: (0.4, 0.75)),
            dispersal: Water, max_height_m: 0.4, lifespan_years: 1,
            understory: (block: "sea_rocket", abundance: 0.3, light: (0.7, 1.0), ground: [Salt], patch_m: 0),
            flammability: 0.2, appearance: (foliage: "#5a8a5a", flower: "#d8b0e0", sprite: Rosette),
            realms: ["Palearctic", "Nearctic", "Australasian"],
            notes: "A fleshy mustard of the strandline, its pale lilac flowers among the dried weed the high tide left; its leaves are hot and edible.",
        ),
        (
            id: "beach_morning_glory", name: "Beach morning glory", scientific: "Ipomoea pes-caprae", form: Vine, status: Implemented,
            climate: (temp_c: (18, 30), precip_mm: (300, 4500)),
            shade_tolerance: 0.05, phenology: (flowering: (0.0, 1.0)),
            dispersal: Water, max_height_m: 0.3, lifespan_years: 10,
            understory: (block: "beach_morning_glory", abundance: 0.6, light: (0.7, 1.0), ground: [Salt], patch_m: 20),
            flammability: 0.2, appearance: (foliage: "#3a7a3a", flower: "#c84a9a", sprite: Creeper),
            realms: ["Neotropical", "Afrotropical", "Indomalayan", "Australasian", "Oceanian", "Nearctic"],
            notes: "Goat's-foot leaves on runners tens of metres long across the tropical beaches' sand, with pink-purple trumpets: the first plant on new sand, its seeds floating from shore to shore.",
        ),
        // ---- The sea cliffs and rocky shores ----
        (
            id: "sea_thrift", name: "Thrift", scientific: "Armeria maritima", form: Herb, status: Implemented,
            climate: (temp_c: (-8, 18), precip_mm: (200, 2500)),
            shade_tolerance: 0.1, phenology: (flowering: (0.3, 0.55)),
            dispersal: Wind, max_height_m: 0.25, lifespan_years: 15,
            understory: (block: "sea_thrift", abundance: 0.5, light: (0.7, 1.0), ground: [Salt], patch_m: 10),
            flammability: 0.1, appearance: (foliage: "#4a7a4a", flower: "#e890b8", sprite: Tuft),
            realms: ["Palearctic", "Nearctic"],
            notes: "Cushions of grassy leaves in the cracks of sea cliffs and the turf of the rocky shores, covered in spring with pink pompom flowers; the puffins' cliffs are pink with it.",
        ),
    ],
)
