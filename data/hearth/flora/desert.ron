// The deserts' own (V2-10 (b)): the creosote, mesquite and prickly pear of the hot deserts of
// the New World, the sagebrush and saltbush of its cold ones; saxaul, tamarisk and camelthorn of
// the Old World's; and the joint pine of both. Rounded from general arid-land botany references:
// climates are the species' ranges in the hot and cold deserts and their steppe margins (Köppen
// BWh, BWk, BSh, BSk).
(
    schema: 1,
    entries: [
        (
            id: "creosote_bush", name: "Creosote bush", scientific: "Larrea tridentata", form: Shrub, status: Implemented,
            climate: (temp_c: (12, 26), min_coldest_month_c: -2, precip_mm: (60, 400), koppen: ["BWh", "BSh"]),
            shade_tolerance: 0.0, phenology: (flowering: (0.05, 0.2), fruiting: (0.15, 0.3)),
            max_height_m: 2.0, lifespan_years: 1000,
            parts: [
                (part: Leaf, material: "creosote_leaves", seasons: [Spring, Summer, Autumn, Winter], edibility: Inedible, yield_kg: (0.05, 0.3), uses: ["medicine"]),
                (part: Resin, material: "creosote_lac", seasons: [Summer], edibility: Inedible, uses: ["adhesive", "mending"]),
            ],
            understory: (block: "creosote_bush", abundance: 0.45, light: (0.8, 1.0), patch_m: 30),
            flammability: 0.4, appearance: (foliage: "#5a6a3a", flower: "#e8c830", sprite: Bush),
            realms: ["Nearctic"],
            notes: "The desert's commonest shrub, spaced as if planted (its roots keep others off); after rain the whole desert smells of it. A clone in the Mojave is near twelve thousand years old.",
        ),
        (
            id: "prickly_pear", name: "Prickly pear", scientific: "Opuntia engelmannii", form: Succulent, status: Implemented,
            climate: (temp_c: (10, 26), min_coldest_month_c: -6, precip_mm: (100, 700), koppen: ["BWh", "BSh", "BSk", "Csa"]),
            shade_tolerance: 0.1, phenology: (flowering: (0.15, 0.25), fruiting: (0.35, 0.55)),
            dispersal: Animal, max_height_m: 1.5, lifespan_years: 30,
            parts: [
                (part: Fruit, material: "prickly_pear_fruit", seasons: [Summer, Autumn], edibility: Edible, yield_kg: (0.2, 2.0), uses: ["food"]),
                (part: Shoot, material: "nopal", seasons: [Spring, Summer], edibility: Edible, yield_kg: (0.2, 1.5), uses: ["food", "water"]),
            ],
            understory: (block: "prickly_pear", abundance: 0.35, light: (0.7, 1.0), patch_m: 16),
            flammability: 0.05, appearance: (foliage: "#5a8a4a", flower: "#e8d040", fruit: "#8a2050", sprite: Cactus),
            realms: ["Nearctic"],
            notes: "Paddles of spines that hold water; its purple fruits (tunas) and young pads (nopales) are food once the spines and their fine glochids are burned off.",
        ),
        (
            id: "honey_mesquite", name: "Honey mesquite", scientific: "Prosopis glandulosa", form: Tree, status: Implemented, deciduous: true,
            climate: (temp_c: (12, 26), min_coldest_month_c: -4, precip_mm: (150, 800), koppen: ["BWh", "BSh", "BSk", "Cfa"]),
            soil: (drainage: (0.4, 1.0)),
            shade_tolerance: 0.05, phenology: (leaf_out: 0.08, flowering: (0.1, 0.2), fruiting: (0.35, 0.5), leaf_fall: (0.75, 0.85)),
            dispersal: Animal, growth_m_per_year: 0.4, max_height_m: 9, max_trunk_diameter_m: 0.6, lifespan_years: 200,
            wood: "mesquite_wood",
            tree: (crown: Spreading, crown_ratio: 0.6, crown_width: 0.9, apical_dominance: 0.3, branch_angle_deg: 55, droop: 0.4, stems: 3, root_flare: 0.15, foliage_density: 0.45, bark: Furrowed, log: "mesquite_log", branch: "mesquite_branch", leaves: "mesquite_leaves"),
            parts: [
                (part: Seed, material: "mesquite_pod", seasons: [Summer, Autumn], edibility: Edible, yield_kg: (2, 20), uses: ["food", "flour"]),
                (part: Resin, material: "mesquite_gum", seasons: [Summer], edibility: Edible, uses: ["food", "adhesive"]),
            ],
            flammability: 0.4, appearance: (foliage: "#7a9a4a", bark: "#4a3a2e", crown: "spreading"),
            realms: ["Nearctic"],
            notes: "Its sweet pods were ground into the desert peoples' flour; its roots go down sixty metres to water, and its hard wood burns long and hot.",
        ),
        (
            id: "black_saxaul", name: "Black saxaul", scientific: "Haloxylon ammodendron", form: Tree, status: Implemented,
            climate: (temp_c: (4, 18), min_coldest_month_c: -25, precip_mm: (60, 300), koppen: ["BWk", "BSk", "BWh"]),
            soil: (drainage: (0.5, 1.0)),
            shade_tolerance: 0.0, phenology: (flowering: (0.15, 0.25), fruiting: (0.5, 0.65)),
            dispersal: Wind, growth_m_per_year: 0.3, max_height_m: 8, max_trunk_diameter_m: 0.4, lifespan_years: 60,
            wood: "saxaul_wood",
            tree: (crown: Rounded, crown_ratio: 0.7, crown_width: 0.7, apical_dominance: 0.2, branch_angle_deg: 50, droop: 0.5, stems: 3, root_flare: 0.1, leaf: Scale, foliage_density: 0.35, bark: Scaly, log: "saxaul_log", branch: "saxaul_branch", leaves: "saxaul_leaves"),
            flammability: 0.5, appearance: (foliage: "#6a8a5a", bark: "#5a5048", crown: "rounded"),
            realms: ["Palearctic"],
            notes: "Leafless green twigs on a gnarled trunk, so dense the wood sinks in water: the best firewood of the Central Asian deserts, and their dunes' anchor.",
        ),
        (
            id: "tamarisk", name: "Salt cedar", scientific: "Tamarix ramosissima", form: Tree, status: Implemented, deciduous: true,
            climate: (temp_c: (6, 24), min_coldest_month_c: -20, precip_mm: (50, 500), koppen: ["BWk", "BWh", "BSk", "BSh"]),
            soil: (drainage: (0.0, 0.7)),
            shade_tolerance: 0.05, phenology: (leaf_out: 0.08, flowering: (0.2, 0.45), leaf_fall: (0.65, 0.75)),
            dispersal: Wind, growth_m_per_year: 0.8, max_height_m: 6, max_trunk_diameter_m: 0.3, lifespan_years: 75,
            wood: "tamarisk_wood",
            tree: (crown: MultiStemmed, crown_ratio: 0.8, crown_width: 0.7, apical_dominance: 0.2, branch_angle_deg: 40, droop: 0.5, stems: 5, root_flare: 0.05, leaf: Scale, foliage_density: 0.5, autumn: Yellow, bark: Smooth, log: "tamarisk_log", branch: "tamarisk_branch", leaves: "tamarisk_leaves"),
            parts: [
                (part: Sap, material: "manna", seasons: [Summer], edibility: Edible, yield_kg: (0.01, 0.1), uses: ["food"]),
            ],
            flammability: 0.5, appearance: (foliage: "#7a9a7a", bark: "#7a4a3a", crown: "multistemmed"),
            realms: ["Palearctic"],
            notes: "Feathery scale-leaved thickets along desert rivers and salt flats, pink with flowers in summer; insects on it drip the sweet 'manna' that hardens on the twigs.",
        ),
        (
            id: "camelthorn", name: "Camelthorn", scientific: "Alhagi maurorum", form: Shrub, status: Implemented, deciduous: true,
            climate: (temp_c: (8, 26), min_coldest_month_c: -15, precip_mm: (50, 400), koppen: ["BWh", "BWk", "BSh", "BSk"]),
            shade_tolerance: 0.0, phenology: (leaf_out: 0.06, flowering: (0.25, 0.4), leaf_fall: (0.7, 0.8)),
            max_height_m: 1.0, lifespan_years: 20,
            parts: [
                (part: Sap, material: "manna", seasons: [Summer], edibility: Edible, yield_kg: (0.005, 0.03), uses: ["food"]),
            ],
            understory: (block: "camelthorn", abundance: 0.45, light: (0.8, 1.0), ground: [Disturbed], patch_m: 20),
            flammability: 0.5, appearance: (foliage: "#6a8a4a", sprite: Heath),
            realms: ["Palearctic"],
            notes: "Thorny and green through the hottest summer on roots that reach the water table: the camels' browse. Its small pink pea flowers are lost among the thorns.",
        ),
        (
            id: "big_sagebrush", name: "Big sagebrush", scientific: "Artemisia tridentata", form: Shrub, status: Implemented,
            climate: (temp_c: (0, 14), min_coldest_month_c: -25, precip_mm: (150, 500), koppen: ["BSk", "BWk", "Dsb", "Dfb"]),
            shade_tolerance: 0.05, phenology: (flowering: (0.5, 0.62)),
            max_height_m: 2.0, lifespan_years: 100,
            parts: [
                (part: Leaf, material: "sage_leaves", seasons: [Spring, Summer, Autumn, Winter], edibility: Inedible, yield_kg: (0.05, 0.3), uses: ["medicine", "smudge"]),
                (part: Bark, material: "sagebrush_bark", seasons: [Spring, Summer, Autumn, Winter], edibility: Inedible, uses: ["cordage", "tinder", "clothing"]),
            ],
            understory: (block: "big_sagebrush", abundance: 0.85, light: (0.7, 1.0), patch_m: 60),
            flammability: 0.7, appearance: (foliage: "#9aa49a", flower: "#d8c860", sprite: Bush),
            realms: ["Nearctic"],
            notes: "The silver-grey sea of the Great Basin, pungent after rain; its shredded bark was woven into sandals, mats and robes, and it feeds the sage grouse all winter.",
        ),
        (
            id: "fourwing_saltbush", name: "Fourwing saltbush", scientific: "Atriplex canescens", form: Shrub, status: Implemented,
