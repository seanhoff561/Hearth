            shade_tolerance: 0.05, phenology: (flowering: (0.3, 0.45), fruiting: (0.5, 0.75)),
            max_height_m: 1.5, lifespan_years: 30,
            parts: [
                (part: Leaf, material: "saltbush_leaves", seasons: [Spring, Summer], edibility: Edible, yield_kg: (0.05, 0.3), uses: ["food"]),
                (part: Seed, material: "grass_seed", seasons: [Autumn, Winter], edibility: AfterProcess("grind_seeds"), yield_kg: (0.02, 0.2)),
            ],
            understory: (block: "fourwing_saltbush", abundance: 0.5, light: (0.7, 1.0), patch_m: 24),
            flammability: 0.2, appearance: (foliage: "#a0a890", fruit: "#c8b878", sprite: Bush),
            realms: ["Nearctic"],
            notes: "Salty grey leaves that browsers seek in winter and people boiled as greens; it grows where the soil is too salt for most.",
        ),
        (
            id: "joint_pine", name: "Joint pine", scientific: "Ephedra", form: Shrub, status: Implemented,
            climate: (temp_c: (4, 24), min_coldest_month_c: -25, precip_mm: (50, 450), koppen: ["BWk", "BWh", "BSk", "BSh"]),
            shade_tolerance: 0.0, phenology: (flowering: (0.1, 0.2), fruiting: (0.3, 0.4)),
            max_height_m: 1.0, lifespan_years: 50,
            parts: [
                (part: Shoot, material: "ephedra_stems", seasons: [Spring, Summer, Autumn, Winter], edibility: Inedible, yield_kg: (0.02, 0.1), uses: ["medicine", "tea"]),
            ],
            understory: (block: "joint_pine", abundance: 0.35, light: (0.8, 1.0), patch_m: 12),
            flammability: 0.3, appearance: (foliage: "#5a7a4a", sprite: Tuft),
            realms: ["Palearctic", "Nearctic"],
            notes: "Leafless jointed green stems: brewed into Mormon tea in the New World, and a stimulant (ephedrine) of medicine in the Old.",
