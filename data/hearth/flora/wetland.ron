// Wetland plants (V2-10 (e)): the reeds, sedges and lilies of the marshes, bogs, swamps and the
// shallows of lakes and rivers, and the swamp trees of the Americas and Africa. A plant of the
// water stands up out of the shallows (`Emergent`) or lays its leaves on the surface
// (`Floating`), in water as deep as it names.
(
    schema: 1,
    entries: [
        // ---- Standing in the shallows ----
        (
            id: "common_reed", name: "Common reed", scientific: "Phragmites australis", form: Grass, status: Implemented,
            climate: (temp_c: (-4, 28), precip_mm: (150, 3500)),
            shade_tolerance: 0.1, phenology: (flowering: (0.55, 0.7), fruiting: (0.7, 0.95)),
            dispersal: Wind, max_height_m: 3, lifespan_years: 50,
            parts: [
                (part: Shoot, material: "reed", seasons: [Autumn, Winter], edibility: Inedible, yield_kg: (0.1, 0.5), uses: ["thatch", "arrows", "mats", "basketry"]),
            ],
            understory: (block: "common_reed", abundance: 0.8, light: (0.5, 1.0), ground: [Wet], patch_m: 30, water: Some(Emergent(depth_m: 1.5))),
            flammability: 0.8, appearance: (foliage: "#4a7a3a", flower: "#7a5a5a", autumn: "#b0a070", sprite: Tuft),
            realms: ["Palearctic", "Nearctic", "Afrotropical", "Indomalayan", "Neotropical", "Australasian"],
            notes: "The reed beds of every continent's marshes and lake edges, taller than a man, their purple-brown plumes nodding over the water; thatch, mats, arrow shafts and the pens of the first writing.",
        ),
        (
            id: "cattail", name: "Cattail", scientific: "Typha latifolia", form: Herb, status: Implemented,
            climate: (temp_c: (-6, 24), precip_mm: (250, 2500), koppen: ["Dfb", "Dfc", "Cfb", "Cfa", "Dfa", "Csb", "BSk"]),
            shade_tolerance: 0.1, phenology: (flowering: (0.4, 0.55), fruiting: (0.6, 0.95)),
            dispersal: Wind, max_height_m: 2.5, lifespan_years: 20,
            parts: [
                (part: Root, material: "cattail_root", seasons: [Autumn, Winter, Spring], edibility: Edible, yield_kg: (0.1, 0.6), uses: ["food"]),
                (part: Seed, material: "cattail_down", seasons: [Autumn, Winter], edibility: Inedible, yield_kg: (0.01, 0.05), uses: ["tinder", "padding", "insulation"]),
                (part: Leaf, material: "reed", seasons: [Summer, Autumn], edibility: Inedible, yield_kg: (0.1, 0.4), uses: ["mats", "basketry", "thatch"]),
            ],
            understory: (block: "cattail", abundance: 0.7, light: (0.5, 1.0), ground: [Wet], patch_m: 20, water: Some(Emergent(depth_m: 1.0))),
            flammability: 0.6, appearance: (foliage: "#5a7a3a", flower: "#5a3a1a", sprite: Spike),
            realms: ["Palearctic", "Nearctic"],
            notes: "The bulrush of the ponds' edges, its brown velvet heads bursting into down in winter: starchy roots to dig all year, down for tinder and padding, leaves for mats.",
        ),
        (
            id: "papyrus", name: "Papyrus", scientific: "Cyperus papyrus", form: Sedge, status: Implemented,
            climate: (temp_c: (18, 30), min_coldest_month_c: 10, precip_mm: (100, 3000), koppen: ["Af", "Am", "Aw", "BWh", "BSh", "Cwa"]),
            shade_tolerance: 0.1, phenology: (flowering: (0.0, 1.0)),
            dispersal: Wind, max_height_m: 4, lifespan_years: 30,
            parts: [
                (part: Shoot, material: "papyrus", seasons: [Spring, Summer, Autumn, Winter], edibility: Inedible, yield_kg: (0.5, 2), uses: ["paper", "boats", "mats", "rope", "sandals"]),
            ],
            understory: (block: "papyrus", abundance: 0.85, light: (0.5, 1.0), ground: [Wet], patch_m: 40, water: Some(Emergent(depth_m: 2.0))),
            flammability: 0.5, appearance: (foliage: "#5a8a3a", flower: "#9aaa5a", sprite: Umbel),
            realms: ["Afrotropical", "Palearctic"],
            notes: "The great sedge of Africa's swamps and the Nile, green stems topped with mops of threads, standing in floating mats that hide the hippos and the shoebill; boats, mats, rope and paper.",
        ),
        (
            id: "wild_rice", name: "Wild rice", scientific: "Zizania palustris", form: Grass, status: Implemented,
            climate: (temp_c: (-2, 12), min_warmest_month_c: 15, precip_mm: (450, 1300), koppen: ["Dfb", "Dfa", "Dfc"]),
            shade_tolerance: 0.1, phenology: (flowering: (0.5, 0.6), fruiting: (0.6, 0.7)),
            dispersal: Water, max_height_m: 2, lifespan_years: 1, lifecycle: Annual,
            parts: [
                (part: Seed, material: "wild_rice", seasons: [Autumn], edibility: Edible, yield_kg: (0.01, 0.05), uses: ["food"]),
            ],
            understory: (block: "wild_rice", abundance: 0.6, light: (0.6, 1.0), patch_m: 40, water: Some(Emergent(depth_m: 1.0))),
            flammability: 0.4, appearance: (foliage: "#7a9a4a", flower: "#b8a060", sprite: Tuft),
            realms: ["Nearctic"],
            notes: "A grass of the northern lakes' quiet shallows whose grain, knocked into a canoe in late summer and parched, was the Ojibwe's staple through the winter.",
        ),
        (
