// Temperate plants other than trees (Appendix A tier 1): the understory, grasses and fungi.
// The trees and woody shrubs are in `trees.ron`.
(
    schema: 1,
    entries: [
        (
            id: "stinging_nettle", name: "Stinging nettle", scientific: "Urtica dioica", form: Herb,
            climate: (temp_c: (0, 20), precip_mm: (400, 2000)),
