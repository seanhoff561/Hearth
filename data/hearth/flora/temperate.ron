                (part: Seed, material: "grass_seed", seasons: [Summer], edibility: AfterProcess("grind_seeds"), yield_kg: (0.001, 0.01)),
            ],
            flammability: 0.8, appearance: (foliage: "#6f9a3c", autumn: "#c8b26b"),
            realms: ["Palearctic", "Nearctic"],
            notes: "Composite entry for the grasses of temperate meadows and clearings.",
        ),
    ],
)
