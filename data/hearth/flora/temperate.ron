            parts: [
                (part: Leaf, material: "nettle_leaves", seasons: [Spring, Summer], edibility: AfterProcess("cook_greens"), yield_kg: (0.1, 0.5), uses: ["food when cooked"]),
                (part: Fibre, material: "nettle_fibre", seasons: [Autumn], edibility: Inedible, yield_kg: (0.01, 0.05), uses: ["cordage", "textile"]),
            ],
            flammability: 0.1, appearance: (foliage: "#3f6b2e"),
            realms: ["Palearctic", "Nearctic"],
            notes: "Marks nitrogen-rich ground: old camps, middens, animal lairs.",
        ),
        (
            id: "bramble", name: "Bramble", scientific: "Rubus fruticosus agg.", form: Shrub,
            climate: (temp_c: (3, 18), precip_mm: (400, 2000)),
            shade_tolerance: 0.4, phenology: (leaf_out: 0.05, flowering: (0.35, 0.5), fruiting: (0.5, 0.7)),
            dispersal: Animal, max_height_m: 2.5, lifespan_years: 30,
            parts: [(part: Fruit, material: "blackberry", seasons: [Summer, Autumn], edibility: Edible, yield_kg: (0.5, 3), uses: ["food", "dye"])],
            flammability: 0.3, appearance: (foliage: "#3b5a2a", flower: "#f0e4ea"),
            realms: ["Palearctic"],
        ),
        (
            id: "horse_hoof_fungus", name: "Hoof fungus", scientific: "Fomes fomentarius", form: Fungus,
            climate: (temp_c: (-2, 16), precip_mm: (400, 2000), koppen: ["Cfb", "Dfb", "Dfc"]),
            shade_tolerance: 0.9, dispersal: Spores, max_height_m: 0.3, lifespan_years: 30,
            parts: [(part: Whole, material: "tinder_fungus", seasons: [Spring, Summer, Autumn, Winter], edibility: Inedible, yield_kg: (0.2, 1.0),
                     uses: ["tinder", "ember carrier", "wound dressing"])],
            flammability: 0.2, appearance: (bark: "#6b5a47"),
            realms: ["Palearctic", "Nearctic"],
            notes: "Grows on dead and dying birch and beech; Ötzi carried it as a fire kit.",
        ),
        (
            id: "meadow_grass", name: "Meadow grasses", scientific: "Poaceae (temperate)", form: Grass,
            climate: (temp_c: (0, 20), precip_mm: (300, 2000)),
            shade_tolerance: 0.2, phenology: (leaf_out: 0.03, flowering: (0.3, 0.45), fruiting: (0.45, 0.6)),
