// The tundra's own and the polar desert's few (V2-10, the first expansion wave): dwarf shrubs
// a hand high, sedges and cottongrass of the wet ground, cushions and rosettes that flower the
// moment the snow goes, mosses and lichens. Tundra has no trees: its woody plants are dwarf
// shrubs of the understory. Climates from general arctic botany references: the low arctic's
// mean −4 to −12 °C, the polar desert's −12 to −20 °C, summers above 0 °C for a month or two.
(
    schema: 1,
    entries: [
        (
            id: "dwarf_birch", name: "Dwarf birch", scientific: "Betula nana", form: Shrub, status: Implemented, deciduous: true,
            climate: (temp_c: (-14, 4), precip_mm: (150, 1500), koppen: ["ET", "Dfc", "Dfd", "Dwc"]),
            shade_tolerance: 0.1, phenology: (leaf_out: 0.12, flowering: (0.12, 0.18), leaf_fall: (0.6, 0.7)),
            max_height_m: 0.6, lifespan_years: 80,
            parts: [
                (part: Wood, material: "birch_wood", seasons: [Spring, Summer, Autumn, Winter], edibility: Inedible, yield_kg: (0.2, 1.5), uses: ["firewood"]),
