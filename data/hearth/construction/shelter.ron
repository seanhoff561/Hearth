// Construction pieces (v2 §14.1, V2-8), the first set for Era 0–3 shelters. Each piece in each
// material it may be made of is a block of the world (hearth_content::building); putting one up
// uses its inputs and takes its time, taking it down gives most of them back. `size_m` is the
// piece's own size in its one block (its mass and strength come from it and the material);
// `shape` how it sits there. Quantities are what the piece takes: bark and hides overlap, brush
// is mostly air, a dry-stone wall three parts stone to one of gaps. A pole makes a post or a
// beam a block long (its offcut is not kept). Times are a practised builder's.
(
    schema: 1,
    entries: [
        // ---- Brush and poles (Era 0–1) ----
        (id: "brush_wall", status: Implemented, name: "{material} brush", materials: (categories: [Wood]),
         shape: Panel, size_m: (1.0, 1.0, 0.3), fill: 0.04, joints: [Stacked], build: (hours: 0.25), look: Brush,
         inputs: [(item: Form(form: "stick"), amount: 24)], action: "pile brush against the wind",
         insulation_r: 0.1, notes: "Branches and brush piled into a windbreak; anyone can, and doing it teaches the windbreak."),
        (id: "post", status: Implemented, name: "{material} post", materials: (categories: [Wood]),
         shape: Post, round: true, size_m: (0.04, 1.0, 0.04), joints: [Lashed, Stacked], knowledge: "lean_to", build: (hours: 0.3),
         inputs: [(item: Form(form: "pole"), amount: 1)], action: "set a post"),
        (id: "beam", status: Implemented, name: "{material} beam", materials: (categories: [Wood]),
         shape: Beam, round: true, size_m: (0.04, 0.04, 1.0), joints: [Lashed], knowledge: "lean_to", build: (hours: 0.3),
         inputs: [(item: Form(form: "pole"), amount: 1)], action: "lash a beam across"),
        // ---- Coverings ----
        (id: "brush_roof", status: Implemented, name: "{material} bough roof", materials: (categories: [Wood]),
         shape: Roof, pitch_deg: 45, size_m: (1.0, 0.25, 1.4), fill: 0.05, joints: [Lashed, Stacked], knowledge: "lean_to", build: (hours: 0.5),
         inputs: [(item: Form(form: "stick"), amount: 20), (item: Form(form: "twig"), amount: 40), (item: Form(form: "pole"), amount: 2)],
         frame: (form: "pole", count: 2, material: "willow_wood"), action: "heap boughs on the rafters", look: Brush,
         sheds_rain_min_pitch_deg: 60, insulation_r: 0.3,
         notes: "Leafy boughs and brush heaped on rafters: the first lean-tos' roof. It breaks the wind and some of the rain, and drips."),
        (id: "bark_roof", status: Implemented, name: "{material} roof", materials: (categories: [Bark]),
         shape: Roof, pitch_deg: 45, size_m: (1.0, 0.006, 1.4), joints: [Lashed, Stacked], knowledge: "lean_to", build: (hours: 0.6),
         inputs: [(item: Form(form: "strip"), amount: 56), (item: Form(form: "pole"), amount: 2)],
         frame: (form: "pole", count: 2, material: "willow_wood"), action: "lay bark on rafters",
         sheds_rain_min_pitch_deg: 30, insulation_r: 0.1,
         notes: "Bark laid overlapping down a pitch on two rafters sheds rain: 1.4 m² of slope, twice over, in strips of 0.05 m²."),
        (id: "bark_cover", status: Implemented, name: "flat {material} covering", materials: (categories: [Bark]),
         shape: Layer, size_m: (1.0, 0.006, 1.0), joints: [Stacked], knowledge: "lean_to", build: (hours: 0.4),
         inputs: [(item: Form(form: "strip"), amount: 40), (item: Form(form: "pole"), amount: 2)],
         frame: (form: "pole", count: 2, material: "willow_wood"), action: "lay bark flat on poles",
         insulation_r: 0.1, notes: "Laid flat, bark holds the rain in puddles and leaks."),
        (id: "hide_wall", status: Implemented, name: "{material} cover", materials: (tags: ["hide"]),
         shape: Panel, size_m: (1.0, 1.0, 0.005), joints: [Lashed], knowledge: "lean_to", build: (hours: 0.3),
         inputs: [(item: Form(form: "sheet"), amount: 4)], action: "hang a hide",
         insulation_r: 0.15),
        (id: "hide_roof", status: Implemented, name: "{material} roof", materials: (tags: ["hide"]),
         shape: Roof, pitch_deg: 45, size_m: (1.0, 0.005, 1.4), joints: [Lashed], knowledge: "lean_to", build: (hours: 0.4),
         inputs: [(item: Form(form: "sheet"), amount: 7), (item: Form(form: "pole"), amount: 2)],
         frame: (form: "pole", count: 2, material: "willow_wood"), action: "stretch hides over poles",
         sheds_rain_min_pitch_deg: 20, insulation_r: 0.15),
        (id: "thatch", status: Implemented, name: "{material} thatch", materials: (tags: ["thatch"]),
         shape: Roof, pitch_deg: 45, size_m: (1.0, 0.3, 1.4), fill: 0.3, joints: [Lashed], knowledge: "thatching", build: (hours: 3.0),
         inputs: [(item: Material("reed"), amount: 35.0), (item: Form(form: "pole"), amount: 2)],
         frame: (form: "pole", count: 2, material: "willow_wood"), action: "lay reed thatch on rafters",
         sheds_rain_min_pitch_deg: 45, insulation_r: 1.5,
         notes: "Bundles laid steeply shed rain for decades; laid flat they rot. A foot of reed, 25 kg the square metre."),
        (id: "wattle_panel", status: Implemented, name: "{material} wattle", materials: (tags: ["rods", "withies"]),
         shape: Panel, size_m: (1.0, 1.0, 0.05), fill: 0.5, joints: [Woven], knowledge: "wattle_and_daub", build: (hours: 1.5), look: Wattle,
         inputs: [(item: Form(form: "stick", materials: (tags: ["rods", "withies"])), amount: 12)], action: "weave wattle between the posts",
         insulation_r: 0.05, notes: "Hazel or willow rods woven between stakes: a light screen, and the frame for daub."),
        (id: "daubed_wattle", status: Implemented, name: "{material} daub on wattle", materials: (categories: [Clay]),
         shape: Panel, size_m: (1.0, 1.0, 0.15), fill: 0.9, joints: [Woven, Mortared], knowledge: "wattle_and_daub", build: (hours: 4.0),
         inputs: [(item: Form(form: "lump", materials: (categories: [Clay])), amount: 160), (item: Form(form: "stick", materials: (tags: ["rods", "withies"])), amount: 12), (item: Material("dry_grass"), amount: 1.0)],
         action: "plaster wattle with clay and straw", insulation_r: 0.25,
         notes: "Five centimetres of clay, straw and dung each side of the wattle: about 130 kg a square metre. It washes away where the rain reaches it."),
        (id: "mudbrick_wall", status: Implemented, name: "{material} mudbrick wall", materials: (categories: [Clay]),
         shape: Wall, size_m: (1.0, 1.0, 0.3), fill: 0.95, joints: [Mortared], knowledge: "mudbrick", build: (hours: 3.0),
         inputs: [(item: Form(form: "brick", materials: (categories: [Clay])), amount: 75), (item: Form(form: "lump", materials: (categories: [Clay])), amount: 12)],
         action: "lay mudbricks in mud mortar", insulation_r: 0.4,
         notes: "Seventy-five small bricks a square metre of a 30 cm wall; without plaster and eaves the rain wears it."),
        (id: "snow_wall", status: Implemented, name: "{material} wall", materials: (categories: [Snow]),
         shape: Block, size_m: (1.0, 1.0, 1.0), fill: 0.9, joints: [Stacked], knowledge: "windbreak_shelter", build: (hours: 1.5),
         inputs: [(item: Form(form: "snow_block"), amount: 19)], action: "stack snow blocks", insulation_r: 1.5,
         notes: "Packed snow insulates well and melts in a thaw."),
        // ---- Stout timber: pit houses' posts and beams, props and caps under ground ----
        (id: "log_post", status: Implemented, name: "{material} log post", materials: (categories: [Wood]),
         shape: Post, round: true, size_m: (0.4, 1.0, 0.4), fill: 0.785, joints: [Lashed, Stacked], knowledge: "pit_house", build: (hours: 1.0),
         inputs: [(item: Form(form: "log_section"), amount: 1)], action: "set a log upright", mets: 6.0,
         notes: "A metre of a 40 cm trunk on end: a pit house's post, a prop under a tunnel's roof."),
        (id: "log_beam", status: Implemented, name: "{material} log beam", materials: (categories: [Wood]),
         shape: Beam, round: true, size_m: (0.4, 0.4, 1.0), fill: 0.785, joints: [Lashed, Stacked], knowledge: "pit_house", build: (hours: 1.0),
         inputs: [(item: Form(form: "log_section"), amount: 1)], action: "lay a log across", mets: 6.0,
         notes: "A trunk laid across from post to post: a ridge, a lintel, a cap over a tunnel."),
        // ---- Timber framing (V2-12): the farmers' longhouses ----
        (id: "hewn_post", status: Implemented, name: "{material} hewn post", materials: (categories: [Wood]),
         shape: Post, size_m: (0.25, 1.0, 0.25), joints: [MortiseTenon, Pegged, Stacked], knowledge: "timber_frame", build: (hours: 3.0),
         inputs: [(item: Form(form: "log_section"), amount: 1)], action: "hew a post square and set it", mets: 5.5,
         notes: "A log hewn square with the adze and set in a post-hole: the longhouses' rows of posts."),
        (id: "hewn_beam", status: Implemented, name: "{material} hewn beam", materials: (categories: [Wood]),
         shape: Beam, size_m: (0.25, 0.25, 1.0), joints: [MortiseTenon, Pegged, Stacked], knowledge: "timber_frame", build: (hours: 3.0),
         inputs: [(item: Form(form: "log_section"), amount: 1)], action: "hew a beam and peg it across", mets: 5.5,
         notes: "A hewn beam pegged into the posts' tenons: a wall plate, a tie beam, a ridge."),
        (id: "plank_wall", status: Implemented, name: "{material} plank wall", materials: (categories: [Wood]),
         shape: Panel, size_m: (1.0, 1.0, 0.04), joints: [Pegged, Stacked], knowledge: "timber_frame", build: (hours: 1.5),
         inputs: [(item: Form(form: "plank"), amount: 4)], action: "peg split planks upright",
         insulation_r: 0.25, notes: "Split planks set on edge in a groove and pegged: a tight wall that does not wash away."),
        (id: "plank_floor", status: Implemented, name: "{material} plank floor", materials: (categories: [Wood]),
         shape: Layer, size_m: (1.0, 0.04, 1.0), joints: [Pegged, Stacked], knowledge: "timber_frame", build: (hours: 1.0),
         inputs: [(item: Form(form: "plank"), amount: 4)], action: "lay split planks as a floor",
         insulation_r: 0.2, notes: "Planks laid over joists: a dry floor off the damp ground."),
        // ---- Stone ----
        (id: "dry_stone", status: Implemented, name: "{material} dry-stone wall", materials: (categories: [Rock]),
         shape: Wall, size_m: (1.0, 1.0, 0.5), fill: 0.75, joints: [Stacked], build: (hours: 2.0),
         inputs: [(item: Form(form: "fieldstone"), amount: 36)], action: "lay a course of stones",
         insulation_r: 0.3, notes: "Stones laid without mortar, each on two below; a ton to the cubic metre and a half."),
        (id: "stone_lintel", status: Implemented, name: "{material} lintel", materials: (categories: [Rock]),
         shape: Beam, size_m: (0.3, 0.2, 1.0), joints: [Stacked], build: (hours: 0.5),
         inputs: [(item: Form(form: "slab"), amount: 1)], action: "lay a slab across",
         notes: "Stone is strong pressed but weak bent: a slab spans little."),
    ],
)
