// Item forms: every form × matching material is an item, with mass = size × fill × density and
// properties read from the material. `gatherable` forms of natural materials can be picked up
// in the world.
(
    schema: 1,
    entries: [
        (
            id: "cobble", name: "{material} cobble", materials: (categories: [Rock]),
            size_m: (0.12, 0.09, 0.07), fill: 0.55, footprint: (1, 1),
            properties: [(name: "hard_hammer", value: FromMaterial(field: "hardness_mohs", scale: 0.1))],
            tags: ["gatherable", "stone", "throwable"],
        ),
        (
            id: "core", name: "{material} core", materials: (tags: ["knappable"]),
            size_m: (0.09, 0.07, 0.05), fill: 0.55, footprint: (1, 1),
            properties: [
                (name: "knappable", value: FromMaterial(field: "knapping", scale: 1.0)),
                (name: "hard_hammer", value: FromMaterial(field: "hardness_mohs", scale: 0.08)),
            ],
            tags: ["stone"],
        ),
        (
            id: "flake", name: "{material} flake", materials: (tags: ["knappable"]),
            size_m: (0.06, 0.04, 0.008), fill: 0.45, footprint: (1, 1), stacking: Count(8),
            properties: [(name: "sharp_edge", value: FromMaterial(field: "knapping", scale: 1.0))],
            tags: ["cutting"],
        ),
        (
            id: "chopper", name: "{material} chopper", materials: (tags: ["knappable"]),
            size_m: (0.10, 0.08, 0.06), fill: 0.55, footprint: (1, 1),
            properties: [
                (name: "sharp_edge", value: FromMaterial(field: "knapping", scale: 0.5)),
                (name: "chopping", value: FromMaterial(field: "knapping", scale: 0.6)),
                (name: "hard_hammer", value: FromMaterial(field: "hardness_mohs", scale: 0.08)),
            ],
            tags: ["tool"],
        ),
        (
            id: "hand_axe", name: "{material} hand axe", materials: (tags: ["knappable"]),
            size_m: (0.15, 0.09, 0.04), fill: 0.5, footprint: (1, 2),
            properties: [
                (name: "sharp_edge", value: FromMaterial(field: "knapping", scale: 0.75)),
                (name: "chopping", value: FromMaterial(field: "knapping", scale: 0.9)),
                (name: "scraping", value: FromMaterial(field: "knapping", scale: 0.6)),
            ],
            tags: ["tool"],
        ),
        (
            id: "scraper", name: "{material} scraper", materials: (tags: ["knappable"]),
            size_m: (0.05, 0.04, 0.012), fill: 0.5, footprint: (1, 1),
            properties: [(name: "scraping", value: FromMaterial(field: "knapping", scale: 0.9))],
            tags: ["tool"],
        ),
        (
            id: "point", name: "{material} point", materials: (tags: ["knappable"]),
            size_m: (0.07, 0.035, 0.008), fill: 0.45, footprint: (1, 1),
            properties: [(name: "piercing", value: FromMaterial(field: "knapping", scale: 0.9))],
            tags: ["projectile_tip"],
        ),
        (
            id: "anvil_stone", name: "{material} anvil stone", materials: (categories: [Rock], exclude_tags: ["soft_stone", "brittle"]),
            size_m: (0.35, 0.25, 0.12), fill: 0.7, footprint: (2, 2),
            properties: [(name: "anvil", value: Const(1.0))],
            tags: ["gatherable", "stone", "heavy"],
        ),
        (
            id: "stick", name: "{material} stick", materials: (categories: [Wood]),
            size_m: (1.0, 0.025, 0.025), fill: 0.78, footprint: (1, 3),
            tags: ["gatherable", "wood"],
        ),
        (
            id: "pole", name: "{material} pole", materials: (categories: [Wood]),
            size_m: (2.2, 0.04, 0.04), fill: 0.78, footprint: (1, 4),
            tags: ["gatherable", "wood"],
            notes: "Deadfall or storm-broken saplings; cutting live ones needs a chopping tool.",
        ),
        (
            id: "twig", name: "{material} twig", materials: (categories: [Wood]),
            size_m: (0.3, 0.006, 0.006), fill: 0.78, footprint: (1, 1), stacking: Count(10),
            properties: [(name: "probe", value: Const(1.0))],
            tags: ["gatherable", "wood"],
        ),
        (
            id: "digging_stick", name: "{material} digging stick", materials: (categories: [Wood]),
            size_m: (1.1, 0.03, 0.03), fill: 0.75, footprint: (1, 3),
            properties: [(name: "digging", value: FromMaterial(field: "density_kg_m3", scale: 0.0008))],
            tags: ["tool"],
        ),
        (
            id: "wooden_spear", name: "{material} spear", materials: (categories: [Wood]),
            size_m: (2.2, 0.035, 0.035), fill: 0.72, footprint: (1, 4),
            properties: [(name: "piercing", value: Const(0.4)), (name: "reach_m", value: Const(2.2))],
            tags: ["weapon"],
        ),
        (
            id: "fire_hardened_spear", name: "fire-hardened {material} spear", materials: (categories: [Wood]),
            size_m: (2.2, 0.035, 0.035), fill: 0.72, footprint: (1, 4),
            properties: [(name: "piercing", value: Const(0.55)), (name: "reach_m", value: Const(2.2))],
            tags: ["weapon"],
        ),
        (
            id: "cord", name: "{material} cord", materials: (categories: [PlantFibre, AnimalFibre]),
            size_m: (1.0, 0.003, 0.003), fill: 0.8, footprint: (1, 1), stacking: Count(10),
            properties: [(name: "binding", value: FromMaterial(field: "tensile_mpa", scale: 0.001))],
            tags: ["binding"],
        ),
    ],
)
