// Injuries (v2 §9.6), healing at their real rates (E §4.2): heal times are for uncomplicated
// cases with basic care.
(
    schema: 1,
    entries: [
        (id: "blister", status: Implemented, name: "Blister", regions: [Hand, Foot], pain: 0.15, infection_risk: 0.02,
         heal: (hours: 72), effects: ["grip_pain"], treatments: ["rest", "clean_water", "bandage"]),
        (id: "cut", status: Implemented, name: "Cut", regions: [Hand, LowerArm, UpperArm, LowerLeg, UpperLeg, Foot, Head],
         bleeding_ml_per_min: (1, 10), pain: 0.25, infection_risk: 0.08,
         heal: (hours: 168), effects: ["bleeding"], treatments: ["pressure", "clean_water", "bandage", "honey", "resin"]),
        (id: "deep_wound", status: Implemented, name: "Deep wound", regions: [Chest, Abdomen, UpperArm, UpperLeg, LowerLeg],
         bleeding_ml_per_min: (20, 200), pain: 0.7, infection_risk: 0.3,
         heal: (hours: 1000), effects: ["bleeding", "weakness", "slow_walk"], treatments: ["pressure", "elevation", "clean_water", "bandage", "rest"]),
        (id: "puncture", status: Implemented, name: "Puncture", regions: [Hand, Foot, LowerLeg, Chest, Abdomen],
         bleeding_ml_per_min: (2, 40), pain: 0.45, infection_risk: 0.35,
         heal: (hours: 336), effects: ["bleeding"], treatments: ["clean_water", "bandage", "rest"]),
        (id: "bite", status: Implemented, name: "Bite", regions: [Hand, LowerArm, UpperArm, LowerLeg, UpperLeg, Neck],
         bleeding_ml_per_min: (5, 150), pain: 0.6, infection_risk: 0.4,
         heal: (hours: 500), effects: ["bleeding", "weakness"], treatments: ["pressure", "clean_water", "bandage", "rest"]),
        (id: "bruise", status: Implemented, name: "Bruise", regions: [Head, Chest, Abdomen, UpperArm, LowerArm, UpperLeg, LowerLeg],
         pain: 0.2, heal: (hours: 240), effects: ["stiffness"], treatments: ["rest", "cold"]),
        (id: "sprain", status: Implemented, name: "Sprained ankle", regions: [Foot],
         pain: 0.45, heal: (hours: 96), effects: ["slow_walk", "no_sprint"], treatments: ["rest", "cold", "elevation", "binding"],
         notes: "A mild to moderate sprain; severe ones take weeks."),
        (id: "fracture", status: Implemented, name: "Fracture", regions: [LowerArm, UpperArm, LowerLeg, UpperLeg, Hand, Foot],
         pain: 0.85, heal: (hours: 1000),
         effects: ["no_use_of_limb", "slow_walk", "no_two_hands"], treatments: ["splint", "rest", "food", "warmth"],
         notes: "A closed fracture: about six weeks for a bone to knit well enough to use. An open one is a fracture and a deep wound."),
        (id: "burn", status: Implemented, name: "Burn", regions: [Hand, LowerArm, Foot, Head, Chest],
         pain: 0.6, infection_risk: 0.2, heal: (hours: 336), effects: ["grip_pain"], treatments: ["cool_water", "clean_water", "bandage", "honey"]),
        (id: "frostbite", status: Implemented, name: "Frostbite", regions: [Hand, Foot, Head],
         pain: 0.4, infection_risk: 0.15, heal: (hours: 700), effects: ["numbness", "clumsiness"], treatments: ["warm_water", "rest", "shelter"]),
    ],
)
