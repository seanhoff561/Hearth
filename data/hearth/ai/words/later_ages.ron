// Words no one in the world may say (V2.1 §10.4 and §1; H10): things of later ages that are no
// technique of the graph (writing, money, kings, machines, the words of our own day and of those
// who study the past), and words a phrased line may never hold whatever its speaker knows. The
// filter rejects a line holding any of them, naming the word; it rejects any other word not on
// its speaker's lists as well — these lists say why.
(
    schema: 1,
    entries: [
        (
            id: "later_ages",
            name: "Things of later ages",
            kind: LaterAges,
            status: Implemented,
            words: [
                // Machines and the like.
                "phone", "telephone", "smartphone", "computer", "internet", "email", "radio",
                "television", "camera", "photograph", "photo", "video", "film", "movie",
