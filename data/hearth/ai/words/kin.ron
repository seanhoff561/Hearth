// Kin words (V2.1 §10.4; H10): a phrased line names kin only as its speaker has them — "my
// sister" from one who has a sister, "your father" from the listener's father — and speaks of
// kin in general freely ("a mother", "like a brother").
(
    schema: 1,
    entries: [
        (
            id: "kin",
            name: "Kin",
            kind: Kin,
            status: Implemented,
            words: [
                "mother", "father", "parent", "brother", "sister", "sibling", "half-sister",
                "half-brother", "son", "daughter", "grandmother", "grandfather", "grandparent", "grandson",
                "granddaughter", "grandchild", "grandchildren", "husband", "wife", "wives",
                "partner", "mate", "aunt", "uncle", "cousin", "nephew", "niece", "stepmother",
                "stepfather", "stepson", "stepdaughter", "mother-in-law", "father-in-law",
                "son-in-law", "daughter-in-law", "brother-in-law", "sister-in-law",
            ],
        ),
    ],
)
