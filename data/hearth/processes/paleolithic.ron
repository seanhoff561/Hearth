// Era 0–2 seed processes. Durations are real-world times of skilled people; the day scale
// compresses them (a 15-minute task ≈ 30 s of play at the default day length).
(
    schema: 1,
    entries: [
        (
            id: "test_nodule", name: "Test a stone", action: "strike to test",
            inputs: [(item: Form(form: "cobble", materials: (tags: ["knappable"])), amount: 1)],
            tools: [(property: "hard_hammer", min: 0.4)],
            duration: (hours: 0.02), knowledge: "stone_as_hammer", skill: "knapping",
            outputs: [(item: Form(form: "core"), amount: (1, 1))],
            failures: [(chance: 0.3, min_chance: 0.05, outcome: "The stone shatters along hidden cracks.")],
        ),
        (
            id: "strike_flake", name: "Strike off a flake", action: "strike off a flake",
            inputs: [(item: Form(form: "core"), amount: 1, consumed: false)],
            tools: [(property: "hard_hammer", min: 0.5)],
            duration: (hours: 0.03), knowledge: "sharp_flake", skill: "knapping",
            outputs: [(item: Form(form: "flake"), amount: (1, 3), quality: (base: 0.2, from_skill: 0.5, from_material: 0.3))],
            failures: [
                (chance: 0.45, min_chance: 0.1, outcome: "The blow crushes the edge; nothing usable comes off.", loses_inputs: false),
                (chance: 0.05, min_chance: 0.01, outcome: "A sliver cuts your fingers.", loses_inputs: false, injury: "cut"),
            ],
        ),
        (
            id: "make_chopper", name: "Knap a chopper", action: "knock an edge onto the cobble",
            inputs: [(item: Form(form: "cobble", materials: (tags: ["knappable"])), amount: 1)],
            tools: [(property: "hard_hammer", min: 0.5)],
            duration: (hours: 0.1), knowledge: "chopper", skill: "knapping",
            outputs: [(item: Form(form: "chopper"), amount: (1, 1), quality: (base: 0.3, from_skill: 0.4, from_material: 0.3))],
            byproducts: [(item: Form(form: "flake"), amount: (2, 5))],
            failures: [(chance: 0.3, min_chance: 0.05, outcome: "The cobble splits in two.")],
        ),
        (
            id: "make_hand_axe", name: "Shape a hand axe", action: "thin and shape both faces",
            inputs: [(item: Form(form: "core"), amount: 1)],
            tools: [(property: "hard_hammer", min: 0.5)],
            duration: (hours: 0.75), knowledge: "hand_axe", skill: "knapping",
            outputs: [(item: Form(form: "hand_axe"), amount: (1, 1), quality: (base: 0.1, from_skill: 0.6, from_material: 0.3))],
            byproducts: [(item: Form(form: "flake"), amount: (5, 20))],
            failures: [(chance: 0.6, min_chance: 0.1, outcome: "The piece snaps across its width.")],
        ),
        (
            id: "make_scraper", name: "Retouch a scraper", action: "retouch the edge into a scraper",
            inputs: [(item: Form(form: "flake"), amount: 1)],
            tools: [(property: "hard_hammer", min: 0.3)],
            duration: (hours: 0.1), knowledge: "scraper", skill: "knapping",
            outputs: [(item: Form(form: "scraper"), amount: (1, 1))],
            failures: [(chance: 0.3, min_chance: 0.05, outcome: "The flake breaks.")],
        ),
        (
            id: "crack_nuts", name: "Crack nuts", action: "crack nuts on the anvil",
            inputs: [
                (item: Material("hazelnut"), amount: 0.5),
                (item: Form(form: "anvil_stone"), amount: 1, consumed: false),
            ],
            tools: [(property: "hard_hammer", min: 0.3)],
            duration: (hours: 0.25), knowledge: "nut_cracking",
            outputs: [(item: Material("nut_kernel"), amount: (0.18, 0.22))],
        ),
        (
            id: "sharpen_digging_stick", name: "Sharpen a digging stick", action: "shave a point onto the stick",
            inputs: [(item: Form(form: "stick"), amount: 1)],
            tools: [(property: "sharp_edge", min: 0.3)],
            duration: (hours: 0.25), knowledge: "digging_stick", skill: "woodworking",
            outputs: [(item: Form(form: "digging_stick"), amount: (1, 1))],
        ),
        (
            id: "whittle_spear", name: "Whittle a spear", action: "shave the pole to a point",
            inputs: [(item: Form(form: "pole"), amount: 1)],
            tools: [(property: "sharp_edge", min: 0.3)],
            duration: (hours: 3.0), knowledge: "wooden_spear", skill: "woodworking",
            outputs: [(item: Form(form: "wooden_spear"), amount: (1, 1))],
        ),
        (
            id: "fire_harden_spear", name: "Fire-harden a spear", action: "turn the point in the embers",
            inputs: [(item: Form(form: "wooden_spear"), amount: 1)],
            station: "campfire", conditions: [HeatAtLeastC(300)],
            duration: (hours: 0.5), knowledge: "fire_hardening",
            outputs: [(item: Form(form: "fire_hardened_spear"), amount: (1, 1))],
            failures: [(chance: 0.2, min_chance: 0.03, outcome: "The point chars through and splits.")],
        ),
        (
            id: "butcher_small_game", name: "Butcher small game", action: "skin and joint the carcass",
            inputs: [(item: Tag("carcass"), amount: 1)],
            tools: [(property: "sharp_edge", min: 0.5)],
            duration: (hours: 1.0), knowledge: "butchery", skill: "butchery",
            outputs: [
                (item: Material("meat"), amount: (5, 8)),
                (item: Material("rawhide"), amount: (0.8, 1.5)),
                (item: Material("bone"), amount: (1.5, 2.5)),
            ],
            byproducts: [
                (item: Material("animal_fat"), amount: (0.2, 1.0)),
                (item: Material("sinew"), amount: (0.05, 0.15)),
            ],
        ),
        (
            id: "crack_bones", name: "Crack bones for marrow", action: "split the long bones",
            inputs: [
                (item: Material("bone"), amount: 1.0),
                (item: Form(form: "anvil_stone"), amount: 1, consumed: false),
            ],
            tools: [(property: "hard_hammer", min: 0.5)],
            duration: (hours: 0.2), knowledge: "marrow_extraction",
            outputs: [(item: Material("marrow"), amount: (0.05, 0.15))],
        ),
        (
            id: "take_wildfire_ember", name: "Take an ember from a wildfire", action: "carry off a glowing ember",
            inputs: [(item: Material("tinder_fungus"), amount: 0.05)],
            conditions: [Near("wildfire")],
            duration: (hours: 0.1), knowledge: "fire_keeping",
            outputs: [(item: Material("ember"), amount: (0.01, 0.02))],
        ),
        (
            id: "hand_drill_fire", name: "Drill fire by hand", action: "spin the drill between your palms",
            inputs: [
                (item: Form(form: "stick"), amount: 2),
                (item: Material("dry_grass"), amount: 0.1),
            ],
            conditions: [Dry], duration: (hours: 0.2), knowledge: "fire_by_friction_hand_drill", skill: "firemaking",
            outputs: [(item: Material("ember"), amount: (0.01, 0.01))],
            failures: [(chance: 0.7, min_chance: 0.15, outcome: "Smoke, a blister, but no ember.", loses_inputs: false, injury: "blister")],
        ),
        (
            id: "roast_meat", name: "Roast meat", action: "roast over the coals",
            inputs: [(item: Material("meat"), amount: 0.5)],
            station: "campfire", conditions: [HeatAtLeastC(200)],
            duration: (hours: 0.5), knowledge: "cooking_roasting", skill: "cooking",
            outputs: [(item: Material("cooked_meat"), amount: (0.35, 0.45))],
            failures: [(chance: 0.15, min_chance: 0.02, outcome: "Burned on the outside, raw inside.", loses_inputs: false)],
        ),
        (
            id: "cook_greens", name: "Cook greens", action: "wilt the leaves on a hot stone",
            inputs: [(item: Material("nettle_leaves"), amount: 0.2)],
            station: "campfire", duration: (hours: 0.1), knowledge: "cooking_roasting",
            outputs: [(item: Material("cooked_greens"), amount: (0.15, 0.18))],
        ),
        (
            id: "scrape_hide", name: "Scrape a hide", action: "scrape the flesh side clean",
            inputs: [(item: Material("rawhide"), amount: 1.0)],
            tools: [(property: "scraping", min: 0.4)],
            duration: (hours: 3.0), knowledge: "hide_scraping", skill: "hideworking",
            outputs: [(item: Material("scraped_hide"), amount: (0.8, 0.9))],
        ),
        (
            id: "cook_birch_tar", name: "Make birch tar", action: "smoulder birch bark under ash",
            inputs: [(item: Material("birch_bark"), amount: 1.0)],
            station: "campfire", conditions: [HeatAtLeastC(340)],
            duration: (hours: 3.0), knowledge: "birch_tar", skill: "firemaking",
            outputs: [(item: Material("birch_tar"), amount: (0.02, 0.08))],
            failures: [(chance: 0.5, min_chance: 0.1, outcome: "The bark flares up and burns away.")],
        ),
        (
            id: "twist_cord", name: "Twist cord", action: "roll fibres into a two-ply cord",
            inputs: [(item: Material("nettle_fibre"), amount: 0.01)],
            duration: (hours: 0.5), knowledge: "cordage_basic", skill: "fibrework",
            outputs: [(item: Form(form: "cord", materials: (ids: ["nettle_fibre"])), amount: (1, 1))],
        ),
        (
            id: "leach_acorns", name: "Leach acorns", action: "crush and soak the acorns in running water",
            inputs: [(item: Material("acorn"), amount: 1.0)],
            conditions: [Water], duration: (hours: 24.0), knowledge: "leaching_bitter_foods",
            outputs: [(item: Material("leached_acorn_meal"), amount: (0.6, 0.7))],
        ),
        (
            id: "grind_seeds", name: "Grind seeds", action: "grind the seeds on a flat stone",
            inputs: [
                (item: Material("grass_seed"), amount: 0.5),
                (item: Form(form: "anvil_stone"), amount: 1, consumed: false),
            ],
            tools: [(property: "hard_hammer", min: 0.3)],
            duration: (hours: 1.0), knowledge: "grinding_seeds",
            outputs: [(item: Material("seed_meal"), amount: (0.4, 0.45))],
        ),
        (
            id: "dry_meat", name: "Dry meat", action: "hang thin strips on the rack",
            inputs: [(item: Material("meat"), amount: 1.0)],
            station: "drying_rack", conditions: [Dry], duration: (hours: 72.0), knowledge: "drying_and_smoking",
            outputs: [(item: Material("dried_meat"), amount: (0.3, 0.4))],
            failures: [(chance: 0.2, min_chance: 0.05, outcome: "Flies and damp spoil the batch.")],
        ),
    ],
)
