// Rock types. Physical properties live on the material; this adds the geology: class, grain,
// what the rock weathers to and how groundwater moves through it (the shape of the water
// table: tight rock carries it up under the hills, karst drains it to the valley floors).
(
    schema: 1,
    entries: [
        (id: "granite", status: Implemented, name: "granite", material: "granite", class: IgneousIntrusive, grain: Coarse, weathers_to: ["quartz_sand", "kaolin", "clay_loam"], permeability: Tight),
        (id: "gneiss", status: Implemented, name: "gneiss", material: "gneiss", class: Metamorphic, grain: Coarse, weathers_to: ["quartz_sand", "clay_loam"], permeability: Tight),
        (id: "schist", status: Implemented, name: "schist", material: "schist", class: Metamorphic, grain: Medium, weathers_to: ["clay_loam"], permeability: Poor),
