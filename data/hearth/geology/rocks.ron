        (id: "marble", status: Implemented, name: "marble", material: "marble", class: Metamorphic, grain: Medium, weathers_to: ["loam"], permeability: Karst),
        (id: "quartzite", status: Implemented, name: "quartzite", material: "quartzite", class: Metamorphic, grain: Medium, weathers_to: ["quartz_sand"], permeability: Fair),
        (id: "basalt", status: Implemented, name: "basalt", material: "basalt", class: IgneousExtrusive, grain: Fine, weathers_to: ["clay_loam", "black_sand"], permeability: Good),
