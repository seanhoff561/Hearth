// Minerals with what can be won from them and how they show at the surface.
(
    schema: 1,
    entries: [
        (id: "flint", name: "flint", material: "flint", formula: "SiO₂ (microcrystalline)",
         indicators: ["grey-black nodules with a white crust in chalk cliffs and the streams below them"]),
        (id: "pyrite", name: "pyrite", material: "pyrite", formula: "FeS₂",
         indicators: ["brassy cubes and nodules in shale and chalk", "rusty stains where it weathers"]),
        (id: "hematite", name: "hematite", material: "hematite", formula: "Fe₂O₃",
         indicators: ["red earth that stains the fingers", "heavy dark stones with a red streak"]),
        (id: "goethite", name: "goethite", material: "goethite", formula: "FeO(OH)", indicators: ["yellow-brown earthy crusts"]),
        (id: "magnetite", name: "magnetite", material: "magnetite", formula: "Fe₃O₄", indicators: ["heavy black grains that cling together in pan concentrates"]),
        (id: "bog_iron", name: "bog iron", material: "bog_iron", indicators: ["rusty scum and orange sheen on bog pools", "lumpy brown crusts under peat"]),
        (id: "malachite", name: "malachite", material: "malachite", formula: "Cu₂CO₃(OH)₂", yields: [(material: "native_copper", fraction: 0.57)],
         indicators: ["bright green stains on outcrops"]),
        (id: "azurite", name: "azurite", material: "azurite", formula: "Cu₃(CO₃)₂(OH)₂", yields: [(material: "native_copper", fraction: 0.55)],
         indicators: ["deep blue crystals and stains beside green ones"]),
        (id: "cuprite", name: "cuprite", material: "cuprite", formula: "Cu₂O", yields: [(material: "native_copper", fraction: 0.89)]),
        (id: "chalcopyrite", name: "chalcopyrite", material: "chalcopyrite", formula: "CuFeS₂", yields: [(material: "native_copper", fraction: 0.35)],
         indicators: ["rusty gossan caps over sulfide veins"]),
        (id: "native_copper", name: "native copper", material: "native_copper", formula: "Cu", yields: [(material: "native_copper", fraction: 1.0)],
         indicators: ["green-coated heavy nuggets in basalt and glacial drift"]),
        (id: "cassiterite", name: "cassiterite", material: "cassiterite", formula: "SnO₂", indicators: ["heavy dark grains in stream gravels near granite"]),
        (id: "galena", name: "galena", material: "galena", formula: "PbS", yields: [(material: "native_silver", fraction: 0.002)],
         indicators: ["heavy grey cubes that break into smaller cubes"]),
        (id: "sphalerite", name: "sphalerite", material: "sphalerite", formula: "ZnS"),
        (id: "native_gold", name: "native gold", material: "native_gold", formula: "Au", yields: [(material: "native_gold", fraction: 1.0)],
         indicators: ["flecks of yellow metal in the bottom of a pan", "gold in white quartz veins"]),
        (id: "native_silver", name: "native silver", material: "native_silver", formula: "Ag", yields: [(material: "native_silver", fraction: 1.0)]),
        (id: "cinnabar", name: "cinnabar", material: "cinnabar", formula: "HgS", indicators: ["vermilion crusts near hot springs"]),
        (id: "halite", name: "rock salt", material: "halite", formula: "NaCl", indicators: ["salt crusts on dry lake beds", "salty springs"]),
        (id: "gypsum", name: "gypsum", material: "gypsum", formula: "CaSO₄·2H₂O"),
        (id: "sulfur", name: "sulfur", material: "sulfur", formula: "S", indicators: ["yellow crusts and rotten-egg smell at fumaroles"]),
        (id: "niter", name: "niter", material: "niter", formula: "KNO₃", indicators: ["white efflorescence on cave walls and in dry soils"]),
        (id: "quartz", name: "quartz", material: "quartz", formula: "SiO₂"),
        (id: "garnet", name: "garnet", material: "garnet"),
        (id: "diamond", name: "diamond", material: "diamond", formula: "C", indicators: ["kimberlite pipes: blue ground weathering to yellow"]),
        (id: "red_ochre", name: "red ochre", material: "red_ochre", indicators: ["red earth banks"]),
        (id: "yellow_ochre", name: "yellow ochre", material: "yellow_ochre", indicators: ["yellow earth banks and seeps"]),
    ],
)
