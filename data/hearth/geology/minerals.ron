// Minerals with what can be won from them and how they show at the surface.
(
    schema: 1,
    entries: [
        (id: "flint", status: Implemented, name: "flint", material: "flint", formula: "SiO₂ (microcrystalline)",
         indicators: ["grey-black nodules with a white crust in chalk cliffs and the streams below them"]),
        (id: "pyrite", status: Implemented, name: "pyrite", material: "pyrite", formula: "FeS₂",
         indicators: ["brassy cubes and nodules in shale and chalk", "rusty stains where it weathers"]),
        (id: "hematite", status: Implemented, name: "hematite", material: "hematite", formula: "Fe₂O₃", yields: [(material: "iron", fraction: 0.70)],
         indicators: ["red earth that stains the fingers", "heavy dark stones with a red streak"]),
        (id: "goethite", status: Implemented, name: "goethite", material: "goethite", formula: "FeO(OH)", yields: [(material: "iron", fraction: 0.63)], indicators: ["yellow-brown earthy crusts"]),
        (id: "magnetite", status: Implemented, name: "magnetite", material: "magnetite", formula: "Fe₃O₄", yields: [(material: "iron", fraction: 0.72)], indicators: ["heavy black grains that cling together in pan concentrates"]),
        (id: "bog_iron", status: Implemented, name: "bog iron", material: "bog_iron", yields: [(material: "iron", fraction: 0.45)], indicators: ["rusty scum and orange sheen on bog pools", "lumpy brown crusts under peat"]),
        (id: "malachite", status: Implemented, name: "malachite", material: "malachite", formula: "Cu₂CO₃(OH)₂", yields: [(material: "native_copper", fraction: 0.57)],
         indicators: ["bright green stains on outcrops"]),
        (id: "azurite", status: Implemented, name: "azurite", material: "azurite", formula: "Cu₃(CO₃)₂(OH)₂", yields: [(material: "native_copper", fraction: 0.55)],
         indicators: ["deep blue crystals and stains beside green ones"]),
        (id: "cuprite", status: Implemented, name: "cuprite", material: "cuprite", formula: "Cu₂O", yields: [(material: "native_copper", fraction: 0.89)]),
        (id: "chalcopyrite", status: Implemented, name: "chalcopyrite", material: "chalcopyrite", formula: "CuFeS₂", yields: [(material: "native_copper", fraction: 0.35)],
         indicators: ["rusty gossan caps over sulfide veins"]),
        (id: "native_copper", status: Implemented, name: "native copper", material: "native_copper", formula: "Cu", yields: [(material: "native_copper", fraction: 1.0)],
         indicators: ["green-coated heavy nuggets in basalt and glacial drift"]),
        (id: "cassiterite", status: Implemented, name: "cassiterite", material: "cassiterite", formula: "SnO₂", yields: [(material: "tin", fraction: 0.79)], indicators: ["heavy dark grains in stream gravels near granite"]),
        (id: "galena", status: Implemented, name: "galena", material: "galena", formula: "PbS", yields: [(material: "lead", fraction: 0.87), (material: "native_silver", fraction: 0.002)],
         indicators: ["heavy grey cubes that break into smaller cubes"]),
        (id: "sphalerite", status: Implemented, name: "sphalerite", material: "sphalerite", formula: "ZnS", yields: [(material: "zinc", fraction: 0.67)]),
        (id: "native_gold", status: Implemented, name: "native gold", material: "native_gold", formula: "Au", yields: [(material: "native_gold", fraction: 1.0)],
         indicators: ["flecks of yellow metal in the bottom of a pan", "gold in white quartz veins"]),
        (id: "native_silver", status: Implemented, name: "native silver", material: "native_silver", formula: "Ag", yields: [(material: "native_silver", fraction: 1.0)]),
        (id: "cinnabar", status: Implemented, name: "cinnabar", material: "cinnabar", formula: "HgS", yields: [(material: "mercury", fraction: 0.86)], indicators: ["vermilion crusts near hot springs"]),
        (id: "halite", name: "rock salt", material: "halite", formula: "NaCl", indicators: ["salt crusts on dry lake beds", "salty springs"]),
        (id: "gypsum", name: "gypsum", material: "gypsum", formula: "CaSO₄·2H₂O"),
        (id: "sulfur", status: Implemented, name: "sulfur", material: "sulfur", formula: "S", indicators: ["yellow crusts and rotten-egg smell at fumaroles"]),
        (id: "niter", status: Implemented, name: "niter", material: "niter", formula: "KNO₃", indicators: ["white efflorescence on cave walls and in dry soils"]),
        (id: "quartz", status: Implemented, name: "quartz", material: "quartz", formula: "SiO₂"),
        (id: "garnet", status: Implemented, name: "garnet", material: "garnet"),
        (id: "diamond", name: "diamond", material: "diamond", formula: "C", indicators: ["kimberlite pipes: blue ground weathering to yellow"]),
        (id: "red_ochre", status: Implemented, name: "red ochre", material: "red_ochre", indicators: ["red earth banks"]),
        (id: "yellow_ochre", status: Implemented, name: "yellow ochre", material: "yellow_ochre", indicators: ["yellow earth banks and seeps"]),
            (id: "marcasite", status: Implemented, name: "marcasite", material: "marcasite", formula: "FeS₂", indicators: ["pale brassy nodules in chalk that crumble to rust"]),
        (id: "bauxite", status: Implemented, name: "bauxite", material: "bauxite", yields: [(material: "aluminium", fraction: 0.26)], indicators: ["pale red pisolitic crusts on tropical plateaus"]),
        (id: "manganese_oxide", status: Implemented, name: "manganese oxide", material: "manganese_oxide", formula: "MnO₂", indicators: ["sooty black coatings and dendrites"]),
        (id: "gossan", status: Implemented, name: "gossan", material: "gossan", indicators: ["rusty spongy caps over buried sulfides"]),
],
)
