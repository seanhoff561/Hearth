// The game modes (Amendment P §2): each sets every world rule Create World used to ask one by
// one. The underlying settings stay in the code for tuning and tests; the player chooses a mode.
(
    schema: 1,
    entries: [
        (
            id: "realistic",
            name: "Realistic",
            summary: "Life as it really is. Real needs, real dangers, real time. You only know what you learn, and when you die, a new life begins knowing nothing.",
            order: 2,
            strictness: 2,
            realism: "authentic",
            knowledge: "discovery",
            after_death: "theirs_only",
            predators: "authentic",
            hints: false,
            clock: "none",
            observer: false,
            creative: false,
        ),
        (
            id: "easy",
            name: "Easy",
            summary: "The same world, more forgiving. Needs and injuries are gentler, danger is rarer, and the game gives you more hints while you learn.",
            order: 1,
            strictness: 1,
            realism: "hardy",
            knowledge: "guided",
            after_death: "keep_everything",
            predators: "tranquil",
            hints: true,
            clock: "optional",
            observer: false,
            creative: false,
        ),
        (
            id: "creative",
            name: "Creative",
            summary: "Build, explore and experiment freely. You can't be hurt, can fly, can place or summon anything, and can control time and weather.",
            order: 0,
            strictness: 0,
            realism: "",
            knowledge: "open",
            after_death: "keep_everything",
            predators: "authentic",
            hints: false,
            clock: "exact",
            observer: true,
            creative: true,
        ),
    ],
)
