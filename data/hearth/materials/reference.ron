// Measured ranges for material families (Amendment Q §2.1). Albedo is the diffuse albedo in the
// visible band: the linear luminance a material's base colour (`appearance.color`) must have.
// Roughness (0 a mirror … 1 matte) and translucency (0 opaque … 1) are perceptual estimates.
// `hearth content lint` fails a member whose albedo is outside its family's range and warns on
// roughness. Families with no members yet are references for the renderer (water, canopies,
// grass) and for materials still to be sorted into them.
(
    schema: 1,
    families: [
        (
            id: "snow_fresh",
            name: "fresh snow",
            albedo: (0.80, 0.95),
            roughness: (0.55, 1.0),
            ior: 1.31,
            translucency: (0.3, 0.6),
            members: ["snow"],
            source: "Warren 1982, Optical properties of snow, Rev. Geophys. 20: 67-89",
        ),
        (
            id: "snow_old",
            name: "old and melting snow",
            albedo: (0.40, 0.70),
            roughness: (0.4, 1.0),
            ior: 1.31,
            translucency: (0.2, 0.5),
            source: "Cuffey and Paterson 2010, The Physics of Glaciers, table 5.2",
        ),
        (
            id: "ice",
            name: "lake and glacier ice",
            albedo: (0.15, 0.60),
            roughness: (0.05, 0.4),
            ior: 1.31,
            translucency: (0.5, 0.9),
            members: ["ice"],
            source: "Cuffey and Paterson 2010, table 5.2 (clean ice 0.34-0.51, dirty 0.15-0.25); white lake ice to 0.6",
        ),
        (
            id: "sand",
            name: "dry quartz and carbonate sand",
            albedo: (0.25, 0.60),
            roughness: (0.8, 1.0),
            ior: 1.54,
            translucency: (0.0, 0.05),
            members: ["quartz_sand", "red_sand", "shell_sand", "bleached_sand"],
            source: "Oke 1987, Boundary Layer Climates, table 1.1 (dry sand 0.35-0.45); white sands to 0.6",
        ),
        (
            id: "sand_dark",
            name: "black volcanic sand",
            albedo: (0.05, 0.12),
            roughness: (0.8, 1.0),
            ior: 1.6,
            translucency: (0.0, 0.0),
            members: ["black_sand"],
            source: "USGS Spectral Library v7 (Kokaly et al. 2017), basaltic sands",
            uncertain: true,
        ),
        (
            id: "soil",
            name: "mineral soils, moist to dry, and peat",
            albedo: (0.04, 0.40),
            roughness: (0.5, 1.0),
            ior: 1.5,
            translucency: (0.0, 0.0),
            members: [
                "alluvium", "chernozem_earth", "clay_loam", "humus", "laterite", "loam", "mud",
                "permafrost", "red_earth", "sandy_loam", "stony_loam", "terra_rossa", "loess", "peat",
            ],
            source: "Oke 1987, table 1.1 (dark wet soil 0.05 to light dry soil 0.40); Post et al. 2000, Soil Sci. Soc. Am. J. 64: 1027-1034",
        ),
        (
            id: "clay",
            name: "clays as dug",
            albedo: (0.10, 0.60),
            roughness: (0.5, 1.0),
            ior: 1.55,
            translucency: (0.0, 0.0),
            members: ["earthenware_clay", "gley", "fire_clay"],
            source: "USGS Spectral Library v7 (illite, montmorillonite and iron-rich clays)",
            uncertain: true,
        ),
        (
            id: "white_minerals",
            name: "white clays and evaporites",
            albedo: (0.55, 0.90),
            roughness: (0.4, 1.0),
            ior: 1.55,
            translucency: (0.0, 0.2),
            members: ["kaolin", "gypsum", "halite", "niter"],
            source: "USGS Spectral Library v7 (kaolinite, gypsum, halite: 0.7-0.9 in the visible)",
        ),
        (
            id: "rock_light",
            name: "chalk, limestone, marble and other light rock",
            albedo: (0.30, 0.85),
            roughness: (0.4, 1.0),
            ior: 1.6,
            translucency: (0.0, 0.1),
            members: ["chalk", "limestone", "dolomite", "marble", "travertine", "quartzite", "pumice"],
            source: "USGS Spectral Library v7; Clark 1999, Spectroscopy of rocks and minerals",
        ),
        (
            id: "rock_mid",
            name: "granite, sandstone and other grey and brown rock",
            albedo: (0.10, 0.45),
            roughness: (0.4, 1.0),
            ior: 1.55,
            translucency: (0.0, 0.02),
            members: [
                "granite", "sandstone", "red_sandstone", "gneiss", "diorite", "rhyolite", "tuff",
                "conglomerate", "breccia", "siltstone", "mudstone", "chert", "andesite", "schist",
                "soapstone", "gravel", "volcanic_ash",
            ],
            source: "USGS Spectral Library v7; Oke 1987 (rock 0.12-0.30)",
        ),
        (
            id: "rock_dark",
            name: "basalt, slate and other dark rock",
            albedo: (0.05, 0.15),
            roughness: (0.3, 1.0),
            ior: 1.6,
            translucency: (0.0, 0.01),
            members: ["basalt", "gabbro", "scoria", "slate", "shale", "kimberlite", "banded_iron", "flint"],
            source: "USGS Spectral Library v7 (basalt about 0.05-0.10); Amendment Q §2.1 (basalt about 0.1)",
        ),
        (
            id: "volcanic_glass",
            name: "obsidian (its diffuse part; the gloss is the specular)",
            albedo: (0.02, 0.06),
            roughness: (0.0, 0.2),
            ior: 1.49,
            translucency: (0.0, 0.1),
            members: ["obsidian"],
            source: "estimate from glassy volcanic rock spectra (USGS Spectral Library v7)",
            uncertain: true,
        ),
        (
            id: "coal_charcoal",
            name: "charcoal, coal and charred wood",
            albedo: (0.03, 0.08),
            roughness: (0.3, 1.0),
            ior: 1.8,
            translucency: (0.0, 0.0),
            members: ["charcoal", "anthracite", "bituminous_coal", "lignite", "charred_wood"],
            source: "Amendment Q §2.1 (charcoal about 0.04); USGS Spectral Library v7 (coals)",
            uncertain: true,
        ),
        (
            id: "bark",
            name: "bark",
            albedo: (0.05, 0.60),
            roughness: (0.6, 1.0),
            ior: 1.5,
            translucency: (0.0, 0.02),
            members: ["oak_bark", "willow_bark", "birch_bark", "cork", "mahogany_bark"],
            source: "estimate: dark ridged barks about 0.08, white birch bark to about 0.6",
            uncertain: true,
        ),
        (
            id: "wood_cut",
            name: "cut and split wood",
            albedo: (0.06, 0.66),
            roughness: (0.4, 0.9),
            ior: 1.5,
            translucency: (0.0, 0.05),
            members: [
                "acacia_wood", "alder_wood", "apple_wood", "arbutus_wood", "ash_wood", "aspen_wood",
                "bamboo", "baobab_wood", "beech_wood", "birch_wood", "brazil_nut_wood", "cacao_wood",
                "carob_wood", "cedar_wood", "cherry_wood", "chestnut_wood", "cypress_wood",
                "durian_wood", "elder_wood", "elm_wood", "fig_wood", "fir_wood", "hawthorn_wood",
                "hazel_wood", "hemlock_wood", "hornbeam_wood", "kapok_wood", "larch_wood",
                "linden_wood", "mahogany_wood", "mangrove_wood", "maple_wood", "marula_wood",
                "meranti_wood", "mesquite_wood", "mopane_wood", "oak_wood", "olive_wood",
                "palm_wood", "pine_wood", "polylepis_wood", "rubber_wood", "saxaul_wood",
                "spruce_wood", "tamarisk_wood", "teak_wood", "walnut_wood", "white_oak_wood",
                "willow_wood", "yew_wood",
            ],
            source: "CIE L* of fresh-cut woods about 30-85 (e.g. Nishino et al. 1998, J. Wood Sci. 44: 3-8), as luminance",
        ),
        (
            id: "grass_green",
            name: "green grass and herbage",
            albedo: (0.15, 0.26),
            roughness: (0.6, 0.9),
            ior: 1.45,
            translucency: (0.2, 0.5),
            source: "Oke 1987, table 1.1 (grass 0.16-0.26)",
        ),
        (
            id: "canopy_deciduous",
            name: "deciduous canopy",
            albedo: (0.15, 0.20),
            roughness: (0.5, 0.8),
            ior: 1.45,
            translucency: (0.2, 0.5),
            source: "Oke 1987, table 1.1 (deciduous forest 0.15-0.20)",
        ),
        (
            id: "canopy_conifer",
            name: "coniferous canopy",
            albedo: (0.05, 0.15),
            roughness: (0.5, 0.8),
            ior: 1.45,
            translucency: (0.1, 0.3),
            source: "Oke 1987, table 1.1 (coniferous forest 0.05-0.15)",
        ),
        (
            id: "water",
            name: "open water (its reflection is the Fresnel term)",
            albedo: (0.02, 0.10),
            roughness: (0.0, 0.2),
            ior: 1.333,
            translucency: (0.8, 1.0),
            source: "Oke 1987, table 1.1 (water 0.03-0.10 at high sun, more at low sun)",
        ),
    ],
    // How natural ground behaves (Amendment S §2.3), the first family matching a material its
    // own. Angle of repose of the loose material, dry and rain-wet (moist grains hold steeper
    // by capillary cohesion; wet clay and loess lose their strength); none: rock, which stands
    // until it breaks. Friction is a shod foot's on the ground, dry, wet and iced. Sharpness is
    // how crisp its surface's edges stand (the mesher's feature solve).
    ground: [
        (id: "snow", name: "snow", matches: (categories: [Snow]), sharpness: 0.0,
         repose_deg: Some((38.0, 30.0)), friction: (0.3, 0.2, 0.1), walk_sound: "snow",
         source: "McClung and Schaerer 2006, The Avalanche Handbook, 3rd ed., ch. 4; ISO 13287 shoe tests on snow"),
        (id: "ice", name: "ice", matches: (categories: [Ice]), sharpness: 0.6,
         friction: (0.1, 0.05, 0.05), walk_sound: "glass",
         source: "Gronqvist et al. 2001, Measurement of slipperiness, Ergonomics 44: 1102-1117"),
        (id: "sand", name: "sand", matches: (tags: ["sand"]), sharpness: 0.05,
         repose_deg: Some((34.0, 40.0)), friction: (0.55, 0.6, 0.15), walk_sound: "sand",
         source: "Al-Hashemi and Al-Amoudi 2018, A review on the angle of repose of granular materials, Powder Technol. 330: 397-417"),
        (id: "gravel", name: "gravel", matches: (ids: ["gravel"], tags: ["placer"]), sharpness: 0.3,
         repose_deg: Some((40.0, 41.0)), friction: (0.6, 0.55, 0.15), walk_sound: "gravel",
         source: "Al-Hashemi and Al-Amoudi 2018; Carson 1977, Angles of repose, angles of shearing resistance and angles of talus slopes, Earth Surf. Proc. 2: 363-380"),
        (id: "ash_and_loess", name: "volcanic ash and loess", matches: (ids: ["volcanic_ash", "loess"]), sharpness: 0.2,
         repose_deg: Some((35.0, 25.0)), friction: (0.55, 0.35, 0.1), walk_sound: "sand",
         source: "Derbyshire et al. 2000, Landslides in the Gansu loess, Geol. Soc. Eng. Geol. Spec. Publ. 15", uncertain: true),
        (id: "clay", name: "clay", matches: (categories: [Clay], tags: ["plastic"]), sharpness: 0.35,
         repose_deg: Some((40.0, 20.0)), friction: (0.6, 0.25, 0.1), walk_sound: "mud",
         source: "Craig 2004, Soil Mechanics, 7th ed., ch. 4-5; Gronqvist et al. 2001", uncertain: true),
        (id: "peat", name: "peat", matches: (ids: ["peat"], tags: ["organic"]), sharpness: 0.15,
         repose_deg: Some((40.0, 30.0)), friction: (0.5, 0.35, 0.1), walk_sound: "moss",
         source: "Hobbs 1986, Mire morphology and the properties and behaviour of some British and foreign peats, Q. J. Eng. Geol. 19: 7-80", uncertain: true),
        (id: "soil", name: "soil and loose earth", matches: (categories: [Soil, Sediment, Pigment]), sharpness: 0.2,
         repose_deg: Some((37.0, 42.0)), friction: (0.6, 0.4, 0.1), walk_sound: "soil",
         source: "Al-Hashemi and Al-Amoudi 2018; Craig 2004, ch. 4", uncertain: true),
        (id: "rock", name: "rock", matches: (categories: [Rock, Mineral, Ore, Salt, Fuel, Metal]), sharpness: 0.9,
         friction: (0.7, 0.5, 0.1), walk_sound: "stone",
         source: "Gronqvist et al. 2001; Barton 1973, Review of a new shear-strength criterion for rock joints, Eng. Geol. 7: 287-332"),
    ],
)
