// Mineral materials: ores, native metals, salts and pigments. Densities are for the pure
// mineral; real ore bodies are mixtures (see geology/deposits for grades).
(
    schema: 1,
    entries: [
        (id: "pyrite", status: Implemented, name: "pyrite", category: Mineral, tags: ["ore", "spark_striker"], density_kg_m3: 5000, hardness_mohs: 6.3, fracture: Uneven,
