// Knowledge graph, Eras 3–5 (Mesolithic & Neolithic, Chalcolithic & Bronze Age, Iron Age &
// Classical). Prerequisites and history now; discovery routes and processes arrive with their
// milestones (V2-12 … V2-14). BCE dates are converted to years before 1950 for sorting.
(
    schema: 1,
    entries: [
        // ---- Era 3: Mesolithic & Neolithic ----
        (id: "ground_stone_axe", status: Implemented, name: "Ground stone axe", era: 3, requires: ["hand_axe", "grinding_seeds", "hafting_binding"],
         enables: ["grind_axe"],
         skill: "knapping",
         discovery: [
             (route: Experiment, trigger: "grind:einkorn", insight: 0.1, hint: "The quern's rubbing wears stone smooth: a stone ground to an edge would not chip as flint does."),
             (route: Inference, trigger: "infer:ground_stone_axe", insight: 0.3),
         ],
         history: (summary: "Axes ground and polished on sandstone take a tougher edge that fells trees far faster.", date: "c. 10,000 years ago", years_bp: 10000)),
        (id: "adze", status: Implemented, name: "Adze", era: 3, requires: ["ground_stone_axe"],
         enables: ["grind_adze"],
         skill: "woodworking",
         discovery: [
             (route: Experiment, trigger: "grind:cobble", insight: 0.2, hint: "Set across the haft instead of along it, the blade would shave a log flat."),
             (route: Inference, trigger: "infer:adze", insight: 0.3),
         ],
         history: (summary: "A blade set across the haft shapes and hollows timber.", date: "c. 9,000 years ago", years_bp: 9000)),
        (id: "dugout_canoe", status: Implemented, name: "Dugout canoe", era: 3, requires: ["adze", "fire_keeping"],
         enables: ["hollow_dugout"],
         skill: "woodworking",
         discovery: [
             (route: Experiment, trigger: "use:adze", insight: 0.1, hint: "A log burnt hollow and scraped floats with a person in it."),
             (route: Inference, trigger: "infer:dugout_canoe", insight: 0.3),
         ],
         history: (summary: "The Pesse canoe, hollowed from a pine log, is the oldest known boat.", date: "c. 8000 BCE", years_bp: 10000)),
        (id: "sledge", status: Implemented, name: "Sledge", era: 3, requires: ["cordage_basic"],
         enables: ["make_sledge"],
         skill: "woodworking",
         discovery: [
             (route: Experiment, trigger: "carry:full_hands", insight: 0.05, hint: "A load too big for the arms drags hard, but laid on smooth poles it slides over the snow."),
             (route: Inference, trigger: "infer:sledge", insight: 0.3),
         ],
         history: (summary: "Runners of wood drag loads over snow, ice and grass; sledge fragments survive in Finnish bogs.", date: "c. 7000 BCE", years_bp: 9000), uncertain: true),
        (id: "skis", name: "Skis", era: 3, requires: ["adze"],
         history: (summary: "Wooden skis from Vis in Russia let hunters travel fast over deep snow.", date: "c. 6000 BCE", years_bp: 8000)),
        (id: "seed_selection", status: Implemented, name: "Seed selection", era: 3, requires: ["grinding_seeds"],
         enables: ["select_seed"],
         skill: "farming",
         discovery: [
             (route: Experiment, trigger: "strip:wild_einkorn", insight: 0.1, hint: "Some ears are plump, some are thin: the plump ones came from the plants on the best ground."),
             (route: Experiment, trigger: "strip:wild_emmer", insight: 0.1),
             (route: Experiment, trigger: "strip:wild_barley", insight: 0.1),
             (route: Inference, trigger: "infer:seed_selection", insight: 0.25),
         ],
         history: (summary: "Keeping seed from the best plants, generation after generation, turns wild grasses into crops.", date: "c. 9500 BCE", years_bp: 11500)),
        (id: "sowing_and_tending", status: Implemented, name: "Sowing and tending", era: 3, requires: ["seed_selection", "digging_stick"],
         enables: ["till_soil", "sow_seed", "weed_plot", "manure_plot", "pull_crop", "rub_out_grain"],
         skill: "farming",
         discovery: [
             (route: Experiment, trigger: "dig:soil", insight: 0.05, hint: "Where the earth was turned last year, the wild wheat came up thick."),
             (route: Experiment, trigger: "select:einkorn", insight: 0.2),
             (route: Experiment, trigger: "select:emmer", insight: 0.2),
             (route: Experiment, trigger: "select:barley", insight: 0.2),
             (route: Inference, trigger: "infer:sowing_and_tending", insight: 0.3),
         ],
         history: (summary: "Einkorn, emmer, barley, lentils and flax were sown and tended in the Fertile Crescent.", date: "c. 9500 BCE", years_bp: 11500)),
        (id: "harvesting_sickle", status: Implemented, name: "Sickle", era: 3, requires: ["blade_technology", "pitch_adhesive", "sowing_and_tending"],
         enables: ["make_sickle", "reap_crop"],
         skill: "farming",
         discovery: [
             (route: Experiment, trigger: "reap:einkorn_crop", insight: 0.2, hint: "Pulling the ripe crop shakes out half the grain: a blade would cut it clean."),
             (route: Experiment, trigger: "reap:emmer_crop", insight: 0.2),
             (route: Experiment, trigger: "reap:barley_crop", insight: 0.2),
             (route: Inference, trigger: "infer:harvesting_sickle", insight: 0.3),
         ],
         history: (summary: "Flint blades set in a curved haft with glue cut grain stalks; their edges shine with 'sickle gloss'.", date: "c. 10,000 BCE", years_bp: 12000)),
        (id: "threshing_winnowing", status: Implemented, name: "Threshing and winnowing", era: 3, requires: ["harvesting_sickle"],
         enables: ["thresh_sheaf"],
         skill: "farming",
         discovery: [
             (route: Experiment, trigger: "rub:sheaf", insight: 0.15, hint: "Beaten on the ground, the ears would give up their grain faster than rubbed."),
             (route: Inference, trigger: "infer:threshing_winnowing", insight: 0.3),
         ],
         history: (summary: "Beating and tossing the harvest separates grain from straw and chaff.", date: "c. 9000 BCE", years_bp: 11000)),
        (id: "animal_herding", status: Implemented, name: "Herding", era: 3, requires: ["tracking", "cordage_basic"],
         enables: ["catch_animal", "tether_animal", "lead_animal", "pluck_wool", "slaughter_animal"],
         skill: "herding",
         discovery: [
             (route: Observation, trigger: "see:mouflon", insight: 0.05, hint: "A lamb whose mother is gone stands bleating where she fell, and lets you near."),
             (route: Observation, trigger: "see:bezoar_goat", insight: 0.05),
             (route: Observation, trigger: "see:aurochs", insight: 0.03),
             (route: Observation, trigger: "see:wild_boar", insight: 0.03),
             (route: Inference, trigger: "infer:animal_herding", insight: 0.3),
         ],
         history: (summary: "Wild sheep and goats were managed in herds in the Zagros before they changed into domestic forms.", date: "c. 9000 BCE", years_bp: 11000)),
        (id: "selective_breeding", status: Implemented, name: "Selective breeding", era: 3, requires: ["animal_herding"],
         discovery: [
             (route: Experiment, trigger: "slaughter:animal", insight: 0.15, hint: "The lambs of the calm ewe are calm: kill the wild ones for meat, and keep the calm to breed."),
             (route: Experiment, trigger: "pluck:animal", insight: 0.1),
             (route: Inference, trigger: "infer:selective_breeding", insight: 0.3),
         ],
         history: (summary: "Breeding only from the calmest, most useful animals changes a herd over generations.", date: "c. 8500 BCE", years_bp: 10500)),
        (id: "milking", status: Implemented, name: "Milking", era: 3, requires: ["animal_herding"],
         enables: ["milk_animal"],
         skill: "herding",
         discovery: [
             (route: Experiment, trigger: "tether:animal", insight: 0.1, hint: "The ewe with a lamb at foot has more milk than the lamb can take."),
             (route: Inference, trigger: "infer:milking", insight: 0.3),
         ],
         history: (summary: "Milk fats in Anatolian pots show dairying soon after herding began.", date: "c. 7000 BCE", years_bp: 9000)),
        (id: "cheese_making", status: Implemented, name: "Cheese", era: 3, requires: ["milking", "pottery_handbuilt"],
         enables: ["make_cheese"],
         skill: "cooking",
         discovery: [
             (route: Experiment, trigger: "milk:animal", insight: 0.15, hint: "Milk left warm by the fire sets thick, and the curd keeps."),
             (route: Inference, trigger: "infer:cheese_making", insight: 0.3),
         ],
         history: (summary: "Perforated pots from Poland held curds: cheese keeps milk's nourishment for months.", date: "c. 5500 BCE", years_bp: 7500)),
        (id: "pottery_handbuilt", status: Implemented, name: "Pottery", era: 3, requires: ["fire_keeping"],
         enables: ["shape_pot", "dry_pot", "fire_pot_open", "boil_in_pot"],
         skill: "pottery",
         discovery: [
             (route: Experiment, trigger: "dig:clay", insight: 0.06, hint: "Wet clay keeps the print of your hand, and dries hard by the fire."),
             (route: Experiment, trigger: "mould:clay", insight: 0.25, hint: "Clay holds whatever shape the hands give it."),
             (route: Inference, trigger: "infer:pottery_handbuilt", insight: 0.3),
         ],
         history: (summary: "Hunter-gatherers in China made cooking pots of fired clay long before farming; pottery spread with the Neolithic.", date: "c. 20,000 years ago", years_bp: 20000)),
        (id: "pit_firing", status: Implemented, name: "Pit firing", era: 3, requires: ["pottery_handbuilt"],
         enables: ["fire_pot_pit", "light_firing_pit", "feed_firing_pit"],
         skill: "pottery",
         discovery: [
             (route: Experiment, trigger: "do:fire_pot_open", insight: 0.3, hint: "The pots buried deepest in the embers came out hardest."),
             (route: Inference, trigger: "infer:pit_firing", insight: 0.3),
         ],
         history: (summary: "Pots buried in fuel in a shallow pit reach 700–900 °C.", date: "c. 20,000 years ago", years_bp: 20000)),
        (id: "kiln_updraft", status: Implemented, name: "Updraft kiln", era: 3, requires: ["pit_firing", "mudbrick"],
         enables: ["fire_pot_kiln", "light_kiln", "feed_kiln"],
         skill: "pottery",
         discovery: [
             (route: Experiment, trigger: "do:fire_pot_pit", insight: 0.15, hint: "Walls about the fire would hold its heat in."),
             (route: Inference, trigger: "infer:kiln_updraft", insight: 0.3),
         ],
         history: (summary: "A fire chamber below a perforated floor gives hotter, more even firing; early kilns appear in the Near East.", date: "c. 6000 BCE", years_bp: 8000)),
        (id: "spindle_spinning", status: Implemented, name: "Spindle spinning", era: 3, requires: ["cordage_advanced"],
         enables: ["make_spindle", "spin_flax"],
         skill: "fibrework",
         discovery: [
             (route: Experiment, trigger: "twist:flax_fibre", insight: 0.15, hint: "A stone hung on the cord as you twist keeps it turning: the twist runs on by itself."),
             (route: Experiment, trigger: "twist:nettle_fibre", insight: 0.1),
             (route: Inference, trigger: "infer:spindle_spinning", insight: 0.3),
         ],
         history: (summary: "A weighted spindle twists fibre into yarn continuously; spindle whorls become common with farming.", date: "c. 7000 BCE", years_bp: 9000)),
        (id: "loom_weaving", status: Implemented, name: "Loom weaving", era: 3, requires: ["spindle_spinning", "basketry"],
         enables: ["weave_linen", "sew_tunic", "sew_cloak"],
         skill: "fibrework",
         discovery: [
             (route: Experiment, trigger: "spin:flax_fibre", insight: 0.15, hint: "Threads laid side by side and others passed over and under them, as a basket is woven."),
             (route: Experiment, trigger: "spin:wool", insight: 0.15),
             (route: Inference, trigger: "infer:loom_weaving", insight: 0.3),
         ],
         history: (summary: "Warp-weighted and ground looms weave cloth; linen from Çatalhöyük survives.", date: "c. 7000 BCE", years_bp: 9000)),
        (id: "linen", status: Implemented, name: "Linen", era: 3, requires: ["spindle_spinning", "sowing_and_tending"],
         enables: ["ret_flax", "dress_flax"],
         skill: "fibrework",
         discovery: [
             (route: Experiment, trigger: "reap:flax_crop", insight: 0.15, hint: "Flax stems left lying in the wet go soft, and the fibre peels away from the woody core."),
             (route: Inference, trigger: "infer:linen", insight: 0.3),
         ],
         history: (summary: "Flax is retted, broken, scutched and spun into linen thread.", date: "c. 7000 BCE", years_bp: 9000)),
        (id: "wool", status: Implemented, name: "Wool", era: 3, requires: ["spindle_spinning", "animal_herding"],
         enables: ["spin_wool", "weave_wool"],
         skill: "fibrework",
         discovery: [
             (route: Experiment, trigger: "pluck:animal", insight: 0.2, hint: "The soft underwool of a moulting sheep twists into a thread warmer than flax."),
             (route: Inference, trigger: "infer:wool", insight: 0.3),
         ],
         history: (summary: "Sheep bred for fleece rather than hair made wool textiles possible.", date: "c. 4000 BCE", years_bp: 6000)),
        (id: "pit_house", status: Implemented, name: "Pit house", era: 3, requires: ["lean_to", "digging_stick"],
         discovery: [
             (route: Experiment, trigger: "dig:soil", insight: 0.15, hint: "Down in the hole the wind does not reach you."),
             (route: Inference, trigger: "infer:pit_house", insight: 0.3),
         ],
         history: (summary: "A floor dug into the ground with a roof on stout posts stays warm in winter.", date: "c. 12,000 years ago", years_bp: 12000)),
        (id: "wattle_and_daub", status: Implemented, name: "Wattle and daub", era: 3, requires: ["basketry", "pit_house"],
         discovery: [
             (route: Experiment, trigger: "weave:reed", insight: 0.2, hint: "What is woven tight could be plastered."),
             (route: Observation, trigger: "see:clay", insight: 0.2),
             (route: Inference, trigger: "infer:wattle_and_daub", insight: 0.3),
         ],
         history: (summary: "Woven rods plastered with clay, dung and straw make solid walls.", date: "c. 6000 BCE", years_bp: 8000)),
        (id: "mudbrick", status: Implemented, name: "Mudbrick", era: 3, requires: ["pit_house"],
         discovery: [
             (route: Experiment, trigger: "dig:clay", insight: 0.25, hint: "Clay dried in the sun is hard as wood."),
             (route: Inference, trigger: "infer:mudbrick", insight: 0.3),
         ],
         history: (summary: "Sun-dried bricks of mud and straw built Jericho and Çatalhöyük.", date: "c. 9000 BCE", years_bp: 11000)),
        (id: "timber_frame", status: Implemented, name: "Timber framing", era: 3, requires: ["ground_stone_axe", "adze"],
         enables: ["make_wedge", "split_planks"],
         skill: "woodworking",
         discovery: [
             (route: Experiment, trigger: "use:adze", insight: 0.2, hint: "A log hewn square sits tight against another; pegged, they hold."),
             (route: Inference, trigger: "infer:timber_frame", insight: 0.3),
         ],
         history: (summary: "Longhouses of the first European farmers stood on rows of massive posts.", date: "c. 5500 BCE", years_bp: 7500)),
        (id: "thatching", status: Implemented, name: "Thatching", era: 3, requires: ["lean_to", "cordage_basic"],
         discovery: [
             (route: Experiment, trigger: "weave:reed", insight: 0.3, hint: "Rain runs down the reeds and off their tips."),
             (route: Inference, trigger: "infer:thatching", insight: 0.3),
         ],
         history: (summary: "Bundles of reed or straw laid steeply shed rain for decades.", date: "Neolithic", years_bp: 8000), uncertain: true),
        (id: "quern", status: Implemented, name: "Saddle quern", era: 3, requires: ["grinding_seeds", "sowing_and_tending"],
         enables: ["grind_grain"],
         skill: "cooking",
         discovery: [
             (route: Experiment, trigger: "do:grind_seeds", insight: 0.15, hint: "A bigger, hollowed stone would grind more at a time."),
             (route: Inference, trigger: "infer:quern", insight: 0.3),
         ],
         history: (summary: "A rubbing stone on a saddle-shaped slab grinds grain into flour, hours every day.", date: "c. 9500 BCE", years_bp: 11500)),
        (id: "bread", status: Implemented, name: "Bread", era: 3, requires: ["quern", "cooking_roasting"],
         enables: ["bake_bread"],
         skill: "cooking",
         discovery: [
             (route: Experiment, trigger: "grind:einkorn", insight: 0.2, hint: "Flour wetted and laid on the hot stones would bake firm."),
             (route: Experiment, trigger: "grind:emmer", insight: 0.2),
             (route: Experiment, trigger: "grind:barley", insight: 0.2),
             (route: Inference, trigger: "infer:bread", insight: 0.3),
         ],
         history: (summary: "Charred flatbread at Shubayqa 1 in Jordan predates farming.", date: "c. 14,400 years ago", years_bp: 14400)),
        (id: "fermentation", name: "Fermentation", era: 3, requires: ["pottery_handbuilt"],
         history: (summary: "Residues in pots from Jiahu show fermented drinks of rice, honey and fruit.", date: "c. 7000 BCE", years_bp: 9000)),
        (id: "storage_pits", status: Implemented, name: "Storage pits", era: 3, requires: ["digging_stick"],
         discovery: [
             (route: Experiment, trigger: "dig:soil", insight: 0.08, hint: "What is buried and covered, the mice and the rain cannot reach."),
             (route: Inference, trigger: "infer:storage_pits", insight: 0.3),
         ],
         history: (summary: "Lined pits keep grain and nuts through the winter.", date: "c. 10,000 BCE", years_bp: 12000)),
        (id: "granary", name: "Granary", era: 3, requires: ["storage_pits", "timber_frame"],
         history: (summary: "Raised, ventilated stores at Dhra' in Jordan kept grain dry and away from pests.", date: "c. 9500 BCE", years_bp: 11500)),
        (id: "fencing", name: "Fences and pens", era: 3, requires: ["ground_stone_axe", "animal_herding"],
         history: (summary: "Enclosures keep herds in and predators out.", date: "Neolithic", years_bp: 9000), uncertain: true),
        (id: "ard_plough", name: "Ard plough", era: 3, requires: ["sowing_and_tending", "timber_frame", "draft_animals"],
         history: (summary: "A pointed wooden ard scratches furrows; plough marks survive under barrows.", date: "c. 4000 BCE", years_bp: 6000)),
        (id: "draft_animals", name: "Draft animals", era: 3, requires: ["selective_breeding"],
         history: (summary: "Castrated cattle (oxen) pull ploughs and sledges.", date: "c. 4000 BCE", years_bp: 6000)),
        (id: "irrigation_channels", name: "Irrigation", era: 3, requires: ["sowing_and_tending", "digging_stick"],
         history: (summary: "Channels and dikes led river water to fields in Mesopotamia.", date: "c. 6000 BCE", years_bp: 8000)),
        (id: "potters_wheel", status: Implemented, name: "Potter's wheel", era: 3, requires: ["pottery_handbuilt"],
         enables: ["throw_pot"],
         skill: "pottery",
         discovery: [
             (route: Experiment, trigger: "mould:earthenware_clay", insight: 0.1, hint: "A pot built on a mat turned by the hand comes up rounder."),
             (route: Inference, trigger: "infer:potters_wheel", insight: 0.3),
         ],
         history: (summary: "A turning table (tournette, then a fast wheel) shapes pots quickly and evenly in Mesopotamia.", date: "c. 4500 BCE", years_bp: 6500)),
        (id: "wheel_and_axle", status: Implemented, name: "Wheel and axle", era: 3, requires: ["potters_wheel", "timber_frame"],
         enables: ["make_handcart"],
         skill: "woodworking",
         discovery: [
             (route: Experiment, trigger: "throw:earthenware_clay", insight: 0.15, hint: "A disc turning on a pin: set two under a load and it would roll."),
             (route: Inference, trigger: "infer:wheel_and_axle", insight: 0.3),
         ],
         history: (summary: "The wheel on an axle appears almost at once across Mesopotamia and Europe; the Ljubljana Marshes wheel is among the oldest.", date: "c. 3500 BCE", years_bp: 5500)),
        (id: "cart", name: "Cart", era: 3, requires: ["wheel_and_axle", "draft_animals"],
         history: (summary: "Ox carts moved heavy loads overland; the Bronocice pot shows a wagon.", date: "c. 3500 BCE", years_bp: 5500)),
        // ---- Era 4: Chalcolithic & Bronze Age ----
        (id: "native_copper_working", name: "Native copper working", era: 4, requires: ["anvil_use"],
         history: (summary: "Nuggets of native copper were hammered into beads and awls in Anatolia.", date: "c. 8700 BCE", years_bp: 10700)),
        (id: "annealing", name: "Annealing", era: 4, requires: ["native_copper_working", "fire_keeping"],
         history: (summary: "Heating hammered copper makes it soft again so it can be worked further without cracking.", date: "c. 7000 BCE", years_bp: 9000)),
        (id: "charcoal_clamp", name: "Charcoal making", era: 4, requires: ["fire_keeping", "storage_pits"],
         history: (summary: "Wood smouldered under turf without enough air becomes charcoal, a fuel hot enough for metals.", date: "c. 5000 BCE", years_bp: 7000), uncertain: true),
        (id: "copper_smelting", name: "Copper smelting", era: 4, requires: ["charcoal_clamp", "kiln_updraft", "crucible"],
         history: (summary: "Green malachite heated with charcoal at Belovode in Serbia gave the first smelted copper.", date: "c. 5000 BCE", years_bp: 7000)),
        (id: "bellows", name: "Bellows", era: 4, requires: ["hide_scraping", "pottery_handbuilt"],
         history: (summary: "Hide bags pumping air through clay nozzles (tuyères) push furnaces past 1,100 °C.", date: "c. 3000 BCE", years_bp: 5000)),
        (id: "crucible", name: "Crucible", era: 4, requires: ["pit_firing"],
         history: (summary: "Small clay vessels hold metal molten in the fire.", date: "c. 5000 BCE", years_bp: 7000)),
        (id: "open_mold_casting", name: "Open-mould casting", era: 4, requires: ["copper_smelting", "crucible"],
         history: (summary: "Molten copper poured into a shape carved in stone makes flat axes.", date: "c. 4500 BCE", years_bp: 6500)),
        (id: "two_part_mold", name: "Two-part moulds", era: 4, requires: ["open_mold_casting"],
         history: (summary: "Paired moulds cast shaft-hole axes and spearheads in the round.", date: "c. 3000 BCE", years_bp: 5000)),
        (id: "lost_wax", name: "Lost-wax casting", era: 4, requires: ["two_part_mold"],
         history: (summary: "A wax model is coated in clay and melted out; the Nahal Mishmar hoard used it.", date: "c. 3700 BCE", years_bp: 5700)),
        (id: "arsenical_copper", name: "Arsenical copper", era: 4, requires: ["copper_smelting"],
         history: (summary: "Copper smelted from arsenic-bearing ores is harder: the first alloy, often accidental.", date: "c. 4000 BCE", years_bp: 6000)),
        (id: "tin_bronze", name: "Tin bronze", era: 4, requires: ["copper_smelting", "crucible"],
         history: (summary: "About one part tin to nine of copper makes bronze, harder than copper and easier to cast.", date: "c. 3000 BCE", years_bp: 5000)),
        (id: "metal_saw", name: "Metal saw", era: 4, requires: ["tin_bronze"],
         history: (summary: "Bronze saws cut planks and joinery, transforming carpentry.", date: "c. 3000 BCE", years_bp: 5000)),
        (id: "metal_chisel", name: "Metal chisel", era: 4, requires: ["open_mold_casting"],
         history: (summary: "Copper and bronze chisels cut mortises and dress stone.", date: "c. 3500 BCE", years_bp: 5500)),
        (id: "fired_brick", name: "Fired brick", era: 4, requires: ["mudbrick", "kiln_updraft"],
         history: (summary: "Kiln-fired bricks resist rain; the Indus cities were built of them.", date: "c. 3500 BCE", years_bp: 5500)),
        (id: "lime_burning", name: "Lime burning", era: 4, requires: ["kiln_updraft"],
         history: (summary: "Limestone burned at 900 °C gives quicklime; lime plaster floors are found at Göbekli Tepe-era sites.", date: "c. 7000 BCE", years_bp: 9000)),
        (id: "lime_plaster", name: "Lime plaster", era: 4, requires: ["lime_burning"],
         history: (summary: "Slaked lime hardens back into stone as it takes up carbon dioxide.", date: "c. 7000 BCE", years_bp: 9000)),
        (id: "faience", name: "Faience", era: 4, requires: ["kiln_updraft"],
         history: (summary: "Glazed quartz paste, bright blue and green, was made in Egypt and Mesopotamia.", date: "c. 4000 BCE", years_bp: 6000)),
        (id: "early_glass", name: "Glass", era: 4, requires: ["faience"],
         history: (summary: "Glass beads and then core-formed vessels appear in Mesopotamia.", date: "c. 2500 BCE", years_bp: 4500)),
        (id: "sail", name: "Sail", era: 4, requires: ["loom_weaving", "dugout_canoe"],
         history: (summary: "A painted Nile boat carries a square sail; the wind moves cargo upstream.", date: "c. 4000 BCE", years_bp: 6000)),
        (id: "plank_boat", name: "Plank boat", era: 4, requires: ["metal_saw", "cordage_advanced"],
         history: (summary: "Planks sewn or pegged together build larger hulls, like the Dover boat.", date: "c. 2000 BCE", years_bp: 4000)),
        (id: "horse_riding", name: "Horse riding", era: 4, requires: ["selective_breeding"],
         history: (summary: "Horses were herded and then ridden on the Eurasian steppe.", date: "c. 3000 BCE", years_bp: 5000), uncertain: true),
        (id: "plant_dyes", name: "Plant dyes", era: 4, requires: ["loom_weaving"],
         history: (summary: "Madder, woad and weld dye cloth red, blue and yellow; mordants fix the colour.", date: "c. 3000 BCE", years_bp: 5000)),
        (id: "mineral_pigments", name: "Mineral pigments", era: 4, requires: ["ochre_pigment", "grinding_seeds"],
         history: (summary: "Ground malachite, azurite and ochres colour walls, faces and pottery.", date: "c. 4000 BCE", years_bp: 6000)),
        (id: "record_marks", name: "Record marks", era: 4, requires: ["cave_painting"],
         history: (summary: "Tallies, tokens and marks on clay kept count of goods before writing.", date: "c. 8000 BCE", years_bp: 10000)),
        // ---- Era 5: Iron Age & Classical ----
        (id: "bloomery_iron", name: "Bloomery iron", era: 5, requires: ["copper_smelting", "bellows", "charcoal_clamp"],
         history: (summary: "Iron ore reduced by charcoal in a clay furnace yields a spongy bloom, never molten; ironworking spread widely after 1200 BCE.", date: "c. 1200 BCE", years_bp: 3150)),
        (id: "forging", name: "Forging", era: 5, requires: ["bloomery_iron"],
         history: (summary: "Hammering the hot bloom drives out slag and welds it into bar iron.", date: "c. 1200 BCE", years_bp: 3150)),
        (id: "carburizing_steel", name: "Steel by carburizing", era: 5, requires: ["forging"],
         history: (summary: "Iron heated long in charcoal absorbs carbon at its surface and becomes steel.", date: "c. 1000 BCE", years_bp: 2950)),
        (id: "quench_and_temper", name: "Quenching and tempering", era: 5, requires: ["carburizing_steel"],
         history: (summary: "Quenched steel is hard but brittle; gentle reheating trades a little hardness for toughness.", date: "c. 900 BCE", years_bp: 2850)),
        (id: "iron_tools", name: "Iron tools", era: 5, requires: ["forging"],
         history: (summary: "Iron axes, sickles and chisels became cheap enough for every farmer.", date: "c. 1000 BCE", years_bp: 2950)),
        (id: "iron_ploughshare", name: "Iron ploughshare", era: 5, requires: ["iron_tools", "ard_plough"],
         history: (summary: "An iron tip on the ard opens heavier soils.", date: "c. 1000 BCE", years_bp: 2950)),
        (id: "rotary_quern", name: "Rotary quern", era: 5, requires: ["quern", "wheel_and_axle"],
         history: (summary: "One stone turning on another grinds flour far faster than a saddle quern.", date: "c. 500 BCE", years_bp: 2450)),
        (id: "lime_mortar", name: "Lime mortar", era: 5, requires: ["lime_plaster"],
         history: (summary: "Lime and sand bind stone and brick into lasting walls.", date: "c. 3000 BCE", years_bp: 5000)),
        (id: "concrete", name: "Concrete", era: 5, requires: ["lime_mortar"],
         history: (summary: "Roman builders mixed lime with volcanic ash (pozzolana) into concrete that sets even under water.", date: "c. 200 BCE", years_bp: 2150)),
        (id: "arch", name: "Arch", era: 5, requires: ["fired_brick", "lime_mortar"],
         history: (summary: "Wedge-shaped stones carry loads in compression across wide openings.", date: "c. 2000 BCE (true arches)", years_bp: 4000)),
        (id: "vault", name: "Vault", era: 5, requires: ["arch"],
         history: (summary: "An arch extended into a tunnel roofs long spaces.", date: "c. 1500 BCE", years_bp: 3500)),
        (id: "dome", name: "Dome", era: 5, requires: ["vault", "concrete"],
         history: (summary: "The Pantheon's concrete dome, 43 m across, remains the largest unreinforced dome.", date: "c. 125 CE", years_bp: 1825)),
        (id: "aqueduct", name: "Aqueduct", era: 5, requires: ["arch", "concrete"],
         history: (summary: "Channels on a steady gentle gradient, bridged on arches, carried water for tens of kilometres.", date: "c. 312 BCE", years_bp: 2262)),
        (id: "cistern", name: "Cistern", era: 5, requires: ["lime_plaster"],
         history: (summary: "Waterproof-plastered cisterns store rainwater through dry seasons.", date: "c. 4000 BCE", years_bp: 6000)),
        (id: "crane_pulley", name: "Crane and pulley", era: 5, requires: ["cordage_advanced", "timber_frame", "wheel_and_axle"],
         history: (summary: "Greek builders lifted blocks with compound pulleys on timber cranes.", date: "c. 515 BCE", years_bp: 2465)),
        (id: "lathe", name: "Lathe", era: 5, requires: ["wheel_and_axle", "iron_tools"],
         history: (summary: "Spinning a workpiece against a fixed cutter turns bowls and legs perfectly round.", date: "c. 1300 BCE", years_bp: 3250)),
        (id: "glassblowing", name: "Glassblowing", era: 5, requires: ["early_glass", "iron_tools"],
         history: (summary: "Blowing through an iron pipe into molten glass made glass cheap and common in the Roman world.", date: "c. 50 BCE", years_bp: 2000)),
        (id: "water_wheel", name: "Water wheel", era: 5, requires: ["wheel_and_axle", "timber_frame", "irrigation_channels"],
         history: (summary: "Falling or flowing water turning a wheel was the first mechanical power not from muscle.", date: "c. 300 BCE", years_bp: 2250)),
        (id: "gearing_basic", name: "Gearing", era: 5, requires: ["water_wheel", "lathe"],
         history: (summary: "Toothed wheels change the direction and speed of rotation, driving millstones from a water wheel.", date: "c. 250 BCE", years_bp: 2200)),
        (id: "advanced_sailing", name: "Seagoing sailing ships", era: 5, requires: ["sail", "plank_boat"],
         history: (summary: "Keeled merchant ships with rigged sails crossed the Mediterranean and Indian Ocean on the monsoon winds.", date: "c. 1000 BCE", years_bp: 2950)),
        (id: "tanning_bark", name: "Bark tanning", era: 5, requires: ["hide_scraping", "pottery_handbuilt"],
         history: (summary: "Soaking hides for months in tannin-rich bark liquors makes durable leather.", date: "c. 5000 BCE or earlier", years_bp: 7000), uncertain: true),
        (id: "smithing_advanced", name: "Pattern welding and advanced smithing", era: 5, requires: ["quench_and_temper"],
         history: (summary: "Folding and welding iron and steel together makes blades both hard and tough.", date: "c. 200 CE", years_bp: 1750)),
    ],
)
