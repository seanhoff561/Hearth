// Knowledge graph, Eras 0–2 (Lower, Middle and Upper Paleolithic). Discovery triggers are
// events the game emits (`strike:…`, `watch:…`, `see:…`, `infer:…`); insight adds up to 1.
// Dates are approximate earliest evidence and often disputed; uncertain ones are marked.
(
    schema: 1,
    entries: [
        // ---- Era 0: Lower Paleolithic ----
        (
            id: "stone_as_hammer", name: "Stone as a hammer", era: 0,
            enables: ["test_nodule"],
            discovery: [
                (route: Experiment, trigger: "strike:stone_on_stone", insight: 0.34, hint: "Two stones knocked together crack loudly. One is harder than the other."),
                (route: Observation, trigger: "watch:hominin_hammering", insight: 0.5),
            ],
            history: (summary: "The oldest known stone tools, from Lomekwi in Kenya, are hammers, anvils and battered cores.", date: "c. 3.3 million years ago", years_bp: 3300000),
        ),
        (
            id: "anvil_use", name: "Hammer and anvil", era: 0, requires: ["stone_as_hammer"],
            discovery: [
                (route: Experiment, trigger: "strike:on_flat_stone", insight: 0.34),
                (route: Observation, trigger: "watch:hominin_anvil", insight: 0.5),
            ],
            history: (summary: "A flat stone steadies what is struck: nuts, bones and stones break where they are hit.", date: "c. 3.3 million years ago", years_bp: 3300000),
        ),
        (
            id: "nut_cracking", name: "Cracking nuts", era: 0, requires: ["anvil_use"],
            enables: ["crack_nuts"],
            discovery: [
                (route: Experiment, trigger: "strike:nut", insight: 0.5, hint: "The hazelnut shells are too hard for teeth."),
                (route: Observation, trigger: "watch:hominin_nut_cracking", insight: 0.6),
            ],
            history: (summary: "Hammer-and-anvil nut cracking, practised by chimpanzees today, is thought to be as old as the first stone tools.", date: "c. 3.3 million years ago (inferred)", years_bp: 3300000),
            uncertain: true,
        ),
        (
            id: "sharp_flake", name: "Sharp flakes", era: 0, requires: ["stone_as_hammer"],
            enables: ["strike_flake"],
            discovery: [
                (route: Experiment, trigger: "strike:knappable_stone", insight: 0.25, hint: "A chip flew off the flint, and its edge is keen."),
                (route: Observation, trigger: "watch:hominin_knapping", insight: 0.4),
                (route: Evidence, trigger: "study:tool_scatter", insight: 0.2),
            ],
            history: (summary: "Striking one stone with another at the right angle detaches razor-sharp flakes: the Lomekwian and then the Oldowan toolkits.", date: "c. 3.3–2.6 million years ago", years_bp: 3300000),
        ),
        (
            id: "flake_cutting", name: "Cutting with flakes", era: 0, requires: ["sharp_flake"],
            discovery: [
                (route: Experiment, trigger: "use:flake_on_carcass", insight: 0.5),
                (route: Observation, trigger: "watch:hominin_butchering", insight: 0.5),
            ],
            history: (summary: "Cut marks on animal bones show flakes slicing meat from carcasses.", date: "c. 2.6 million years ago", years_bp: 2600000),
        ),
        (
            id: "digging_stick", name: "Digging stick", era: 0,
            enables: ["sharpen_digging_stick"],
            discovery: [
                (route: Experiment, trigger: "dig:with_stick", insight: 0.5, hint: "A stick loosens the earth far better than fingers."),
                (route: Observation, trigger: "watch:hominin_digging", insight: 0.6),
            ],
            history: (summary: "Sticks for digging roots and tubers leave little trace, but living foragers and chimpanzees both use them.", date: "over 2 million years ago (inferred)", years_bp: 2000000),
            uncertain: true,
        ),
        (
            id: "throwing_stones", name: "Throwing stones", era: 0,
            discovery: [(route: Experiment, trigger: "throw:stone", insight: 0.5)],
            history: (summary: "Changes in the human shoulder suggest powerful overarm throwing by early Homo.", date: "c. 2 million years ago (inferred)", years_bp: 2000000),
            uncertain: true,
        ),
        (
            id: "termite_probe", name: "Termite probe", era: 0,
            discovery: [
                (route: Observation, trigger: "watch:hominin_termite_fishing", insight: 0.7),
                (route: Experiment, trigger: "probe:termite_mound", insight: 0.4),
            ],
            history: (summary: "Worn bone tools from Swartkrans were used to open termite mounds; chimpanzees fish for termites with twigs.", date: "c. 1.8 million years ago", years_bp: 1800000),
            uncertain: true,
        ),
        (
            id: "chopper", name: "Chopper", era: 0, requires: ["sharp_flake"],
            enables: ["make_chopper"],
            discovery: [
                (route: Inference, trigger: "infer:chopper", insight: 0.5, hint: "If a flake cuts, an edge on a heavy cobble could chop."),
                (route: Experiment, trigger: "strike:cobble_edge", insight: 0.3),
            ],
            history: (summary: "Oldowan choppers: cobbles with a few flakes struck off one edge.", date: "c. 2.6 million years ago", years_bp: 2600000),
        ),
        (
            id: "hand_axe", name: "Hand axe", era: 0, requires: ["chopper"],
            enables: ["make_hand_axe"],
            discovery: [
                (route: Experiment, trigger: "knap:bifacial", insight: 0.2),
                (route: Evidence, trigger: "study:hand_axe", insight: 0.3),
            ],
            history: (summary: "Acheulean hand axes, shaped on both faces to a planned symmetric form, were made for over a million years.", date: "c. 1.76 million years ago", years_bp: 1760000),
        ),
        (
            id: "wooden_spear", name: "Wooden spear", era: 0, requires: ["flake_cutting"],
            enables: ["whittle_spear"],
            discovery: [
                (route: Experiment, trigger: "shave:pole_point", insight: 0.4),
                (route: Inference, trigger: "infer:spear", insight: 0.5, hint: "A long pole with a sharp end would keep an animal at a distance."),
            ],
            history: (summary: "The Clacton spear point and the Schöningen spears are finely made hunting weapons of spruce and yew.", date: "c. 400,000 years ago", years_bp: 400000),
        ),
        (
            id: "carrying_bundle", name: "Carrying bundle", era: 0,
            discovery: [(route: Experiment, trigger: "carry:many_items", insight: 0.5, hint: "Hands hold only so much. Something wrapped could hold more.")],
            history: (summary: "Stones carried kilometres from their sources show that early hominins transported things, perhaps wrapped in hide or leaves.", date: "c. 2 million years ago (inferred)", years_bp: 2000000),
            uncertain: true,
        ),
        (
            id: "butchery", name: "Butchery", era: 0, requires: ["flake_cutting"],
            enables: ["butcher_small_game"],
            discovery: [
                (route: Experiment, trigger: "cut:carcass", insight: 0.5),
                (route: Observation, trigger: "watch:hominin_butchering", insight: 0.5),
            ],
            history: (summary: "Systematic cut and percussion marks show carcasses skinned, dismembered and filleted.", date: "c. 2.6 million years ago", years_bp: 2600000),
        ),
        (
            id: "marrow_extraction", name: "Marrow extraction", era: 0, requires: ["anvil_use", "butchery"],
            enables: ["crack_bones"],
            discovery: [
                (route: Experiment, trigger: "strike:bone", insight: 0.5, hint: "The broken bone is full of rich fat."),
                (route: Observation, trigger: "watch:hyena_cracking_bones", insight: 0.3),
            ],
            history: (summary: "Long bones smashed on anvils for their fatty marrow, a food other scavengers could not reach.", date: "c. 2.6 million years ago", years_bp: 2600000),
        ),
        (
            id: "fire_keeping", name: "Keeping fire", era: 0,
            needs: [Environment("wildfire")],
            enables: ["take_wildfire_ember"],
            discovery: [
                (route: Observation, trigger: "see:wildfire", insight: 0.4, hint: "After the grass fire, embers glow for hours in the fallen logs."),
                (route: Experiment, trigger: "carry:ember", insight: 0.3),
            ],
            history: (summary: "Ash and burned bone in Wonderwerk Cave show fire used long before anyone could make it: fire was captured and fed.", date: "c. 1 million years ago", years_bp: 1000000),
        ),
        (
            id: "fire_hardening", name: "Fire-hardening", era: 0, requires: ["fire_keeping", "wooden_spear"],
            enables: ["fire_harden_spear"],
            discovery: [(route: Experiment, trigger: "heat:wood_point", insight: 0.5, hint: "The point that touched the embers is darker and harder.")],
            history: (summary: "Wooden points dried and hardened in fire hold their shape better.", date: "c. 400,000 years ago (uncertain)", years_bp: 400000),
            uncertain: true,
        ),
        (
            id: "cooking_roasting", name: "Roasting", era: 0, requires: ["fire_keeping"],
            enables: ["roast_meat", "cook_greens"],
            discovery: [
                (route: Experiment, trigger: "heat:meat", insight: 0.5),
                (route: Observation, trigger: "find:burned_carcass", insight: 0.5, hint: "The animal caught by the fire is easier to chew, and smells good."),
            ],
            history: (summary: "Burned fish remains at Gesher Benot Ya'aqov suggest cooking; cooked food is softer and yields more energy.", date: "c. 780,000 years ago", years_bp: 780000),
        ),
        (
            id: "windbreak_shelter", name: "Windbreak", era: 0,
            discovery: [
                (route: Experiment, trigger: "pile:branches", insight: 0.4),
                (route: Observation, trigger: "see:animal_lair", insight: 0.3),
            ],
            history: (summary: "Simple brush windbreaks and hut outlines are claimed from sites such as Terra Amata; most left no trace.", date: "c. 400,000 years ago (uncertain)", years_bp: 400000),
            uncertain: true,
        ),
        // ---- Era 1: Middle Paleolithic ----
        (
            id: "fire_by_friction_hand_drill", name: "Fire by hand drill", era: 1, requires: ["fire_keeping", "flake_cutting"],
            enables: ["hand_drill_fire"],
            discovery: [
                (route: Experiment, trigger: "rub:sticks", insight: 0.2, hint: "Rubbing two dry sticks hard makes them hot and smoky."),
                (route: Inference, trigger: "infer:friction_fire", insight: 0.3),
            ],
            history: (summary: "When people first made fire rather than keeping it is unknown; Neanderthals were probably making fire by 50,000 years ago.", date: "by c. 50,000 years ago (uncertain)", years_bp: 50000),
            uncertain: true,
        ),
        (
            id: "fire_by_friction_bow_drill", name: "Fire by bow drill", era: 1, requires: ["fire_by_friction_hand_drill", "cordage_basic"],
            discovery: [
                (route: Inference, trigger: "infer:bow_drill", insight: 0.5, hint: "A cord looped around the drill could spin it faster than hands."),
                (route: Experiment, trigger: "spin:drill_with_cord", insight: 0.3),
            ],
            history: (summary: "A cord on a bow spins the drill far faster and with less effort than bare hands.", date: "undated; documented in later prehistory", years_bp: 40000),
            uncertain: true,
        ),
        (
            id: "prepared_core", name: "Prepared-core knapping", era: 1, requires: ["hand_axe"],
            discovery: [(route: Experiment, trigger: "knap:prepare_platform", insight: 0.2, hint: "Shaping the core first decides the shape of the flake that comes off.")],
            history: (summary: "Levallois knappers shaped a core so one blow removed a flake of predetermined shape.", date: "c. 300,000 years ago", years_bp: 300000),
        ),
        (
            id: "scraper", name: "Scraper", era: 1, requires: ["prepared_core"],
            enables: ["make_scraper"],
            discovery: [(route: Experiment, trigger: "scrape:hide_with_flake", insight: 0.4)],
            history: (summary: "Retouched side scrapers dominate Mousterian toolkits; wear traces show hide and wood working.", date: "c. 300,000 years ago", years_bp: 300000),
        ),
        (
            id: "hafting_binding", name: "Hafting", era: 1, requires: ["prepared_core"],
            discovery: [
                (route: Inference, trigger: "infer:haft", insight: 0.5, hint: "A stone bound to a handle could strike harder than a stone in the fist."),
                (route: Experiment, trigger: "bind:stone_to_stick", insight: 0.4),
            ],
            history: (summary: "Stone tools bound or glued into handles multiply leverage and reach.", date: "c. 300,000 years ago", years_bp: 300000),
        ),
        (
            id: "birch_tar", name: "Birch tar", era: 1, requires: ["fire_keeping"],
            enables: ["cook_birch_tar"],
            discovery: [(route: Experiment, trigger: "heat:birch_bark", insight: 0.3, hint: "The birch bark smouldering under the ash oozed a black, sticky tar.")],
            history: (summary: "Birch tar lumps from Campitello, Italy, are the oldest known man-made adhesive, used to haft stone tools.", date: "c. 200,000 years ago", years_bp: 200000),
        ),
        (
            id: "pitch_adhesive", name: "Compound adhesive", era: 1, requires: ["fire_keeping", "ochre_pigment"],
            discovery: [
                (route: Experiment, trigger: "heat:resin", insight: 0.3),
                (route: Inference, trigger: "infer:compound_adhesive", insight: 0.3),
            ],
            history: (summary: "At Sibudu, plant gum mixed with ochre made a strong, less brittle glue for hafting.", date: "c. 70,000 years ago", years_bp: 70000),
        ),
        (
            id: "stone_tipped_spear", name: "Stone-tipped spear", era: 1, requires: ["wooden_spear", "hafting_binding"],
            discovery: [(route: Inference, trigger: "infer:tipped_spear", insight: 0.6, hint: "The flint point bound to the spear would pierce hide the wood can't.")],
            history: (summary: "Stone points hafted onto spears, known from Kathu Pan, became widespread in the Middle Stone Age.", date: "c. 500,000–300,000 years ago", years_bp: 300000),
        ),
        (
            id: "hide_scraping", name: "Hide scraping", era: 1, requires: ["scraper", "butchery"],
            enables: ["scrape_hide"],
            discovery: [(route: Experiment, trigger: "scrape:rawhide", insight: 0.5)],
            history: (summary: "Scraping fat and flesh from hides keeps them from rotting and makes them supple.", date: "c. 300,000 years ago", years_bp: 300000),
        ),
        (
            id: "hide_wrap_clothing", name: "Hide wraps", era: 1, requires: ["hide_scraping"],
            discovery: [
                (route: Experiment, trigger: "wear:hide", insight: 0.4),
                (route: Inference, trigger: "infer:clothing_from_cold", insight: 0.3, hint: "The hide kept the deer warm. It could keep you warm."),
            ],
            history: (summary: "Clothing lice split from head lice around 170,000 years ago, a hint of when people began wearing clothes.", date: "c. 170,000 years ago (inferred)", years_bp: 170000),
            uncertain: true,
        ),
        (
            id: "cordage_basic", name: "Cordage", era: 1,
            enables: ["twist_cord"],
            discovery: [
                (route: Experiment, trigger: "twist:fibre", insight: 0.4, hint: "Twisted fibres hold together far better than loose ones."),
                (route: Observation, trigger: "see:vine", insight: 0.1),
            ],
            history: (summary: "A three-ply cord fragment on a stone tool from Abri du Maras is the oldest direct evidence of string.", date: "c. 50,000 years ago", years_bp: 50000),
        ),
        (
            id: "ochre_pigment", name: "Ochre", era: 1,
            discovery: [(route: Experiment, trigger: "grind:red_ochre", insight: 0.5, hint: "The red earth stains everything it touches.")],
            history: (summary: "Ground red ochre, used for colour and in adhesives, appears in Africa and becomes common by 100,000 years ago.", date: "c. 300,000 years ago", years_bp: 300000),
        ),
        (
            id: "lean_to", name: "Lean-to", era: 1, requires: ["windbreak_shelter"],
            discovery: [
                (route: Experiment, trigger: "lean:poles", insight: 0.4),
                (route: Inference, trigger: "infer:roof", insight: 0.3),
            ],
            history: (summary: "Poles leaned against a ridge and covered with bark or brush shed rain as well as wind.", date: "Middle Paleolithic (inferred)", years_bp: 100000),
            uncertain: true,
        ),
        (
            id: "stone_boiling", name: "Stone boiling", era: 1, requires: ["fire_keeping"],
            discovery: [(route: Experiment, trigger: "drop:hot_stone_in_water", insight: 0.5, hint: "The stone from the fire made the water hiss and steam.")],
            history: (summary: "Hot stones dropped into water in a hide, bark or pit boil food without a fireproof pot; fire-cracked rock piles record it.", date: "c. 30,000 years ago or earlier (uncertain)", years_bp: 30000),
            uncertain: true,
        ),
        // ---- Era 2: Upper Paleolithic ----
        (
            id: "blade_technology", name: "Blades", era: 2, requires: ["prepared_core"],
            discovery: [(route: Experiment, trigger: "knap:long_blade", insight: 0.2)],
            history: (summary: "Long, parallel-sided blades struck from prismatic cores give far more cutting edge per kilogram of flint.", date: "c. 50,000 years ago", years_bp: 50000),
        ),
        (
            id: "burin", name: "Burin", era: 2, requires: ["blade_technology"],
            discovery: [(route: Experiment, trigger: "engrave:bone", insight: 0.4)],
            history: (summary: "Chisel-edged burins cut grooves in antler and bone to split out blanks for points and needles.", date: "c. 40,000 years ago", years_bp: 40000),
        ),
        (
            id: "bone_antler_working", name: "Bone and antler working", era: 2, requires: ["burin", "butchery"],
            discovery: [(route: Experiment, trigger: "shape:bone", insight: 0.4)],
            history: (summary: "Grooving, splitting, scraping and polishing turn bone and antler into points, awls and harpoons.", date: "c. 40,000 years ago", years_bp: 40000),
        ),
        (
            id: "awl", name: "Awl", era: 2, requires: ["bone_antler_working"],
            discovery: [(route: Experiment, trigger: "pierce:hide", insight: 0.5)],
            history: (summary: "Pointed bone awls pierce hides for lacing.", date: "c. 40,000 years ago (earlier in Africa)", years_bp: 40000),
        ),
        (
            id: "eyed_needle", name: "Eyed needle", era: 2, requires: ["awl"],
            discovery: [
                (route: Inference, trigger: "infer:needle", insight: 0.4),
                (route: Experiment, trigger: "bore:bone_splinter", insight: 0.3),
            ],
            history: (summary: "Bone needles with drilled eyes allow fine, tight seams.", date: "c. 40,000 years ago", years_bp: 40000),
        ),
        (
            id: "sewn_clothing", name: "Sewn clothing", era: 2, requires: ["eyed_needle", "hide_wrap_clothing", "cordage_basic"],
            discovery: [
                (route: Inference, trigger: "infer:fitted_clothing", insight: 0.5),
                (route: Experiment, trigger: "sew:hide", insight: 0.3),
            ],
            history: (summary: "Fitted, sewn fur clothing let people live through Ice Age winters in the far north.", date: "c. 40,000–30,000 years ago", years_bp: 35000),
        ),
        (
            id: "cordage_advanced", name: "Plied cordage and knots", era: 2, requires: ["cordage_basic"],
            discovery: [(route: Experiment, trigger: "ply:cord", insight: 0.4)],
            history: (summary: "Flax fibres from Dzudzuana Cave, some twisted and dyed, show a developed fibre craft.", date: "c. 30,000 years ago", years_bp: 30000),
        ),
        (
            id: "netting", name: "Netting", era: 2, requires: ["cordage_advanced"],
            discovery: [
                (route: Observation, trigger: "see:spider_web", insight: 0.3),
                (route: Experiment, trigger: "knot:cord_mesh", insight: 0.3),
            ],
            history: (summary: "Impressions in fired clay at Pavlov preserve knotted nets and fine weaves.", date: "c. 27,000 years ago", years_bp: 27000),
        ),
        (
            id: "snares_and_traps", name: "Snares and traps", era: 2, requires: ["cordage_basic"],
            discovery: [
                (route: Experiment, trigger: "tie:noose", insight: 0.3),
                (route: Observation, trigger: "see:animal_trail", insight: 0.2),
            ],
            history: (summary: "Snares catch small game while the hunter is elsewhere; hare and fox bones pile up at Upper Paleolithic sites.", date: "Upper Paleolithic (inferred)", years_bp: 30000),
            uncertain: true,
        ),
        (
            id: "atlatl", name: "Spear-thrower", era: 2, requires: ["stone_tipped_spear", "bone_antler_working"],
            discovery: [(route: Experiment, trigger: "throw:with_lever", insight: 0.3)],
            history: (summary: "A hooked board lengthens the arm and hurls a light dart far faster than a hand-thrown spear.", date: "c. 20,000 years ago", years_bp: 20000),
        ),
        (
            id: "bow_and_arrow", name: "Bow and arrow", era: 2, requires: ["cordage_advanced", "hafting_binding"],
            discovery: [
                (route: Inference, trigger: "infer:bow", insight: 0.3, hint: "The bent stave snaps back when the cord is let go."),
                (route: Experiment, trigger: "flex:stave_with_cord", insight: 0.3),
            ],
            history: (summary: "Tiny stone points from Sibudu and Grotte Mandrin carry the impact damage of arrows.", date: "c. 60,000 years ago (early evidence)", years_bp: 60000),
        ),
        (
            id: "fletching", name: "Fletching", era: 2, requires: ["bow_and_arrow", "pitch_adhesive"],
            discovery: [
                (route: Observation, trigger: "see:feather_flight", insight: 0.3),
                (route: Experiment, trigger: "fix:feathers_to_shaft", insight: 0.3),
            ],
            history: (summary: "Feathers glued and bound to the shaft make arrows fly straight; the oldest surviving arrows come from Stellmoor.", date: "c. 11,000 years ago (earliest surviving arrows)", years_bp: 11000),
        ),
        (
            id: "fishhook", name: "Fishhook", era: 2, requires: ["bone_antler_working", "cordage_basic"],
            discovery: [(route: Experiment, trigger: "shape:gorge", insight: 0.4)],
            history: (summary: "Shell fishhooks from Sakitari Cave on Okinawa are among the oldest known.", date: "c. 23,000 years ago", years_bp: 23000),
        ),
        (
            id: "harpoon", name: "Harpoon", era: 2, requires: ["bone_antler_working"],
            discovery: [(route: Inference, trigger: "infer:barbed_point", insight: 0.4)],
            history: (summary: "Barbed bone points from Katanda in Congo were used to spear large catfish.", date: "c. 90,000 years ago", years_bp: 90000),
        ),
        (
            id: "fish_weir", name: "Fish weir", era: 2, requires: ["basketry"],
            discovery: [(route: Observation, trigger: "see:fish_trapped_in_pool", insight: 0.4)],
            history: (summary: "Fences of stakes and wattle across streams and tidal flats guide fish into traps.", date: "c. 10,000 years ago or earlier", years_bp: 10000),
            uncertain: true,
        ),
        (
            id: "fat_lamp", name: "Fat lamp", era: 2, requires: ["fire_keeping", "butchery"],
            discovery: [(route: Experiment, trigger: "burn:fat_in_hollow_stone", insight: 0.5, hint: "The fat that dripped into the hollow stone keeps burning.")],
            history: (summary: "Stone lamps burning animal fat lit the painted caves.", date: "c. 40,000 years ago", years_bp: 40000),
        ),
        (
            id: "basketry", name: "Basketry", era: 2, requires: ["cordage_basic"],
            discovery: [
                (route: Observation, trigger: "see:bird_nest", insight: 0.3),
                (route: Experiment, trigger: "weave:rods", insight: 0.4),
            ],
            history: (summary: "Basketry impressions in clay at Pavlov are among the earliest evidence of weaving.", date: "c. 26,000 years ago", years_bp: 26000),
        ),
        (
            id: "raft", name: "Raft", era: 2, requires: ["cordage_basic"],
            discovery: [(route: Experiment, trigger: "float:logs", insight: 0.5, hint: "Dead logs float; lashed together they would carry weight.")],
            history: (summary: "People reached Australia across open sea, which required watercraft.", date: "c. 60,000 years ago (inferred)", years_bp: 60000),
            uncertain: true,
        ),
        (
            id: "wolf_taming", name: "Taming wolves", era: 2,
            discovery: [
                (route: Experiment, trigger: "feed:wolf_pup", insight: 0.2),
                (route: Observation, trigger: "see:wolves_follow_camp", insight: 0.2),
            ],
            history: (summary: "Dogs descend from wolves that lived alongside Ice Age hunters.", date: "c. 30,000–15,000 years ago", years_bp: 20000),
        ),
        (
            id: "grinding_seeds", name: "Grinding seeds", era: 2, requires: ["anvil_use"],
            enables: ["grind_seeds"],
            discovery: [(route: Experiment, trigger: "grind:seeds", insight: 0.5)],
            history: (summary: "Starch grains on grinding stones at Bilancino and Kostenki show wild plants ground into flour.", date: "c. 30,000 years ago", years_bp: 30000),
        ),
        (
            id: "cave_painting", name: "Painting", era: 2, requires: ["ochre_pigment"],
            discovery: [(route: Experiment, trigger: "paint:wall", insight: 0.5)],
            history: (summary: "A painted wild pig in a Sulawesi cave is among the oldest known figurative art; Chauvet's animals followed.", date: "c. 45,000 years ago", years_bp: 45000),
        ),
        (
            id: "drying_and_smoking", name: "Drying and smoking", era: 2, requires: ["fire_keeping", "butchery", "cordage_basic"],
            enables: ["dry_meat"],
            discovery: [
                (route: Observation, trigger: "see:meat_kept_in_smoke", insight: 0.4, hint: "The meat hung in the smoke hasn't gone off."),
                (route: Experiment, trigger: "hang:meat_near_fire", insight: 0.3),
            ],
