// Knowledge graph, Eras 0–2 (Lower, Middle and Upper Paleolithic). Discovery routes listen for
// triggers the game emits (`hearth_content::triggers`): doing (`do:<process>`, `<verb>:<thing>`,
// `use:<tool>`), seeing (`see:`), throwing (`throw:`), inferring from known prerequisites
// (`infer:<node>`), and the systems' own (`carry:full_hands`, `sleep:on_hide`). Routes for
// systems still to come (hominins, fauna, found evidence) wait in the data. Dates are approximate
// earliest evidence and often disputed; uncertain ones are marked.
(
    schema: 1,
    entries: [
        // ---- Era 0: Lower Paleolithic ----
        (
            id: "stone_as_hammer", status: Implemented, name: "Stone as a hammer", era: 0,
            enables: ["test_nodule"],
            skill: "knapping",
            discovery: [
                (route: Experiment, trigger: "strike:stone", insight: 0.34, hint: "Two stones knocked together crack loudly. One is harder than the other."),
            ],
            history: (summary: "The oldest known stone tools, from Lomekwi in Kenya, are hammers, anvils and battered cores.", date: "c. 3.3 million years ago", years_bp: 3300000),
        ),
        (
            id: "anvil_use", status: Implemented, name: "Hammer and anvil", era: 0, requires: ["stone_as_hammer"],
            discovery: [
                (route: Experiment, trigger: "strike:anvil_stone", insight: 0.34, hint: "Struck on the flat stone, the nut did not roll away."),
            ],
            history: (summary: "A flat stone steadies what is struck: nuts, bones and stones break where they are hit.", date: "c. 3.3 million years ago", years_bp: 3300000),
        ),
        (
            id: "nut_cracking", status: Implemented, name: "Cracking nuts", era: 0, requires: ["anvil_use"],
            enables: ["crack_nuts", "crack_marula_stones"],
            discovery: [
                (route: Experiment, trigger: "strike:nut", insight: 0.5, hint: "The hazelnut shells are too hard for teeth."),
            ],
            history: (summary: "Hammer-and-anvil nut cracking, practised by chimpanzees today, is thought to be as old as the first stone tools.", date: "c. 3.3 million years ago (inferred)", years_bp: 3300000),
            uncertain: true,
        ),
        (
            id: "sharp_flake", status: Implemented, name: "Sharp flakes", era: 0, requires: ["stone_as_hammer"],
            enables: ["strike_flake", "retouch_edge"],
            skill: "knapping",
            discovery: [
                (route: Experiment, trigger: "strike:knappable", insight: 0.25, hint: "A chip flew off the flint, and its edge is keen."),
                (route: Evidence, trigger: "study:tool_scatter", insight: 0.2),
            ],
            history: (summary: "Striking one stone with another at the right angle detaches razor-sharp flakes: the Lomekwian and then the Oldowan toolkits.", date: "c. 3.3–2.6 million years ago", years_bp: 3300000),
        ),
        (
            id: "flake_cutting", status: Implemented, name: "Cutting with flakes", era: 0, requires: ["sharp_flake"],
            discovery: [
                (route: Experiment, trigger: "use:flake", insight: 0.25, hint: "The sharp chip slices where fingers only tear."),
            ],
            history: (summary: "Cut marks on animal bones show flakes slicing meat from carcasses.", date: "c. 2.6 million years ago", years_bp: 2600000),
        ),
        (
            id: "digging_stick", status: Implemented, name: "Digging stick", era: 0,
            enables: ["sharpen_digging_stick"],
            discovery: [
                (route: Experiment, trigger: "do:dig_with_stick", insight: 0.5, hint: "A stick loosens the earth far better than fingers."),
            ],
            history: (summary: "Sticks for digging roots and tubers leave little trace, but living foragers and chimpanzees both use them.", date: "over 2 million years ago (inferred)", years_bp: 2000000),
            uncertain: true,
        ),
        (
            id: "throwing_stones", status: Implemented, name: "Throwing stones", era: 0,
            // Every throw is practice at throwing true.
            skill: "throwing",
            discovery: [
                (route: Experiment, trigger: "throw:stone", insight: 0.25, hint: "A stone thrown hard flies far and lands with a thud."),
            ],
            history: (summary: "Changes in the human shoulder suggest powerful overarm throwing by early Homo.", date: "c. 2 million years ago (inferred)", years_bp: 2000000),
            uncertain: true,
        ),
        (
            id: "tracking", status: Implemented, name: "Tracking", era: 0,
            discovery: [
                (route: Observation, trigger: "see:tracks", insight: 0.2, hint: "The prints in the soft ground are fresh, and they go somewhere."),
            ],
            history: (summary: "Reading the prints, droppings and blood an animal leaves, to know what it is, how long since it passed and where it went, is among the oldest of hunters' arts; the San of the Kalahari still follow spoor across hard ground.", date: "deep antiquity (inferred)", years_bp: 1000000),
            uncertain: true,
        ),
        (
            id: "termite_probe", status: Implemented, name: "Probing for insects", era: 0,
            discovery: [
                (route: Experiment, trigger: "use:twig", insight: 0.35, hint: "Poked into the rotten wood, the twig comes out with grubs on it."),
            ],
            history: (summary: "Worn bone tools from Swartkrans were used to open termite mounds; chimpanzees fish for termites with twigs.", date: "c. 1.8 million years ago", years_bp: 1800000),
            uncertain: true,
        ),
        (
            id: "chopper", status: Implemented, name: "Chopper", era: 0, requires: ["sharp_flake"],
            enables: ["make_chopper"],
            skill: "knapping",
            discovery: [
                (route: Inference, trigger: "infer:chopper", insight: 0.5, hint: "If a flake cuts, an edge on a heavy cobble could chop."),
                (route: Experiment, trigger: "do:test_nodule", insight: 0.15),
            ],
            history: (summary: "Oldowan choppers: cobbles with a few flakes struck off one edge.", date: "c. 2.6 million years ago", years_bp: 2600000),
        ),
        (
            id: "hand_axe", status: Implemented, name: "Hand axe", era: 0, requires: ["chopper"],
            enables: ["make_hand_axe"],
            skill: "knapping",
            discovery: [
                (route: Experiment, trigger: "do:make_chopper", insight: 0.2, hint: "Worked on both faces, the edge would run all the way around."),
                (route: Evidence, trigger: "study:hand_axe", insight: 0.3),
            ],
            history: (summary: "Acheulean hand axes, shaped on both faces to a planned symmetric form, were made for over a million years.", date: "c. 1.76 million years ago", years_bp: 1760000),
        ),
        (
            id: "wooden_spear", status: Implemented, name: "Wooden spear", era: 0, requires: ["flake_cutting"],
            enables: ["whittle_spear", "resharpen_point"],
            skill: "woodworking",
            discovery: [
                (route: Experiment, trigger: "shave:wood", insight: 0.3, hint: "Shaved with the flake, the wood comes to a point."),
                (route: Inference, trigger: "infer:wooden_spear", insight: 0.5, hint: "A long pole with a sharp end would keep an animal at a distance."),
            ],
            history: (summary: "The Clacton spear point and the Schöningen spears are finely made hunting weapons of spruce and yew.", date: "c. 400,000 years ago", years_bp: 400000),
        ),
        (
            id: "carrying_bundle", status: Implemented, name: "Carrying bundle", era: 0,
            enables: ["make_bundle", "make_pouch"],
            discovery: [
                (route: Experiment, trigger: "carry:full_hands", insight: 0.25, hint: "Hands hold only so much. Something wrapped could hold more."),
            ],
            history: (summary: "Stones carried kilometres from their sources show that early hominins transported things, perhaps wrapped in hide or leaves.", date: "c. 2 million years ago (inferred)", years_bp: 2000000),
            uncertain: true,
        ),
        (
            id: "butchery", status: Implemented, name: "Butchery", era: 0, requires: ["flake_cutting"],
            // Butchering each species' carcass (generated: hearth_content::butchery).
            enables: [],
            skill: "butchery",
            discovery: [
                (route: Experiment, trigger: "cut:carcass", insight: 0.5, hint: "Hacked open, the carcass gives meat, but much is wasted."),
            ],
            history: (summary: "Systematic cut and percussion marks show carcasses skinned, dismembered and filleted.", date: "c. 2.6 million years ago", years_bp: 2600000),
        ),
        (
            id: "marrow_extraction", status: Implemented, name: "Marrow extraction", era: 0, requires: ["anvil_use", "butchery"],
            enables: ["crack_bones"],
            discovery: [
                (route: Experiment, trigger: "strike:bone", insight: 0.5, hint: "The broken bone is full of rich fat."),
                (route: Observation, trigger: "watch:hyena_cracking_bones", insight: 0.3),
            ],
            history: (summary: "Long bones smashed on anvils for their fatty marrow, a food other scavengers could not reach.", date: "c. 2.6 million years ago", years_bp: 2600000),
        ),
        (
            id: "fire_keeping", status: Implemented, name: "Keeping fire", era: 0,
            enables: ["take_ember", "light_fire", "feed_fire", "bank_fire"],
            skill: "firemaking",
            discovery: [
                (route: Observation, trigger: "see:wildfire", insight: 0.15, hint: "After the lightning, a dead tree burns, and embers glow in it for hours."),
                (route: Experiment, trigger: "do:take_firebrand", insight: 0.5, hint: "The burning stick carried the fire away with it."),
            ],
            history: (summary: "Ash and burned bone in Wonderwerk Cave show fire used long before anyone could make it: fire was captured and fed.", date: "c. 1 million years ago", years_bp: 1000000),
        ),
        (
            id: "fire_hardening", status: Implemented, name: "Fire-hardening", era: 0, requires: ["fire_keeping", "wooden_spear"],
            enables: ["fire_harden_spear"],
            discovery: [
                (route: Experiment, trigger: "heat:wood", insight: 0.35, hint: "The point that touched the embers is darker and harder."),
            ],
            history: (summary: "Wooden points dried and hardened in fire hold their shape better.", date: "c. 400,000 years ago (uncertain)", years_bp: 400000),
            uncertain: true,
        ),
        (
            id: "cooking_roasting", status: Implemented, name: "Roasting", era: 0, requires: ["fire_keeping"],
            enables: ["roast_meat", "roast_joint", "cook_greens"],
            skill: "cooking",
            discovery: [
                (route: Experiment, trigger: "heat:meat", insight: 0.5, hint: "The meat held in the flames is easier to chew, and smells good."),
                (route: Observation, trigger: "find:burned_carcass", insight: 0.5),
            ],
            history: (summary: "Burned fish remains at Gesher Benot Ya'aqov suggest cooking; cooked food is softer and yields more energy.", date: "c. 780,000 years ago", years_bp: 780000),
        ),
        (
            id: "windbreak_shelter", status: Implemented, name: "Windbreak", era: 0,
            discovery: [
                (route: Experiment, trigger: "build:stick", insight: 0.4, hint: "Behind the piled brush, the wind is broken."),
                (route: Observation, trigger: "see:animal_lair", insight: 0.3),
            ],
            history: (summary: "Simple brush windbreaks and hut outlines are claimed from sites such as Terra Amata; most left no trace.", date: "c. 400,000 years ago (uncertain)", years_bp: 400000),
            uncertain: true,
        ),
        (
            id: "telling_umbellifer", status: Implemented, name: "Telling the umbellifers apart", era: 0,
            discovery: [
                (route: Observation, trigger: "see:umbellifer", insight: 0.12, hint: "Some of the white-flowered stems are spotted purple and smell of mice."),
                (route: Experiment, trigger: "eat:umbellifer", insight: 0.5, hint: "The root you ate tasted of carrot; that one did not."),
            ],
            history: (summary: "Foragers know the carrot family's edible roots from hemlock and water dropwort, which kill.", date: "as old as foraging", years_bp: 300000),
            uncertain: true,
        ),
        (
            id: "telling_white_mushroom", status: Implemented, name: "Telling white mushrooms apart", era: 0,
            discovery: [
                (route: Observation, trigger: "see:white_mushroom", insight: 0.1, hint: "Some pale mushrooms stand in a cup at their foot and keep their gills white."),
                (route: Experiment, trigger: "eat:white_mushroom", insight: 0.5),
            ],
            history: (summary: "Field mushrooms and death caps grow in different places and differ in their gills and foot; most deaths from mushrooms are from the death cap.", date: "as old as foraging", years_bp: 300000),
            uncertain: true,
        ),
        (
            id: "telling_dark_berry", status: Implemented, name: "Telling dark berries apart", era: 0,
            discovery: [
                (route: Observation, trigger: "see:dark_berry", insight: 0.12, hint: "Bilberries grow low in clusters; the glossy black berries sit singly in a green star on a tall plant."),
                (route: Experiment, trigger: "eat:dark_berry", insight: 0.5),
            ],
            history: (summary: "Bilberries and deadly nightshade share woods; the nightshade's single glossy berries in a green star are deadly.", date: "as old as foraging", years_bp: 300000),
            uncertain: true,
        ),
        // ---- Era 1: Middle Paleolithic ----
        (
            id: "fire_by_friction_hand_drill", status: Implemented, name: "Fire by hand drill", era: 1, requires: ["fire_keeping", "flake_cutting"],
            enables: ["hand_drill_fire"],
            skill: "firemaking",
            discovery: [
                (route: Experiment, trigger: "rub:wood", insight: 0.2, hint: "Rubbing two dry sticks hard makes them hot and smoky."),
                (route: Inference, trigger: "infer:fire_by_friction_hand_drill", insight: 0.3),
            ],
            history: (summary: "When people first made fire rather than keeping it is unknown; Neanderthals were probably making fire by 50,000 years ago.", date: "by c. 50,000 years ago (uncertain)", years_bp: 50000),
            uncertain: true,
        ),
        (
            id: "fire_by_friction_bow_drill", status: Implemented, name: "Fire by bow drill", era: 1, requires: ["fire_by_friction_hand_drill", "cordage_basic"],
            enables: ["bow_drill_fire"],
            skill: "firemaking",
            discovery: [
                (route: Inference, trigger: "infer:fire_by_friction_bow_drill", insight: 0.5, hint: "A cord looped around the drill could spin it faster than hands."),
                (route: Experiment, trigger: "do:hand_drill_fire", insight: 0.15),
            ],
            history: (summary: "A cord on a bow spins the drill far faster and with less effort than bare hands.", date: "undated; documented in later prehistory", years_bp: 40000),
            uncertain: true,
        ),
        (
            id: "prepared_core", status: Implemented, name: "Prepared-core knapping", era: 1, requires: ["hand_axe"],
            enables: ["knap_point"],
            skill: "knapping",
            discovery: [
                (route: Experiment, trigger: "do:make_hand_axe", insight: 0.15, hint: "Shaping the core first decides the shape of the flake that comes off."),
            ],
            history: (summary: "Levallois knappers shaped a core so one blow removed a flake of predetermined shape.", date: "c. 300,000 years ago", years_bp: 300000),
        ),
        (
            id: "scraper", status: Implemented, name: "Scraper", era: 1, requires: ["prepared_core"],
            enables: ["make_scraper"],
            skill: "knapping",
            discovery: [
                (route: Experiment, trigger: "scrape:hide", insight: 0.4, hint: "A thick, blunt edge scrapes the hide without cutting it."),
            ],
            history: (summary: "Retouched side scrapers dominate Mousterian toolkits; wear traces show hide and wood working.", date: "c. 300,000 years ago", years_bp: 300000),
        ),
        (
            id: "hafting_binding", status: Implemented, name: "Hafting", era: 1, requires: ["prepared_core"],
            enables: ["rebind_haft"],
            discovery: [
                (route: Inference, trigger: "infer:hafting_binding", insight: 0.5, hint: "A stone bound to a handle could strike harder than a stone in the fist."),
                (route: Experiment, trigger: "bind:flake", insight: 0.4),
            ],
            history: (summary: "Stone tools bound or glued into handles multiply leverage and reach.", date: "c. 300,000 years ago", years_bp: 300000),
        ),
        (
            id: "birch_tar", status: Implemented, name: "Birch tar", era: 1, requires: ["fire_keeping"],
            enables: ["cook_birch_tar"],
            discovery: [
                (route: Experiment, trigger: "heat:birch_bark", insight: 0.3, hint: "The birch bark smouldering under the ash oozed a black, sticky tar."),
            ],
            history: (summary: "Birch tar lumps from Campitello, Italy, are the oldest known man-made adhesive, used to haft stone tools.", date: "c. 200,000 years ago", years_bp: 200000),
        ),
        (
            id: "pitch_adhesive", status: Implemented, name: "Compound adhesive", era: 1, requires: ["fire_keeping", "ochre_pigment"],
            enables: ["make_compound_glue"],
            discovery: [
                (route: Experiment, trigger: "heat:pine_resin", insight: 0.3, hint: "The resin softens in the heat, then sets hard and brittle."),
                (route: Inference, trigger: "infer:pitch_adhesive", insight: 0.3),
            ],
            history: (summary: "At Sibudu, plant gum mixed with ochre made a strong, less brittle glue for hafting.", date: "c. 70,000 years ago", years_bp: 70000),
        ),
        (
            id: "stone_tipped_spear", status: Implemented, name: "Stone-tipped spear", era: 1, requires: ["wooden_spear", "hafting_binding"],
            enables: ["haft_spear"],
            discovery: [
                (route: Inference, trigger: "infer:stone_tipped_spear", insight: 0.6, hint: "The flint point bound to the spear would pierce hide the wood can't."),
            ],
            history: (summary: "Stone points hafted onto spears, known from Kathu Pan, became widespread in the Middle Stone Age.", date: "c. 500,000–300,000 years ago", years_bp: 300000),
        ),
        (
            id: "hide_scraping", status: Implemented, name: "Hide scraping", era: 1, requires: ["scraper", "butchery"],
            enables: ["scrape_hide"],
            skill: "hideworking",
            discovery: [
                (route: Experiment, trigger: "scrape:rawhide", insight: 0.5, hint: "Scraped clean, the hide no longer stinks."),
            ],
            history: (summary: "Scraping fat and flesh from hides keeps them from rotting and makes them supple.", date: "c. 300,000 years ago", years_bp: 300000),
        ),
        (
            id: "hide_wrap_clothing", status: Implemented, name: "Hide wraps", era: 1, requires: ["hide_scraping"],
            enables: ["make_hide_cape"],
            discovery: [
                (route: Experiment, trigger: "wear:hide", insight: 0.4, hint: "The hide around my shoulders keeps the wind off."),
                (route: Inference, trigger: "infer:hide_wrap_clothing", insight: 0.3, hint: "The hide kept the deer warm. It could keep you warm."),
            ],
            history: (summary: "Clothing lice split from head lice around 170,000 years ago, a hint of when people began wearing clothes.", date: "c. 170,000 years ago (inferred)", years_bp: 170000),
            uncertain: true,
        ),
        (
            id: "cordage_basic", status: Implemented, name: "Cordage", era: 1,
            enables: ["twist_cord", "twist_sinew", "make_belt", "ply_cord", "knot_mesh", "tie_noose"],
            skill: "fibrework",
            discovery: [
                (route: Experiment, trigger: "twist:fibre", insight: 0.4, hint: "Twisted fibres hold together far better than loose ones."),
                (route: Observation, trigger: "see:vine", insight: 0.1),
            ],
            history: (summary: "A three-ply cord fragment on a stone tool from Abri du Maras is the oldest direct evidence of string.", date: "c. 50,000 years ago", years_bp: 50000),
        ),
        (
            id: "ochre_pigment", status: Implemented, name: "Ochre", era: 1,
            enables: ["grind_pigment"],
            discovery: [
                (route: Experiment, trigger: "grind:red_ochre", insight: 0.5, hint: "The red earth stains everything it touches."),
            ],
            history: (summary: "Ground red ochre, used for colour and in adhesives, appears in Africa and becomes common by 100,000 years ago.", date: "c. 300,000 years ago", years_bp: 300000),
        ),
        (
            id: "lean_to", status: Implemented, name: "Lean-to", era: 1, requires: ["windbreak_shelter"],
            discovery: [
                (route: Experiment, trigger: "build:stick", insight: 0.25, hint: "Brush leaned on a pole would keep off the rain as well as the wind."),
                (route: Inference, trigger: "infer:lean_to", insight: 0.3),
            ],
            history: (summary: "Poles leaned against a ridge and covered with bark or brush shed rain as well as wind.", date: "Middle Paleolithic (inferred)", years_bp: 100000),
            uncertain: true,
        ),
        (
            id: "stone_boiling", status: Implemented, name: "Stone boiling", era: 1, requires: ["fire_keeping"],
            enables: ["stone_boil"],
            skill: "cooking",
            discovery: [
                (route: Experiment, trigger: "do:drop_hot_stone", insight: 0.5, hint: "The stone from the fire made the water hiss and steam."),
            ],
            history: (summary: "Hot stones dropped into water in a hide, bark or pit boil food without a fireproof pot; fire-cracked rock piles record it.", date: "c. 30,000 years ago or earlier (uncertain)", years_bp: 30000),
            uncertain: true,
        ),
        // ---- Era 2: Upper Paleolithic ----
        (
            id: "blade_technology", status: Implemented, name: "Blades", era: 2, requires: ["prepared_core"],
            enables: ["knap_blades"],
            skill: "knapping",
            discovery: [
                (route: Experiment, trigger: "do:knap_point", insight: 0.2, hint: "From a well-prepared core, long flakes run the length of the stone."),
            ],
            history: (summary: "Long, parallel-sided blades struck from prismatic cores give far more cutting edge per kilogram of flint.", date: "c. 50,000 years ago", years_bp: 50000),
        ),
        (
            id: "burin", status: Implemented, name: "Burin", era: 2, requires: ["blade_technology"],
            enables: ["make_burin"],
            skill: "knapping",
            discovery: [
                (route: Experiment, trigger: "engrave:bone", insight: 0.4, hint: "The corner of the blade cuts a groove in the bone."),
            ],
            history: (summary: "Chisel-edged burins cut grooves in antler and bone to split out blanks for points and needles.", date: "c. 40,000 years ago", years_bp: 40000),
        ),
        (
            id: "bone_antler_working", status: Implemented, name: "Bone and antler working", era: 2, requires: ["burin", "butchery"],
            enables: ["make_awl"],
            skill: "boneworking",
            discovery: [
                (route: Experiment, trigger: "engrave:bone", insight: 0.3, hint: "Grooved deep on both sides, a long splinter of bone comes free."),
            ],
            history: (summary: "Grooving, splitting, scraping and polishing turn bone and antler into points, awls and harpoons.", date: "c. 40,000 years ago", years_bp: 40000),
        ),
        (
            id: "awl", status: Implemented, name: "Awl", era: 2, requires: ["bone_antler_working"],
            enables: ["make_water_skin", "stitch_hides"],
            skill: "boneworking",
            discovery: [
                (route: Experiment, trigger: "pierce:hide", insight: 0.5, hint: "A sharp splinter goes through the hide and leaves a hole for a lace."),
            ],
            history: (summary: "Pointed bone awls pierce hides for lacing.", date: "c. 40,000 years ago (earlier in Africa)", years_bp: 40000),
        ),
        (
            id: "eyed_needle", status: Implemented, name: "Eyed needle", era: 2, requires: ["awl"],
            enables: ["make_needle"],
            skill: "boneworking",
            discovery: [
                (route: Inference, trigger: "infer:eyed_needle", insight: 0.4, hint: "A thread through the end of a fine point would follow it through the hide."),
                (route: Experiment, trigger: "do:make_awl", insight: 0.25),
            ],
            history: (summary: "Bone needles with drilled eyes allow fine, tight seams.", date: "c. 40,000 years ago", years_bp: 40000),
        ),
        (
            id: "sewn_clothing", status: Implemented, name: "Sewn clothing", era: 2, requires: ["eyed_needle", "hide_wrap_clothing", "cordage_basic"],
            enables: ["sew_parka", "sew_leggings", "sew_moccasins", "sew_mittens"],
            skill: "sewing",
            discovery: [
                (route: Inference, trigger: "infer:sewn_clothing", insight: 0.5, hint: "Cut to the body and sewn, hides would close out the cold."),
                (route: Experiment, trigger: "sew:hide", insight: 0.3),
            ],
            history: (summary: "Fitted, sewn fur clothing let people live through Ice Age winters in the far north.", date: "c. 40,000–30,000 years ago", years_bp: 35000),
        ),
        (
            id: "cordage_advanced", status: Implemented, name: "Plied cordage and knots", era: 2, requires: ["cordage_basic"],
            skill: "fibrework",
            discovery: [
                (route: Experiment, trigger: "ply:cord", insight: 0.4, hint: "Two cords twisted against each other hold far more than one."),
            ],
            history: (summary: "Flax fibres from Dzudzuana Cave, some twisted and dyed, show a developed fibre craft.", date: "c. 30,000 years ago", years_bp: 30000),
        ),
        (
            id: "netting", status: Implemented, name: "Netting", era: 2, requires: ["cordage_advanced"],
            enables: ["knot_net"],
            skill: "fibrework",
            discovery: [
                (route: Observation, trigger: "see:spider_web", insight: 0.3),
                (route: Experiment, trigger: "knot:cord", insight: 0.3, hint: "Knotted into a mesh, cord would hold what slips through fingers."),
            ],
            history: (summary: "Impressions in fired clay at Pavlov preserve knotted nets and fine weaves.", date: "c. 27,000 years ago", years_bp: 27000),
        ),
