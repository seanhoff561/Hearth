// Knowledge graph, Eras 6–8 (Medieval, Industrial, Modern): planned data only, hidden in game,
// so the graph can grow toward later eras without restructuring (v2 §12.2). Intermediate steps
// (batteries, generators, vacuum tubes) link the listed milestones realistically.
(
    schema: 1,
    entries: [
        // ---- Era 6: Medieval ----
        (id: "windmill", name: "Windmill", era: 6, requires: ["gearing_basic", "sail"],
         history: (summary: "Vertical-axis windmills ground grain in Persia; post mills followed in Europe.", date: "c. 950 CE", years_bp: 1000)),
        (id: "magnetic_compass", name: "Magnetic compass", era: 6, requires: ["iron_tools"], needs: [Material("magnetite")],
         history: (summary: "A magnetised needle floating in water points north; Chinese texts describe it for navigation.", date: "c. 1044 CE", years_bp: 906)),
        (id: "mechanical_clock", name: "Mechanical clock", era: 6, requires: ["gearing_basic", "smithing_advanced"],
         history: (summary: "The verge-and-foliot escapement let weight-driven clocks strike the hours in European towers.", date: "c. 1280 CE", years_bp: 670)),
        (id: "gunpowder", name: "Gunpowder", era: 6, requires: ["charcoal_clamp"], needs: [Material("niter"), Material("sulfur")],
         history: (summary: "Saltpetre, sulfur and charcoal burn fiercely together; Chinese alchemists recorded the mixture.", date: "c. 850 CE", years_bp: 1100)),
        (id: "heavy_plough", name: "Heavy plough", era: 6, requires: ["iron_ploughshare", "draft_animals"],
         history: (summary: "A wheeled plough with a mouldboard turns heavy clay soils, opening northern Europe to farming.", date: "c. 600 CE", years_bp: 1350)),
        (id: "horse_collar", name: "Horse collar", era: 6, requires: ["draft_animals", "horse_riding"],
         history: (summary: "A padded collar lets a horse pull with its shoulders rather than its throat.", date: "c. 500 CE", years_bp: 1450)),
        (id: "spinning_wheel", name: "Spinning wheel", era: 6, requires: ["spindle_spinning", "wheel_and_axle"],
         history: (summary: "A wheel-driven spindle multiplies a spinner's output.", date: "c. 1000 CE", years_bp: 950)),
        (id: "blast_furnace", name: "Blast furnace", era: 6, requires: ["bloomery_iron", "water_wheel"],
         history: (summary: "Taller furnaces blown by water-powered bellows melt iron outright.", date: "c. 1150 CE (Europe)", years_bp: 800)),
        (id: "cast_iron", name: "Cast iron", era: 6, requires: ["blast_furnace"],
         history: (summary: "Molten iron poured into moulds; China cast iron centuries earlier.", date: "c. 1150 CE (Europe)", years_bp: 800)),
        (id: "printing_press", name: "Printing press", era: 6, requires: ["lost_wax", "mechanical_clock"],
         history: (summary: "Movable metal type in a screw press printed books by the thousand.", date: "c. 1455 CE", years_bp: 495)),
        // ---- Era 7: Industrial ----
        (id: "steam_engine", name: "Steam engine", era: 7, requires: ["cast_iron", "lathe"],
         history: (summary: "Watt's separate condenser made steam engines efficient enough to power industry.", date: "1765", years_bp: 185)),
        (id: "railway", name: "Railway", era: 7, requires: ["steam_engine"],
         history: (summary: "Trevithick's locomotive hauled iron on rails at Penydarren.", date: "1804", years_bp: 146)),
        (id: "steamboat", name: "Steamboat", era: 7, requires: ["steam_engine", "advanced_sailing"],
         history: (summary: "Fulton's Clermont ran a regular steam service on the Hudson.", date: "1807", years_bp: 143)),
        (id: "photography", name: "Photography", era: 7, requires: ["glassblowing"],
         history: (summary: "Light-sensitive chemistry fixed the image of a camera obscura.", date: "1826–1839", years_bp: 115)),
        (id: "mechanical_reaper", name: "Mechanical reaper", era: 7, requires: ["cast_iron", "harvesting_sickle"],
         history: (summary: "A horse-drawn machine cut grain as fast as many workers with scythes.", date: "1831", years_bp: 119)),
        (id: "electric_battery", name: "Electric battery", era: 7, requires: ["cast_iron"],
         history: (summary: "Volta's pile of zinc, copper and brine produced a steady electric current.", date: "1800", years_bp: 150)),
        (id: "electric_generator", name: "Electric generator", era: 7, requires: ["electric_battery", "steam_engine"],
         history: (summary: "Faraday's discovery of induction led to dynamos that turned motion into electricity.", date: "1831", years_bp: 119)),
        (id: "telegraph", name: "Telegraph", era: 7, requires: ["electric_battery"],
         history: (summary: "Morse's electric telegraph sent messages over wires in moments.", date: "1844", years_bp: 106)),
        (id: "telephone", name: "Telephone", era: 7, requires: ["telegraph"],
         history: (summary: "Voices carried as electric signals over wires.", date: "1876", years_bp: 74)),
        (id: "internal_combustion_engine", name: "Internal combustion engine", era: 7, requires: ["steam_engine"],
         history: (summary: "Otto's four-stroke engine burned fuel inside the cylinder.", date: "1876", years_bp: 74)),
        (id: "electric_light", name: "Electric light", era: 7, requires: ["electric_generator", "glassblowing"],
         history: (summary: "Long-lasting incandescent bulbs made electric lighting practical.", date: "1879", years_bp: 71)),
        (id: "automobile", name: "Automobile", era: 7, requires: ["internal_combustion_engine"],
         history: (summary: "Benz's Motorwagen was the first practical car.", date: "1885", years_bp: 65)),
        // ---- Era 8: Modern ----
        (id: "radio", name: "Radio", era: 8, requires: ["telegraph", "electric_generator"],
         history: (summary: "Wireless telegraphy sent signals by electromagnetic waves.", date: "1895", years_bp: 55)),
        (id: "powered_flight", name: "Powered flight", era: 8, requires: ["internal_combustion_engine"],
         history: (summary: "The Wright brothers flew a powered, controlled aeroplane.", date: "1903", years_bp: 47)),
        (id: "rocketry", name: "Rocketry", era: 8, requires: ["gunpowder", "internal_combustion_engine"],
         history: (summary: "Goddard launched the first liquid-fuelled rocket.", date: "1926", years_bp: 24)),
        (id: "television", name: "Television", era: 8, requires: ["radio"],
         history: (summary: "Moving images transmitted electronically.", date: "1927", years_bp: 23)),
        (id: "electronic_computer", name: "Electronic computer", era: 8, requires: ["radio"],
         history: (summary: "ENIAC computed with thousands of vacuum tubes.", date: "1945", years_bp: 5)),
        (id: "transistor", name: "Transistor", era: 8, requires: ["radio"],
         history: (summary: "A solid-state switch replaced the fragile vacuum tube.", date: "1947", years_bp: 3)),
        (id: "nuclear_power", name: "Nuclear power", era: 8, requires: ["electric_generator", "electronic_computer"],
         history: (summary: "The first nuclear power station fed electricity into a grid.", date: "1954", years_bp: -4)),
        (id: "spaceflight", name: "Spaceflight", era: 8, requires: ["rocketry", "electronic_computer"],
         history: (summary: "Sputnik orbited the Earth; four years later a person did.", date: "1957", years_bp: -7)),
        (id: "personal_computer", name: "Personal computer", era: 8, requires: ["transistor", "electronic_computer"],
         history: (summary: "Microprocessors put computers on desks and in homes.", date: "1975–1977", years_bp: -26)),
        (id: "internet", name: "Internet", era: 8, requires: ["personal_computer", "telephone"],
         history: (summary: "Networks of networks joined by common protocols spanned the world.", date: "1983", years_bp: -33)),
        (id: "smartphone", name: "Smartphone", era: 8, requires: ["internet", "transistor"],
         history: (summary: "A pocket computer with a touch screen, radio and camera.", date: "2007", years_bp: -57)),
        (id: "gene_editing", name: "Gene editing", era: 8, requires: ["electronic_computer"],
         history: (summary: "CRISPR-Cas9 made editing DNA precise and cheap.", date: "2012", years_bp: -62)),
        (id: "artificial_intelligence", name: "Artificial intelligence", era: 8, requires: ["electronic_computer", "internet"],
         history: (summary: "Learning systems trained on vast data began to see, speak and reason.", date: "2012 onward", years_bp: -62)),
    ],
)
