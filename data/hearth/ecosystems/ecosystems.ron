// Ecosystems: which biomes they occupy, their producers and typical animals, succession and
// fire regime. Food webs come from the animals' diets.
(
    schema: 1,
    entries: [
        (
            id: "temperate_broadleaf_forest", name: "Temperate broadleaf forest", status: Implemented,
            biomes: ["broadleaf_forest", "mixed_forest", "birch_forest", "temperate_plains"],
            producers: ["english_oak", "silver_birch", "common_hazel", "stinging_nettle", "bramble", "meadow_grass"],
            consumers: [
                "red_deer", "white_tailed_deer", "roe_deer", "aurochs", "wild_boar", "gray_wolf", "red_fox", "brown_bear",
                "american_black_bear", "eurasian_lynx", "bobcat", "european_badger", "brown_hare", "eastern_cottontail",
                "red_squirrel", "eastern_gray_squirrel", "european_hedgehog", "bank_vole", "deer_mouse", "capercaillie",
                "wild_turkey", "tawny_owl", "barred_owl", "great_spotted_woodpecker", "hairy_woodpecker", "common_raven",
                "carrion_crow", "american_crow", "european_robin", "common_blackbird", "common_chaffinch", "american_robin",
                "northern_cardinal", "black_capped_chickadee", "common_european_adder", "timber_rattlesnake",
                "western_honey_bee", "common_frog", "wood_frog",
            ],
            succession: [
                (name: "Open ground: herbs and grasses", plants: ["meadow_grass", "stinging_nettle"], years: (0, 5)),
                (name: "Scrub", plants: ["bramble", "common_hazel"], years: (3, 20)),
                (name: "Pioneer woodland", plants: ["silver_birch"], years: (10, 60)),
                (name: "Oak forest", plants: ["english_oak", "common_hazel"], years: (50, 1000)),
            ],
            fire_return_years: (100, 500),
        ),
        (
            id: "boreal_forest_ecosystem", name: "Boreal forest", status: Implemented,
            biomes: ["boreal_forest", "snowy_taiga"],
            producers: [
                "norway_spruce", "scots_pine", "siberian_spruce", "siberian_fir", "siberian_larch", "black_spruce",
                "white_spruce", "balsam_fir", "jack_pine", "tamarack", "silver_birch", "downy_birch", "paper_birch",
                "quaking_aspen", "aspen", "osier", "dwarf_birch", "bilberry", "lingonberry", "lowbush_blueberry",
                "crowberry", "cloudberry", "bunchberry", "labrador_tea", "marsh_labrador_tea", "fireweed",
                "meadow_grass", "water_sedge", "feather_moss", "sphagnum_moss", "reindeer_lichen", "chanterelle",
                "fly_agaric",
            ],
            consumers: [
                "moose", "reindeer", "red_deer", "white_tailed_deer", "gray_wolf", "red_fox", "brown_bear",
                "american_black_bear", "wolverine", "eurasian_lynx", "canada_lynx", "bobcat", "sable", "american_marten",
                "ermine", "snowshoe_hare", "mountain_hare", "red_squirrel", "american_red_squirrel", "bank_vole",
                "deer_mouse", "capercaillie", "willow_ptarmigan", "spruce_grouse", "great_grey_owl", "barred_owl",
                "great_spotted_woodpecker", "hairy_woodpecker", "common_raven", "canada_jay", "siberian_jay",
                "common_chaffinch", "american_robin", "black_capped_chickadee", "common_european_adder", "wood_frog",
            ],
            succession: [
                (name: "Burn: fireweed, grasses and herbs", plants: ["fireweed", "meadow_grass"], years: (0, 5)),
                (name: "Birch and aspen", plants: ["downy_birch", "silver_birch", "paper_birch", "quaking_aspen", "aspen"], years: (5, 60)),
                (name: "Spruce and fir", plants: ["norway_spruce", "siberian_spruce", "white_spruce", "black_spruce", "siberian_fir", "balsam_fir"], years: (50, 400)),
            ],
            fire_return_years: (50, 200),
            reference: (temp_c: -1, warm_c: 16, precip_mm: 550, canopy: 0.55, young: 0.1, mast_kg: 720),
            notes: "Spruce and fir on the moister ground, pine and larch on sand and over permafrost; crown fires every century or so start the birch and aspen again. The forest floor is feather moss, berries and, in the open pine and larch woods, reindeer lichen.",
        ),
        (
            id: "tundra_ecosystem", name: "Tundra", status: Implemented,
            biomes: ["tundra"],
            producers: [
                "dwarf_birch", "arctic_willow", "cottongrass", "water_sedge", "mountain_avens", "bearberry", "crowberry",
                "cloudberry", "purple_saxifrage", "arctic_poppy", "reindeer_lichen", "sphagnum_moss", "feather_moss",
                "meadow_grass",
            ],
            consumers: [
                "reindeer", "musk_ox", "moose", "gray_wolf", "arctic_fox", "red_fox", "brown_bear", "wolverine", "ermine",
                "arctic_hare", "mountain_hare", "norway_lemming", "brown_lemming", "willow_ptarmigan", "rock_ptarmigan",
                "snowy_owl", "snow_bunting",
            ],
            fire_return_years: (300, 3000),
            reference: (temp_c: -6, warm_c: 9, precip_mm: 350),
            notes: "Treeless over permafrost: dwarf shrubs a hand high, tussocks of cottongrass and sedge meadows on the wet ground, lichens and mosses; in the polar desert of the far north, cushions and rosettes on bare gravel. Production is a fifth of a temperate wood's and comes in a summer of two or three months; the lemmings' cycle drives the foxes', owls' and ermine's.",
        ),
        (
            id: "temperate_grassland", name: "Steppe and prairie", status: Implemented,
            biomes: ["steppe", "temperate_plains"],
            producers: [
                "feather_grass", "steppe_fescue", "big_bluestem", "blue_grama", "meadow_grass", "fringed_sage",
                "pasque_flower", "purple_coneflower", "common_sunflower", "soapweed_yucca", "perennial_flax", "yarrow",
                "dandelion", "big_sagebrush",
            ],
            consumers: [
                "american_bison", "wisent", "wild_horse", "saiga", "pronghorn", "black_tailed_prairie_dog", "bobak_marmot",
                "european_souslik", "coyote", "corsac_fox", "swift_fox", "american_badger", "steppe_polecat",
                "black_footed_ferret", "gray_wolf", "red_fox", "great_bustard", "greater_sage_grouse", "burrowing_owl",
                "golden_eagle", "western_meadowlark", "eurasian_skylark", "prairie_rattlesnake", "black_tailed_jackrabbit",
                "brown_hare", "eastern_cottontail", "deer_mouse", "ermine", "brown_bear", "common_vole", "meadow_vole",
            ],
            succession: [
                (name: "Burn or wallow: annual weeds and sunflowers", plants: ["common_sunflower", "dandelion"], years: (0, 3)),
                (name: "Bunch grasses and forbs", plants: ["feather_grass", "steppe_fescue", "big_bluestem", "blue_grama"], years: (2, 1000)),
            ],
            fire_return_years: (2, 10),
            reference: (temp_c: 8, warm_c: 24, precip_mm: 500),
            notes: "Too dry for trees, or kept from them by fire and grazing: grasses whose growing points lie at the ground, so that fire and teeth do not kill them. The tallgrass where it is wettest, the shortgrass and the feather-grass steppe where it is dry; most of the year's growth is underground, in the roots.",
        ),
        (
            id: "cold_desert", name: "Cold desert", status: Implemented,
            biomes: ["cold_desert"],
            producers: ["big_sagebrush", "black_saxaul", "fourwing_saltbush", "joint_pine", "camelthorn", "steppe_fescue", "blue_grama", "fringed_sage", "tamarisk"],
            consumers: [
                "wild_bactrian_camel", "kulan", "saiga", "wild_horse", "pronghorn", "greater_sage_grouse", "coyote",
                "corsac_fox", "kit_fox", "american_badger", "merriams_kangaroo_rat", "lesser_egyptian_jerboa",
                "black_tailed_jackrabbit", "deer_mouse", "burrowing_owl", "golden_eagle", "prairie_rattlesnake",
            ],
            fire_return_years: (30, 100),
            reference: (temp_c: 8, warm_c: 26, precip_mm: 180),
            notes: "Deserts of the continents' hearts and the mountains' rain shadows, hot in summer and bitter in winter: sagebrush and saltbush in the Great Basin, saxaul, wormwood and camelthorn in the Gobi and the Kyzylkum.",
        ),
        (
            id: "hot_desert", name: "Hot desert", status: Implemented,
            biomes: ["hot_desert", "dune_sea", "mesa", "salt_flat", "oasis"],
            producers: ["creosote_bush", "prickly_pear", "honey_mesquite", "fourwing_saltbush", "joint_pine", "camelthorn", "tamarisk", "blue_grama"],
            consumers: [
                "dromedary", "addax", "dorcas_gazelle", "kulan", "fennec_fox", "kit_fox", "sand_cat", "coyote",
                "black_tailed_jackrabbit", "merriams_kangaroo_rat", "deer_mouse", "lesser_egyptian_jerboa", "greater_roadrunner",
                "burrowing_owl", "golden_eagle", "western_diamondback", "horned_viper", "gila_monster", "desert_tortoise",
            ],
            fire_return_years: (100, 1000),
            reference: (temp_c: 22, warm_c: 34, precip_mm: 150),
            notes: "Under 250 mm of rain a year and often far less: shrubs spaced across bare ground, cacti and succulents in the New World, ephemeral flowers after rain; the animals night-active, burrowing, and many never drinking.",
        ),
        (
            id: "temperate_freshwater", name: "Temperate rivers, lakes and wetlands", status: Implemented,
            biomes: ["river", "lake", "wetland"],
            producers: ["osier", "white_willow", "black_alder", "meadow_grass"],
            consumers: [
                "brown_trout", "brook_trout", "european_perch", "yellow_perch", "common_frog", "wood_frog",
                "red_deer", "aurochs", "wild_boar",
            ],
            notes: "Fish densities are per km² of water; the land animals come to drink.",
        ),
        (
            id: "savanna_woodland", name: "Savanna–woodland mosaic",
            biomes: ["savanna"],
            producers: ["umbrella_acacia", "baobab", "red_oat_grass"],
            fire_return_years: (1, 5),
            notes: "Fauna arrives with the savanna expansion wave (V2-10).",
        ),
    ],
)
