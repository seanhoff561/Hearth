// Eras (v2 §17.1, Amendment E §6.4). Wild Earth is the one playable era: a wild Earth without
// people. The others are listed as "Coming soon" with a line each; they return with the
// simulated humanity of Phase F (`docs/design/future/humanity/`).
(
    schema: 1,
    entries: [
        (id: "wild_earth", name: "Wild Earth", order: 0, available: true, status: Implemented,
         description: "A wild Earth without people. Survive, learn and build from nothing."),
        (id: "lower_paleolithic", name: "Lower Paleolithic", order: 1, available: false, status: Planned,
         description: "Homo erectus with hand axes and wooden spears, keeping fire."),
        (id: "middle_paleolithic", name: "Middle Paleolithic", order: 2, available: false, status: Planned,
         description: "Neanderthals in the cold of the last glacial, hafting spears and making fire."),
        (id: "upper_paleolithic", name: "Upper Paleolithic", order: 3, available: false, status: Planned,
         description: "Homo sapiens across the world in bands, with blades, needles and art."),
        (id: "neolithic_dawn", name: "Neolithic", order: 4, available: false, status: Planned,
         description: "The first farming villages and the domestication of plants and animals."),
        (id: "bronze_age", name: "Bronze Age", order: 5, available: false, status: Planned,
         description: "Towns, trade in copper and tin, the wheel and the sail."),
        (id: "classical", name: "Iron Age and Classical Antiquity", order: 6, available: false, status: Planned,
         description: "Iron, concrete, aqueducts and seafaring empires."),
        (id: "medieval", name: "Middle Ages", order: 7, available: false, status: Planned,
         description: "Windmills, the compass and the mechanical clock."),
        (id: "industrial", name: "Industrial Revolution", order: 8, available: false, status: Planned,
         description: "Steam, railways and the telegraph."),
        (id: "modern", name: "Modern World", order: 9, available: false, status: Planned,
         description: "Electricity, flight and computers."),
    ],
)
