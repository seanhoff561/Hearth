        (id: "medieval", name: "Middle Ages", order: 5, available: false, years_bp: 800,
         description: "Windmills, the compass and the mechanical clock.", status: Planned),
        (id: "industrial", name: "Industrial Revolution", order: 6, available: false, years_bp: 150,
